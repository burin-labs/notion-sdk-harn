import {
  build_generated_provenance,
  read_generated_provenance,
  verify_generated_provenance,
} from "./lib/generated_provenance"

fn main(harness: Harness) {
  for path in ["src/lib.harn", "src/main.harn"] {
    require harness.fs.exists(path), "generated output is missing: ${path}"
    const expected = build_generated_provenance(harness.fs, harness.fs.read_text(path))
    const actual = read_generated_provenance(harness.fs, "${path}.provenance.toml")
    verify_generated_provenance(actual, expected)
  }
  harness.stdio.println("generated SDK and entrypoint provenance is current")
}
