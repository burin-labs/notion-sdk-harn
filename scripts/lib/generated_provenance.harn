import { read_toml_typed } from "std/fs"

pub type GeneratedProvenance = {
  schema_version: 1,
  fixture_sha256: string,
  generator_commit: string,
  regen_sha256: string,
  output_sha256: string,
}

type GeneratorLockPackage = {name: string, commit?: string}

type GeneratorLock = {package: list<GeneratorLockPackage>}

fn _repo_root() -> string {
  return source_dir() + "/../.."
}

fn _generator_commit(harness: Harness) -> string {
  const lock = read_toml_typed<GeneratorLock>(_repo_root() + "/harn.lock", schema_of(GeneratorLock))
  for package in lock.package ?? [] {
    if package.name == "harn-openapi" {
      const commit = to_string(package.commit ?? "")
      if len(regex_captures("^[0-9a-f]{40}$", commit)) == 0 {
        throw "generated provenance: harn-openapi lock entry must pin a full commit"
      }
      return commit
    }
  }
  throw "generated provenance: harn-openapi is missing from harn.lock"
}

pub fn build_generated_provenance(harness: Harness, output_source: string) -> GeneratedProvenance {
  const root = _repo_root()
  return {
    schema_version: 1,
    fixture_sha256: sha256(harness.fs.read_text(root + "/tests/fixtures/notion.openapi.json")),
    generator_commit: _generator_commit(harness),
    regen_sha256: sha256(harness.fs.read_text(root + "/scripts/regen.harn")),
    output_sha256: sha256(output_source),
  }
}

fn _render(provenance: GeneratedProvenance) -> string {
  return "schema_version = 1\n"
    + "fixture_sha256 = \""
    + provenance.fixture_sha256
    + "\"\n"
    + "generator_commit = \""
    + provenance.generator_commit
    + "\"\n"
    + "regen_sha256 = \""
    + provenance.regen_sha256
    + "\"\n"
    + "output_sha256 = \""
    + provenance.output_sha256
    + "\"\n"
}

pub fn write_generated_provenance(harness: Harness, path: string, provenance: GeneratedProvenance) {
  harness.fs.write_text(path, _render(provenance))
}

pub fn read_generated_provenance(harness: Harness, path: string) -> GeneratedProvenance {
  if !harness.fs.exists(path) {
    throw "generated provenance: missing ${path}; run harn run scripts/regen.harn -- --apply"
  }
  return read_toml_typed<GeneratedProvenance>(path, schema_of(GeneratedProvenance))
}

pub fn verify_generated_provenance(actual: GeneratedProvenance, expected: GeneratedProvenance) {
  if actual != expected {
    throw "generated SDK provenance is stale; run harn run scripts/regen.harn -- --apply"
  }
}
