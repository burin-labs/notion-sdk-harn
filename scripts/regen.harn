// Regenerate the SDK from the pinned Notion OpenAPI fixture.
//
// Reads the pinned Notion OpenAPI fixture, runs it through the
// harn-openapi parser + codegen, and either writes the result to
// `src/lib.harn` (when invoked with `--apply`) or verifies the
// committed output has not drifted.
//
// Usage:
//
//   harn run scripts/regen.harn              # verify mode (read-only)
//   harn run scripts/regen.harn -- --apply   # write mode
//
// The harn-openapi dependency is resolved via `[dependencies]` in
// `harn.toml`. Run `harn install --locked` once before first use.
import { codegen_module, operations, parse } from "harn-openapi/default"

let FIXTURE_PATH = "tests/fixtures/notion.openapi.json"

let OUTPUT_PATH = "src/lib.harn"

let CODEGEN_OPTIONS = {
  module_name: "notion",
  client_name: "NotionClient",
  transport: "connector_policy",
  default_base_url: "https://api.notion.com",
  header_overrides: {"Notion-Version": "2022-06-28"},
}

fn _harn_bin(harness: Harness) -> string {
  let bin = harness.env.get("HARN_BIN")
  if bin != nil && bin != "" {
    return bin
  }
  return "harn"
}

fn _format_generated(harness: Harness, source: string) -> string {
  let dir = ".harn-runs/regen"
  harness.fs.mkdir(dir)
  let path = dir + "/notion-sdk-harn-generated.harn"
  harness.fs.write_text(path, source)
  /*
   * The parent script stays under the default worktree sandbox. Linux Landlock
   * rejects this nested Harn formatter when the parent also tries to wrap it,
   * so promote only the checksum-pinned formatter subprocess.
   */
  let result = host_call(
    "process.exec",
    {mode: "argv", argv: [_harn_bin(harness), "fmt", path], cwd: ".", sandbox_profile: "unrestricted"},
  )
  if !result.success {
    if result.stderr != "" {
      harness.stdio.println(result.stderr.trim())
    }
    throw "failed to format generated output"
  }
  let formatted = harness.fs.read_text(path)
  harness.fs.delete(path)
  return formatted
}

pipeline default() {
  let apply_mode = argv.contains("--apply")
  let raw = harness.fs.read_text(FIXTURE_PATH)
  let doc = parse(raw)
  let ops = operations(doc)
  harness.stdio.println("parsed ${doc.info.title} (OpenAPI ${doc.openapi})")
  harness.stdio.println("  operations: ${len(ops)}")
  harness.stdio.println("  schemas:    ${len(doc.components.schemas)}")
  let generated = _format_generated(harness, codegen_module(doc, CODEGEN_OPTIONS))
  let generated_lines = len(split(generated, "\n"))
  harness.stdio.println("  generated:  ${len(generated)} bytes, ${generated_lines} lines")
  let current = if harness.fs.exists(OUTPUT_PATH) {
    harness.fs.read_text(OUTPUT_PATH)
  } else {
    ""
  }
  if apply_mode {
    harness.fs.write_text(OUTPUT_PATH, generated)
    harness.stdio.println("wrote ${OUTPUT_PATH} (${len(generated)} bytes)")
    if current == "" {
      harness.stdio.println("  (was empty)")
    } else if current == generated {
      harness.stdio.println("  (no change)")
    } else {
      harness.stdio.println("  (replaced ${len(current)} bytes -> ${len(generated)} bytes)")
    }
  } else if current == generated {
    harness.stdio.println("${OUTPUT_PATH} is up to date.")
  } else if current == "" {
    harness.stdio.println("${OUTPUT_PATH} does not exist yet.")
    harness.stdio.println("Run `harn run scripts/regen.harn -- --apply` to write it.")
    throw "generated SDK output is missing"
  } else {
    let current_lines = len(split(current, "\n"))
    harness.stdio.println("${OUTPUT_PATH} differs from generator output:")
    harness.stdio.println("  current:    ${len(current)} bytes, ${current_lines} lines")
    harness.stdio.println("  generated:  ${len(generated)} bytes, ${generated_lines} lines")
    harness.stdio.println("Run `harn run scripts/regen.harn -- --apply` to update it.")
    throw "generated SDK output is stale"
  }
}
