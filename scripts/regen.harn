import {
  build_generated_provenance,
  read_generated_provenance,
  verify_generated_provenance,
  write_generated_provenance,
} from "./lib/generated_provenance"
import { codegen_entrypoint, codegen_module, operations, parse } from "harn-openapi/default"

type GeneratedFile = {path: string, source: string}

const OPTIONS = {
  module_name: "notion",
  client_name: "NotionClient",
  environment_prefix: "NOTION",
  transport: "connector_policy",
  default_base_url: "https://api.notion.com",
  header_overrides: {"Notion-Version": "2022-06-28"},
}

fn canonical_source(harness: Harness, source: string) -> string {
  const root = harness.fs.mkdtemp_in_workspace("notion-generated-source-")
  const path = "${root}/generated.harn"
  harness.fs.write_text(path, source)
  for args in [["lint", "--fix", path], ["fmt", path], ["lint", "--strict", path]] {
    const result = harness.process.run(
      {
        program: harness.env.get("HARN_BIN") ?? "harn",
        args: args,
        sandbox_profile: "workspace_paths",
      },
    )
    require result.success,
      "generated source normalization failed: ${result.stderr}\n${result.stdout}"
  }
  const normalized = harness.fs.read_text(path)
  harness.fs.delete(path)
  return normalized
}

fn main(harness: Harness) {
  const doc = parse(harness.fs.read_text("tests/fixtures/notion.openapi.json"))
  const files: list<GeneratedFile> = [
    {path: "src/lib.harn", source: codegen_module(harness.fs, doc, OPTIONS)},
    {
      path: "src/main.harn",
      source: codegen_entrypoint(
        harness.fs,
        doc,
        {module_import: "./lib", environment_prefix: OPTIONS.environment_prefix},
      ),
    },
  ]
  harness.stdio.println("generated ${len(operations(doc))} Notion operations")
  for file in files {
    const receipt = "${file.path}.provenance.toml"
    const source = canonical_source(harness, file.source)
    const expected = build_generated_provenance(harness.fs, source)
    if argv.contains("--apply") {
      harness.fs.write_text(file.path, source)
      write_generated_provenance(harness.fs, receipt, expected)
      harness.stdio.println("wrote ${file.path}")
    } else {
      require harness.fs.read_text(file.path) == source,
        "generated output is stale: ${file.path}; run harn run scripts/regen.harn -- --apply"
      verify_generated_provenance(read_generated_provenance(harness.fs, receipt), expected)
      harness.stdio.println("${file.path} is current")
    }
  }
}
