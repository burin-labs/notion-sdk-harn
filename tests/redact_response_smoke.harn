import { decode_thrown } from "../src/helpers"
import { new_client, retrieve_a_page } from "../src/lib"

type ErrorEnvelope = {
  status: int,
  headers: dict<string, string>,
  body: string,
  body_bytes?: bytes,
  operation: string,
}

const BASE = "https://api.notion.test"

const PAGE = "11111111-1111-1111-1111-111111111111"

fn failed_page(harness: Harness, body: string) -> ErrorEnvelope {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "${BASE}/v1/pages/${PAGE}",
    {
      status: 401,
      headers: {
        Authorization: "Bearer fixture-response-secret",
        "Proxy-Authorization": "fixture-proxy-secret",
        Cookie: "fixture-cookie-secret",
        "Set-Cookie": "fixture-set-cookie-secret",
        "X-API-Key": "fixture-api-key-secret",
        "X-Auth-Token": "fixture-auth-token-secret",
        "NoTiOn-ToKeN": "fixture-notion-token-secret",
        "x-request-id": "req-safety",
      },
      body: body,
    },
  )
  const result = try {
    retrieve_a_page(
      pick(harness, ["clock", "net"]),
      new_client(BASE, {bearerAuth: {token: "fixture-request-secret"}}),
      PAGE,
    )
  }
  assert(is_err(result), "the generated SDK must reach its error path")
  assert_eq(len(harness.testing.http_mock_calls()), 1)
  return schema_expect(unwrap_err(result), schema_of(ErrorEnvelope))
}

pipeline test_sdk_errors_use_the_shared_header_and_body_boundary(harness: Harness) {
  const raw = failed_page(harness, "x".repeat(4096))
  const encoded = json_stringify(raw)
  for secret in [
    "fixture-response-secret",
    "fixture-cookie-secret",
    "fixture-set-cookie-secret",
    "fixture-api-key-secret",
    "fixture-proxy-secret",
    "fixture-auth-token-secret",
    "fixture-notion-token-secret",
    "fixture-request-secret",
  ] {
    assert(!encoded.contains(secret), "error leaked ${secret}")
  }
  assert_eq(raw.headers["x-request-id"], "req-safety")
  assert(raw.body.contains("[truncated"))
  assert(len(raw.body) <= 1100)
  if raw.body_bytes != nil {
    assert(bytes_len(raw.body_bytes) <= 1100, "raw bytes bypassed the error body bound")
  }
}

pipeline test_notion_error_decoding_preserves_the_shared_envelope(harness: Harness) {
  const body = json_stringify({code: "unauthorized", message: "Integration token refused"})
  const raw = failed_page(harness, body)
  assert_eq(raw.body, body)
  const decoded = decode_thrown(raw)
  assert_eq(decoded.status, 401)
  assert_eq(decoded.code, "unauthorized")
  assert_eq(decoded.message, "Integration token refused")
  assert_eq(decoded.request_id, "req-safety")
  assert_eq(decoded.operation, "retrieve_a_page")
}
