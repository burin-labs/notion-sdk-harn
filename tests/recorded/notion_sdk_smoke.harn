// Recorded HTTP smoke tests for the generated Notion SDK.
//
// Each scenario installs deterministic responses through `http_mock`,
// invokes the SDK, and asserts the parsed payload, request shape, and
// (for failure cases) the structured `NotionError` returned via
// `decode_thrown`. No live HTTP traffic.
import { collect_all, decode_thrown, paginate } from "../../src/helpers"
import {
  create_a_comment,
  create_a_comment_variant1,
  get_users,
  introspect_token,
  list_data_source_templates,
  new_client,
  pagination_items,
  pagination_next,
  pagination_plan,
  post_database_query,
  retrieve_a_page,
} from "../../src/lib"
import { expect, expect_contains, expect_eq } from "../assertions"

const BASE_URL = "https://api.notion.test"

const TOKEN = "secret_test_token"

const NOTION_VERSION = "2022-06-28"

const FIXTURE_DIR = source_dir() + "/../fixtures/recorded"

const PAGE_OK_PATH = FIXTURE_DIR + "/page_retrieve_ok.json"

const PAGE_404_PATH = FIXTURE_DIR + "/page_retrieve_404.json"

const DS_QUERY_PAGE_1_PATH = FIXTURE_DIR + "/data_source_query_page_1.json"

const DS_QUERY_PAGE_2_PATH = FIXTURE_DIR + "/data_source_query_page_2.json"

const DS_QUERY_429_PATH = FIXTURE_DIR + "/data_source_query_429.json"

const DS_TEMPLATES_PAGE_1_PATH = FIXTURE_DIR + "/data_source_templates_page_1.json"

const DS_TEMPLATES_PAGE_2_PATH = FIXTURE_DIR + "/data_source_templates_page_2.json"

const COMMENT_OK_PATH = FIXTURE_DIR + "/comment_create_ok.json"

const USERS_PAGE_1_PATH = FIXTURE_DIR + "/users_list_page_1.json"

const USERS_PAGE_2_PATH = FIXTURE_DIR + "/users_list_page_2.json"

const OAUTH_INTROSPECT_OK_PATH = FIXTURE_DIR + "/oauth_introspect_ok.json"

fn fixture_client() {
  return new_client(BASE_URL, TOKEN, nil, "", "", nil, {"Notion-Version": NOTION_VERSION})
}

fn fixture_body(harness: Harness, path: string) -> string {
  return harness.fs.read_text(path)
}

@test
pipeline default() {
  egress_policy({allow: ["api.notion.test"], default: "deny"})
  // ---------------------------------------------------------------
  // retrieve_a_page: happy path
  // ---------------------------------------------------------------
  http_mock_clear()
  const page_id = "11111111-1111-1111-1111-111111111111"
  http_mock(
    "GET",
    BASE_URL + "/v1/pages/" + page_id,
    {
      status: 200,
      body: fixture_body(harness, PAGE_OK_PATH),
      headers: {"x-request-id": "req-page-ok"},
    },
  )
  const client = fixture_client()
  const page = retrieve_a_page(client, page_id)
  expect_eq(page.object, "page", "page object kind")
  expect_eq(page.id, page_id, "page id round trip")
  expect_eq(page.properties.Status.select.name, "Done", "deeply nested property decoded")
  const calls = http_mock_calls({include_sensitive: true})
  expect_eq(len(calls), 1, "one page retrieve call")
  expect_eq(calls[0].method, "GET", "GET method")
  expect_eq(calls[0].headers.authorization, "Bearer " + TOKEN, "bearer token applied")
  expect_eq(calls[0].headers.get("notion-version"), NOTION_VERSION, "notion-version header pinned")
  // ---------------------------------------------------------------
  // users.list: safe GET calls use shared connector retry policy
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/users*",
    {
      responses: [
        {status: 503, body: "{\"code\":\"service_unavailable\",\"message\":\"busy\"}", headers: {}},
        {
          status: 200,
          body: fixture_body(harness, USERS_PAGE_1_PATH),
          headers: {"x-request-id": "req-users-retry"},
        },
      ],
    },
  )
  const retried_users = get_users(client, nil, 2)
  expect_eq(len(retried_users.results), 2, "safe GET retry returns list payload")
  const retried_user_calls = http_mock_calls()
  expect_eq(len(retried_user_calls), 2, "safe GET retried once before success")
  // ---------------------------------------------------------------
  // client plumbing: provider tokens, base URL joins, version override
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/pages/" + page_id,
    {
      status: 200,
      body: fixture_body(harness, PAGE_OK_PATH),
      headers: {"x-request-id": "req-page-provider"},
    },
  )
  const provider_client = new_client(
    BASE_URL + "/",
    "",
    fn() { return "provider_test_token" },
    "",
    "",
    nil,
    {"Notion-Version": NOTION_VERSION},
  )
  const provider_page = retrieve_a_page(provider_client, page_id, nil, "2026-03-11")
  expect_eq(provider_page.id, page_id, "provider-token client retrieves page")
  const provider_calls = http_mock_calls({include_sensitive: true})
  expect_eq(len(provider_calls), 1, "provider-token client made one request")
  expect_eq(
    provider_calls[0].url,
    BASE_URL + "/v1/pages/" + page_id,
    "trailing slash base URL normalized",
  )
  expect_eq(
    provider_calls[0].headers.authorization,
    "Bearer provider_test_token",
    "token provider applied",
  )
  expect_eq(
    provider_calls[0].headers.get("notion-version"),
    "2026-03-11",
    "operation version override applied",
  )
  // ---------------------------------------------------------------
  // retrieve_a_page: 404 becomes a structured NotionError via decode_thrown
  // ---------------------------------------------------------------
  http_mock_clear()
  const missing_id = "99999999-9999-9999-9999-999999999999"
  http_mock(
    "GET",
    BASE_URL + "/v1/pages/" + missing_id,
    {status: 404, body: fixture_body(harness, PAGE_404_PATH), headers: {"x-request-id": "req-404"}},
  )
  const missing = try {
    retrieve_a_page(client, missing_id)
  }
  expect(is_err(missing), "404 returns Err")
  const err_404 = decode_thrown(unwrap_err(missing))
  expect_eq(err_404.status, 404, "decoded status")
  expect_eq(err_404.code, "object_not_found", "decoded Notion code")
  expect_contains(err_404.message, "Could not find page", "decoded Notion message")
  expect_eq(err_404.request_id, "req-404", "decoded request id from response headers")
  expect_eq(err_404.operation, "retrieve_a_page", "decoded operation name")
  // ---------------------------------------------------------------
  // retrieve_a_page: invalid JSON uses the shared parse-error envelope
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/pages/" + page_id,
    {status: 200, body: "not json", headers: {"x-request-id": "req-invalid-json"}},
  )
  const invalid_json = try {
    retrieve_a_page(client, page_id)
  }
  expect(is_err(invalid_json), "invalid JSON returns Err")
  const invalid_json_raw = unwrap_err(invalid_json)
  expect_eq(invalid_json_raw.category, "invalid_json", "raw invalid JSON category")
  expect_eq(invalid_json_raw.status, 200, "raw invalid JSON status")
  expect_eq(invalid_json_raw.operation, "retrieve_a_page", "raw invalid JSON operation")
  const err_invalid_json = decode_thrown(invalid_json_raw)
  expect_eq(err_invalid_json.code, "invalid_json", "decoded invalid JSON category")
  expect_eq(err_invalid_json.status, 200, "decoded invalid JSON status")
  // ---------------------------------------------------------------
  // data_sources.query: paginated walk via paginate(...)
  // ---------------------------------------------------------------
  http_mock_clear()
  const ds_id = "33333333-3333-3333-3333-333333333333"
  http_mock(
    "POST",
    BASE_URL + "/v1/data_sources/" + ds_id + "/query",
    {
      responses: [
        {
          status: 200,
          body: fixture_body(harness, DS_QUERY_PAGE_1_PATH),
          headers: {"x-request-id": "req-ds-1"},
        },
        {
          status: 200,
          body: fixture_body(harness, DS_QUERY_PAGE_2_PATH),
          headers: {"x-request-id": "req-ds-2"},
        },
      ],
    },
  )
  const rows = collect_all(
    fn(args) { return post_database_query(
      client,
      ds_id,
      {filter: {property: "Status", select: {equals: "Done"}}, ...args},
    ) },
  )
  expect_eq(len(rows), 3, "paginate concatenates results across pages")
  expect_eq(rows[0].id, "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1", "first row id")
  expect_eq(rows[2].id, "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa3", "last row id")
  const query_calls = http_mock_calls()
  expect_eq(len(query_calls), 2, "two POSTs for two-page result")
  const first_body = json_parse(query_calls[0].body)
  expect_eq(first_body.filter.property, "Status", "filter forwarded on page 1")
  expect_eq(first_body.get("start_cursor"), nil, "no cursor on first page")
  const second_body = json_parse(query_calls[1].body)
  expect_eq(second_body.start_cursor, "page-2-cursor", "second page picks up cursor")
  expect_eq(second_body.filter.property, "Status", "filter preserved across pages")
  // ---------------------------------------------------------------
  // data_sources.query: 429 becomes a structured rate_limited error
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "POST",
    BASE_URL + "/v1/data_sources/" + ds_id + "/query",
    {
      status: 429,
      body: fixture_body(harness, DS_QUERY_429_PATH),
      headers: {"x-request-id": "req-429", "retry-after": "5"},
    },
  )
  const throttled = try {
    post_database_query(client, ds_id, {})
  }
  expect(is_err(throttled), "429 returns Err")
  const throttled_raw = unwrap_err(throttled)
  expect_eq(throttled_raw.retry_after_ms, 5000, "Retry-After surfaced as milliseconds")
  expect_eq(
    throttled_raw.rate_limit.retry_after_ms,
    5000,
    "Retry-After surfaced in rate-limit metadata",
  )
  expect_eq(throttled_raw.rate_limit.retry_after, "5", "raw Retry-After header surfaced")
  const err_429 = decode_thrown(throttled_raw)
  expect_eq(err_429.status, 429, "decoded 429 status")
  expect_eq(err_429.code, "rate_limited", "decoded Notion rate_limited code")
  expect_eq(err_429.operation, "post_database_query", "decoded operation name")
  const envelope_only = decode_thrown(
    {
      ok: false,
      status: 400,
      category: "validation_error",
      body:
        "{\"code\":\"invalid_json\",\"message\":\"Malformed body\",\"request_id\":\"req-body\"}",
      operation: "synthetic_connector_envelope",
    },
  )
  expect_eq(envelope_only.code, "invalid_json", "body error code wins over connector category")
  expect_eq(envelope_only.message, "Malformed body", "body error message decoded from envelope")
  expect_eq(envelope_only.request_id, "req-body", "body request id used when headers are absent")
  // ---------------------------------------------------------------
  // comments.create: unsafe write calls do not retry without idempotency
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "POST",
    BASE_URL + "/v1/comments",
    {
      responses: [
        {status: 503, body: "{\"code\":\"service_unavailable\",\"message\":\"busy\"}", headers: {}},
        {
          status: 200,
          body: fixture_body(harness, COMMENT_OK_PATH),
          headers: {"x-request-id": "req-comment-retry"},
        },
      ],
    },
  )
  const no_retry_body = create_a_comment_variant1(
    {type: "page_id", page_id: page_id},
    [{type: "text", text: {content: "No retry without idempotency"}}],
  )
  const no_retry = try {
    create_a_comment(client, no_retry_body)
  }
  expect(is_err(no_retry), "write without idempotency key returns the first failure")
  const no_retry_raw = unwrap_err(no_retry)
  expect_eq(no_retry_raw.status, 503, "write without idempotency keeps first status")
  expect_eq(
    no_retry_raw.category,
    "overloaded",
    "write without idempotency keeps connector category",
  )
  const no_retry_calls = http_mock_calls()
  expect_eq(len(no_retry_calls), 1, "write without idempotency is not retried")
  // ---------------------------------------------------------------
  // comments.create: variant1 (parent + rich_text)
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "POST",
    BASE_URL + "/v1/comments",
    {
      status: 200,
      body: fixture_body(harness, COMMENT_OK_PATH),
      headers: {"x-request-id": "req-comment"},
    },
  )
  const body = create_a_comment_variant1(
    {type: "page_id", page_id: page_id},
    [{type: "text", text: {content: "Hello from notion-sdk-harn"}}],
  )
  const comment = create_a_comment(client, body)
  expect_eq(comment.object, "comment", "comment object kind")
  expect_eq(comment.id, "cccccccc-cccc-cccc-cccc-cccccccccccc", "comment id round trip")
  const comment_calls = http_mock_calls()
  expect_eq(len(comment_calls), 1, "one comments.create call")
  const comment_body = json_parse(comment_calls[0].body)
  expect_eq(comment_body.parent.page_id, page_id, "comment parent forwarded")
  expect_eq(len(comment_body.rich_text), 1, "rich_text array forwarded")
  expect_eq(comment_body.get("_variant"), nil, "internal _variant marker stripped before send")
  // ---------------------------------------------------------------
  // oauth.introspect: Basic auth provider, not Bearer auth
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "POST",
    BASE_URL + "/v1/oauth/introspect",
    {
      status: 200,
      body: fixture_body(harness, OAUTH_INTROSPECT_OK_PATH),
      headers: {"x-request-id": "req-oauth-introspect"},
    },
  )
  const oauth_client = new_client(
    BASE_URL,
    "ignored-bearer-token",
    nil,
    "",
    "",
    fn() { return {user: "client-id", password: "client-secret"} },
    {"Notion-Version": NOTION_VERSION},
  )
  const token_state = introspect_token(oauth_client, {token: "access-token"}, "2026-03-11")
  expect_eq(token_state.active, true, "introspection response decoded")
  const oauth_calls = http_mock_calls({include_sensitive: true})
  expect_eq(len(oauth_calls), 1, "one oauth introspection call")
  expect_eq(
    oauth_calls[0].headers.authorization,
    "Basic Y2xpZW50LWlkOmNsaWVudC1zZWNyZXQ=",
    "basic provider applied",
  )
  expect_eq(
    oauth_calls[0].headers.get("notion-version"),
    "2026-03-11",
    "oauth version override applied",
  )
  const oauth_body = json_parse(oauth_calls[0].body)
  expect_eq(oauth_body.token, "access-token", "oauth body forwarded")
  // ---------------------------------------------------------------
  // users.list: paginate via paginate(...) with explicit page_size
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/users*",
    {
      responses: [
        {
          status: 200,
          body: fixture_body(harness, USERS_PAGE_1_PATH),
          headers: {"x-request-id": "req-users-1"},
        },
        {
          status: 200,
          body: fixture_body(harness, USERS_PAGE_2_PATH),
          headers: {"x-request-id": "req-users-2"},
        },
      ],
    },
  )
  const users = collect_all(fn(args) { return get_users(client, args.get("start_cursor"), 50) })
  expect_eq(len(users), 3, "users.list paginates across two pages")
  expect_eq(users[0].name, "Ada Lovelace", "first user")
  expect_eq(users[2].type, "bot", "bot user on second page")
  const user_calls = http_mock_calls()
  expect_eq(len(user_calls), 2, "two GETs for two-page result")
  expect_contains(user_calls[0].url, "page_size=50", "page_size forwarded as query param")
  expect(user_calls[0].url.index_of("start_cursor=") < 0, "no start_cursor on first page")
  expect_contains(user_calls[1].url, "start_cursor=users-page-2", "second page picks up cursor")
  // ---------------------------------------------------------------
  // paginate (lazy): early stream termination after one item
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/users*",
    {status: 200, body: fixture_body(harness, USERS_PAGE_1_PATH), headers: {}},
  )
  let first_only = nil
  for u in paginate(fn(args) { return get_users(client, args.get("start_cursor"), nil) }) {
    first_only = u
    break
  }
  expect(first_only != nil, "stream yields at least one item")
  expect_eq(first_only.id, "22222222-2222-2222-2222-222222222222", "first streamed user")
  const lazy_calls = http_mock_calls()
  expect_eq(len(lazy_calls), 1, "lazy paginate stops after first page when consumer breaks")
  // ---------------------------------------------------------------
  // data_sources.templates — non-`results` list pagination
  // ---------------------------------------------------------------
  http_mock_clear()
  http_mock(
    "GET",
    BASE_URL + "/v1/data_sources/" + ds_id + "/templates*",
    {
      responses: [
        {status: 200, body: fixture_body(harness, DS_TEMPLATES_PAGE_1_PATH), headers: {}},
        {status: 200, body: fixture_body(harness, DS_TEMPLATES_PAGE_2_PATH), headers: {}},
      ],
    },
  )
  const templates = collect_all(
    fn(args) { return list_data_source_templates(client, ds_id, nil, args.get("start_cursor"), 50) },
    {},
    "templates",
  )
  expect_eq(len(templates), 3, "templates paginate across two pages")
  expect_eq(templates[0].name, "Research note", "first template decoded")
  expect_eq(templates[2].id, "template-3", "last template decoded")
  const template_calls = http_mock_calls()
  expect_eq(len(template_calls), 2, "two GETs for template pagination")
  expect_contains(template_calls[0].url, "page_size=50", "template page_size forwarded")
  expect(template_calls[0].url.index_of("start_cursor=") < 0, "no template cursor on first page")
  expect_contains(
    template_calls[1].url,
    "start_cursor=templates-page-2",
    "template cursor forwarded",
  )
  // ---------------------------------------------------------------
  // generated pagination metadata — body cursors + alternate items fields
  // ---------------------------------------------------------------
  const query_plan = pagination_plan("post-database-query")
  expect(query_plan != nil, "data source query has generated pagination metadata")
  const query_plan_value = query_plan ?? {}
  expect_eq(
    query_plan_value.cursor_location,
    "body",
    "data source query cursor lives in request body",
  )
  expect_eq(
    query_plan_value.page_size_location,
    "body",
    "data source query page size lives in request body",
  )
  const query_next = pagination_next(
    {has_more: true, next_cursor: "page-2-cursor"},
    query_plan_value,
  )
  expect_eq(query_next.body.start_cursor, "page-2-cursor", "body cursor directive returned")
  const template_plan = pagination_plan("list-data-source-templates")
  expect(template_plan != nil, "template list has generated pagination metadata")
  const template_plan_value = template_plan ?? {}
  expect_eq(template_plan_value.items_field, "templates", "template plan uses templates item field")
  expect_eq(
    len(pagination_items({templates: templates}, template_plan_value)),
    3,
    "template plan extracts templates",
  )
  http_mock_clear()
  harness.stdio.println("notion_sdk_smoke: ok")
}
