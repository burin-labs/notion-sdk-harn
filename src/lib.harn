        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "List custom emojis",
      annotations: json_parse(
        "{\"destructiveHint\":false,\"idempotentHint\":true,\"readOnlyHint\":true}",
      ),
      execution_policy: json_parse("{\"kind\":\"fetch\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
