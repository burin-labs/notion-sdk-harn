        "{\"data_source_id\":{\"required\":false,\"schema\":{\"description\":\"ID of a data source (collection) to list all views for, including linked views across the workspace. At least one of database_id or data_source_id is required.\",\"type\":\"string\"}},\"database_id\":{\"required\":false,\"schema\":{\"description\":\"ID of a Notion database (collection view block) to list views for. At least one of database_id or data_source_id is required.\",\"type\":\"string\"}},\"page_size\":{\"required\":false,\"schema\":{\"description\":\"The number of items from the full list desired in the response. Maximum: 100\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},\"start_cursor\":{\"required\":false,\"schema\":{\"description\":\"If supplied, this endpoint will return a page of results starting after the cursor provided. If not supplied, this endpoint will return the first page of results.\",\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"dataSourceViewReferenceResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the view.\"},\"object\":{\"const\":\"view\",\"description\":\"The object type name.\",\"type\":\"string\"}},\"required\":[\"object\",\"id\"],\"type\":\"object\"},\"emptyObject\":{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"},\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"}},\"additionalProperties\":false,\"properties\":{\"has_more\":{\"type\":\"boolean\"},\"next_cursor\":{\"oneOf\":[{\"$ref\":\"#/$defs/idResponse\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"list\",\"description\":\"Always `list`\",\"type\":\"string\"},\"results\":{\"items\":{\"$ref\":\"#/$defs/dataSourceViewReferenceResponse\"},\"type\":\"array\"},\"type\":{\"const\":\"view\",\"description\":\"Always `view`\",\"type\":\"string\"},\"view\":{\"$ref\":\"#/$defs/emptyObject\"}},\"required\":[\"object\",\"next_cursor\",\"has_more\",\"results\",\"type\",\"view\"],\"type\":\"object\"}",
      ),
      handler: { args ->
        const result = list_views(
          harness,
          client,
          args.get("database_id"),
          args.get("data_source_id"),
          args.get("start_cursor"),
          args.get("page_size"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "List views",
      annotations: json_parse(
        "{\"destructiveHint\":false,\"idempotentHint\":true,\"readOnlyHint\":true}",
      ),
      execution_policy: json_parse("{\"kind\":\"fetch\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"views\",\"list_views\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"GET\",\"path\":\"/v1/views\"},\"id\":\"list-views\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
  tools = tool_define(
    tools,
    "create_view",
    "Create a view",
    {
      parameters: json_parse(
        "{\"body\":{\"required\":true,\"schema\":{\"$defs\":{\"boardViewConfigRequest\":{\"properties\":{\"card_layout\":{\"description\":\"Card layout mode. \\\"list\\\" shows full cards, \\\"compact\\\" shows condensed cards. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `list`, `compact`\",\"enum\":[\"list\",\"compact\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"cover\":{\"description\":\"Cover image configuration for cards. Pass null to clear.\",\"oneOf\":[{\"$ref\":\"#/$defs/coverConfigRequest\"},{\"type\":\"null\"}]},\"cover_aspect\":{\"description\":\"Aspect ratio mode for cover images. \\\"contain\\\" fits the image, \\\"cover\\\" fills the area. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `contain`, `cover`\",\"enum\":[\"contain\",\"cover\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"cover_size\":{\"description\":\"Size of the cover image on cards. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `small`, `medium`, `large`\",\"enum\":[\"small\",\"medium\",\"large\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"group_by\":{\"$ref\":\"#/$defs/groupByConfigRequest\",\"description\":\"Group-by configuration for board columns.\"},\"properties\":{\"description\":\"Property visibility and display configuration on cards. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"sub_group_by\":{\"description\":\"Secondary group-by configuration for sub-grouping within columns. Pass null to remove sub-grouping.\",\"oneOf\":[{\"$ref\":\"#/$defs/groupByConfigRequest\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"board\",\"description\":\"The view type. Must be \\\"board\\\".\",\"type\":\"string\"}},\"required\":[\"type\",\"group_by\"],\"type\":\"object\"},\"calendarViewConfigRequest\":{\"properties\":{\"date_property_id\":{\"description\":\"Property ID of the date property used to position items on the calendar.\",\"type\":\"string\"},\"properties\":{\"description\":\"Property visibility and display configuration on calendar cards. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_weekends\":{\"description\":\"Whether to show weekend days. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"calendar\",\"description\":\"The view type. Must be \\\"calendar\\\".\",\"type\":\"string\"},\"view_range\":{\"description\":\"Default calendar range. \\\"week\\\" shows a week view, \\\"month\\\" shows a month view. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `week`, `month`\",\"enum\":[\"week\",\"month\"],\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"chartAggregationRequest\":{\"properties\":{\"aggregator\":{\"description\":\"The aggregation operator. \\\"count\\\" counts all rows and does not require a property_id. All other operators require a property_id.\",\"enum\":[\"count\",\"count_values\",\"sum\",\"average\",\"median\",\"min\",\"max\",\"range\",\"unique\",\"empty\",\"not_empty\",\"percent_empty\",\"percent_not_empty\",\"checked\",\"unchecked\",\"percent_checked\",\"percent_unchecked\",\"earliest_date\",\"latest_date\",\"date_range\"],\"type\":\"string\"},\"property_id\":{\"description\":\"The property to aggregate on. Required for all operators except \\\"count\\\".\",\"type\":\"string\"}},\"required\":[\"aggregator\"],\"type\":\"object\"},\"chartReferenceLineRequest\":{\"properties\":{\"color\":{\"description\":\"Color of the reference line.\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"dash_style\":{\"description\":\"Line style: \\\"solid\\\" for a continuous line, \\\"dash\\\" for a dashed line.\",\"enum\":[\"solid\",\"dash\"],\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the reference line. Auto-generated if omitted.\",\"type\":\"string\"},\"label\":{\"description\":\"Label displayed alongside the reference line.\",\"type\":\"string\"},\"value\":{\"description\":\"The y-axis value where the reference line is drawn.\",\"type\":\"number\"}},\"required\":[\"value\",\"label\",\"color\",\"dash_style\"],\"type\":\"object\"},\"chartViewConfigRequest\":{\"properties\":{\"axis_labels\":{\"description\":\"Which axis labels to show. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `none`, `x_axis`, `y_axis`, `both`\",\"enum\":[\"none\",\"x_axis\",\"y_axis\",\"both\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"caption\":{\"description\":\"Chart caption text. Pass null to clear.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"chart_type\":{\"description\":\"The chart type.\",\"enum\":[\"column\",\"bar\",\"line\",\"donut\",\"number\"],\"type\":\"string\"},\"color_by_value\":{\"description\":\"Whether to color chart elements by their numeric value (gradient coloring). Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"color_theme\":{\"description\":\"Color theme. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `gray`, `blue`, `yellow`, `green`, `purple`, `teal`, `orange`, `pink`, `red`, `auto`, `colorful`\",\"enum\":[\"gray\",\"blue\",\"yellow\",\"green\",\"purple\",\"teal\",\"orange\",\"pink\",\"red\",\"auto\",\"colorful\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"cumulative\":{\"description\":\"Cumulative values (line only). Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"donut_labels\":{\"description\":\"Donut slice labels. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `none`, `value`, `name`, `name_and_value`\",\"enum\":[\"none\",\"value\",\"name\",\"name_and_value\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"grid_lines\":{\"description\":\"Which grid lines to show. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `none`, `horizontal`, `vertical`, `both`\",\"enum\":[\"none\",\"horizontal\",\"vertical\",\"both\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"group_style\":{\"description\":\"Grouped/stacked bar display style. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `normal`, `percent`, `side_by_side`\",\"enum\":[\"normal\",\"percent\",\"side_by_side\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"height\":{\"description\":\"Chart height. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `small`, `medium`, `large`, `extra_large`\",\"enum\":[\"small\",\"medium\",\"large\",\"extra_large\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"hide_empty_groups\":{\"description\":\"Whether to hide groups with no data. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"hide_line_fill_area\":{\"description\":\"Hide area fill (line only). Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"hide_title\":{\"description\":\"Hide title (number only). Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"legend_position\":{\"description\":\"Legend position. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `off`, `bottom`, `side`\",\"enum\":[\"off\",\"bottom\",\"side\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"reference_lines\":{\"description\":\"Reference lines on the chart. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/chartReferenceLineRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_data_labels\":{\"description\":\"Whether to show data labels. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"smooth_line\":{\"description\":\"Smooth line curves (line only). Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"sort\":{\"description\":\"Sort order for chart data. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `manual`, `x_ascending`,