/** Return the versioned static catalog projected from `adapter_tools`. */
pub fn adapter_catalog(
  harness: {clock: HarnessClock, net: HarnessNet},
  client: AdapterClient,
) -> ToolCatalog {
  return tool_schema(adapter_tools(harness, client))
}

/** Create a new NotionClient handle. */
pub fn new_client(
  base_url: string? = nil,
  credentials: dict<string, AdapterCredential> = {},
  extra_headers: AdapterHeaders = {"notion-version": "2022-06-28"},
  server_name: string? = nil,
) -> AdapterClient {
  const defaults = {"notion-version": "2022-06-28"}
  const configured_headers = _merge_header_dicts([defaults, extra_headers])
  return {
    base_url: _adapter_server_url(base_url, server_name),
    credentials: credentials,
    extra_headers: configured_headers,
    server_name: server_name,
    base_url_override: base_url != nil && server_name == nil,
  }
}

fn _adapter_application_error(error: unknown, operation: string, statuses: list<int>) -> dict? {
  if type_of(error) == "dict" && statuses.contains(error.get("status"))
    && type_of(error.get("body")) == "string" {
    const decoded = try {
      json_parse(error.body)
    }
    if is_ok(decoded) {
      return {
        operation: operation,
        status: error.get("status"),
        headers: error.get("headers") ?? {},
        body: unwrap(decoded),
      }
    }
  }
  return nil
}

/** Read the generated portable environment projection. */
pub fn adapter_environment_config(env: HarnessEnv) -> AdapterRuntimeConfig {
  let credentials: dict<string, AdapterCredential> = {}
  const credential_basic_auth_username = env.get("NOTION_BASICAUTH_USERNAME")
  const credential_basic_auth_password = env.get("NOTION_BASICAUTH_PASSWORD")
  if credential_basic_auth_username != nil && credential_basic_auth_username != ""
    && credential_basic_auth_password != nil
    && credential_basic_auth_password != "" {
    credentials = {
      ...credentials,
      basicAuth: {
        username: credential_basic_auth_username,
        password: credential_basic_auth_password,
      },
    }
  }
  const credential_bearer_auth_token = env.get("NOTION_BEARERAUTH_TOKEN")
  if credential_bearer_auth_token != nil && credential_bearer_auth_token != "" {
    credentials = {...credentials, bearerAuth: {token: credential_bearer_auth_token}}
  }
  const configured_base_url = env.get("NOTION_BASE_URL")
  const base_url = if configured_base_url != nil && configured_base_url != "" {
    configured_base_url
  } else {
    nil
  }
  const server_name = env.get("NOTION_SERVER_NAME")
  return {
    base_url: base_url,
    credentials: credentials,
    extra_headers: {},
    server_name: if server_name == "" {
      nil
    } else {
      server_name
    },
  }
}

/** Construct the one registry projected by CLI, MCP, and static schema commands. */
pub fn adapter_registry(
  harness: {clock: HarnessClock, net: HarnessNet},
  config: AdapterRuntimeConfig,
) -> ToolRegistry {
  const client = new_client(
    config.base_url,
    config.credentials,
    config.extra_headers,
    config.server_name,
  )
  return adapter_tools(pick(harness, ["clock", "net"]), client)
}

/** Validate runtime configuration before publishing any generated tool. */
pub fn validate_client(client: AdapterClient) -> nil {
  _validate_retrieve_a_block_client(client)
  _validate_delete_a_block_client(client)
  _validate_update_a_block_client(client)
  _validate_get_block_children_client(client)
  _validate_patch_block_children_client(client)
  _validate_list_comments_client(client)
  _validate_create_a_comment_client(client)
  _validate_retrieve_comment_client(client)
  _validate_delete_a_comment_client(client)
  _validate_update_a_comment_client(client)
  _validate_list_custom_emojis_client(client)
  _validate_create_a_database_client(client)
  _validate_retrieve_a_data_source_client(client)
  _validate_update_a_data_source_client(client)
  _validate_post_database_query_client(client)
  _validate_list_data_source_templates_client(client)
  _validate_create_database_client(client)
  _validate_retrieve_database_client(client)
  _validate_update_database_client(client)
  _validate_list_file_uploads_client(client)
  _validate_create_file_client(client)
  _validate_retrieve_file_upload_client(client)
  _validate_complete_file_upload_client(client)
  _validate_upload_file_client(client)
  _validate_introspect_token_client(client)
  _validate_revoke_token_client(client)
  _validate_create_a_token_client(client)
  _validate_post_page_client(client)
  _validate_retrieve_a_page_client(client)
  _validate_patch_page_client(client)
  _validate_retrieve_page_markdown_client(client)
  _validate_update_page_markdown_client(client)
  _validate_move_page_client(client)
  _validate_retrieve_a_page_property_client(client)
  _validate_post_search_client(client)
  _validate_get_users_client(client)
  _validate_get_self_client(client)
  _validate_get_user_client(client)
  _validate_list_views_client(client)
  _validate_create_view_client(client)
  _validate_retrieve_a_view_client(client)
  _validate_delete_view_client(client)
  _validate_update_a_view_client(client)
  _validate_create_view_query_client(client)
  _validate_get_view_query_results_client(client)
  _validate_delete_view_query_client(client)
  return nil
}

fn _validate_retrieve_a_block_client(client: AdapterClient) -> nil {
  if _server_retrieve_a_block(client).trim() == "" {
    throw "harn-openapi.generated: base URL configuration is required"
  }
  if !_security_available_retrieve_a_block(client) {
    throw "harn-openapi.generated: operation 'retrieve-a-block' requires one of [bearerAuth]"
  }
  return nil
}

fn _validate_delete_a_block_client(client: AdapterClient) -> nil {
  if _server_delete_a_block(client).trim() == "" {
