rnal URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"externalPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"external\":{\"additionalProperties\":false,\"description\":\"The external URL for the icon.\",\"properties\":{\"url\":{\"description\":\"The URL of the external file or resource.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Type of icon. In this case, an external URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"filePageCoverResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the cover.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of cover. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"filePageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the icon.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of icon. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"iconPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"icon\":{\"$ref\":\"#/$defs/noticonIconResponse\",\"description\":\"The Notion native icon, specified by name and color.\"},\"type\":{\"const\":\"icon\",\"description\":\"Type of icon. In this case, a Notion native icon.\",\"type\":\"string\"}},\"required\":[\"type\",\"icon\"],\"title\":\"Icon\",\"type\":\"object\"},\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"},\"internalFileResponse\":{\"additionalProperties\":false,\"properties\":{\"expiry_time\":{\"description\":\"The time when the URL will expire.\",\"format\":\"date-time\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the file.\",\"type\":\"string\"}},\"required\":[\"url\",\"expiry_time\"],\"type\":\"object\"},\"linkMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"description\":\"The description of the link.\",\"type\":\"string\"},\"height\":{\"description\":\"The height of the link preview iframe.\",\"type\":\"integer\"},\"href\":{\"description\":\"The href of the link mention.\",\"type\":\"string\"},\"icon_url\":{\"description\":\"The icon URL of the link.\",\"type\":\"string\"},\"iframe_url\":{\"description\":\"The iframe URL of the link.\",\"type\":\"string\"},\"link_author\":{\"description\":\"The author of the link.\",\"type\":\"string\"},\"link_provider\":{\"description\":\"The provider of the link.\",\"type\":\"string\"},\"padding\":{\"description\":\"The padding of the link preview iframe.\",\"type\":\"integer\"},\"padding_top\":{\"description\":\"The top padding of the link preview iframe.\",\"type\":\"integer\"},\"thumbnail_url\":{\"description\":\"The thumbnail URL of the link.\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the link.\",\"type\":\"string\"}},\"required\":[\"href\"],\"type\":\"object\"},\"linkPreviewMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"The URL of the link preview mention.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"mentionRichTextItemResponse\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/userValueResponse\",\"description\":\"Details of the user mention.\"}},\"required\":[\"type\",\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateResponse\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"type\",\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_preview\":{\"$ref\":\"#/$defs/linkPreviewMentionResponse\",\"description\":\"Details of the link preview mention.\"},\"type\":{\"const\":\"link_preview\",\"description\":\"Always `link_preview`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_preview\"],\"title\":\"Link Preview\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_mention\":{\"$ref\":\"#/$defs/linkMentionResponse\",\"description\":\"Details of the link mention.\"},\"type\":{\"const\":\"link_mention\",\"description\":\"Always `link_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_mention\"],\"title\":\"Link Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"page\":{\"additionalProperties\":false,\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"type\",\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"database\":{\"additionalProperties\":false,\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the database in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"database\",\"description\":\"Always `database`\",\"type\":\"string\"}},\"required\":[\"type\",\"database\"],\"title\":\"Database\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionResponse\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"custom_emoji\":{\"$ref\":\"#/$defs/customEmojiResponse\",\"description\":\"Details of the custom emoji mention.\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"type\",\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"}]},\"type\":{\"const\":\"mention\",\"description\":\"Always `mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"mention\"],\"title\":\"Mention\",\"type\":\"object\"},\"noticonColor\":{\"description\":\"One of: `gray`, `lightgray`, `brown`, `yellow`, `orange`, `green`, `blue`, `purple`, `pink`, `red`\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"noticonIconResponse\":{\"additionalProperties\":false,\"properties\":{\"color\":{\"$ref\":\"#/$defs/noticonColor\",\"description\":\"The color variant of the icon. Valid values: gray, lightgray, brown, yellow, orange, green, blue, purple, pink, red.\"},\"name\":{\"$ref\":\"#/$defs/noticonName\",\"description\":\"The name of the Notion icon (e.g. pizza, meeting, home). See the Notion icon picker for valid names.\"}},\"required\":[\"name\",\"color\"],\"type\":\"object\"},\"noticonName\":{\"examples\":[\"pizza\",\"meeting\",\"home\",\"star\",\"robot\"],\"type\":\"string\"},\"pageCoverResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/filePageCoverResponse\"},{\"$ref\":\"#/$defs/externalPageCoverResponse\"}]},\"pageIconResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/emojiPageIconResponse\"},{\"$ref\":\"#/$defs/filePageIconResponse\"},{\"$ref\":\"#/$defs/externa