fn _no_auth_headers(client: AdapterClient) -> AdapterHeaders {
  let hs: AdapterHeaders = {"Content-Type": "application/json"}
  for entry in client.extra_headers {
    hs = {...hs, [entry.key]: entry.value}
  }
  return hs
}

fn _merge_header_dicts(header_sets: list<AdapterHeaders>) -> AdapterHeaders {
  let out: AdapterHeaders = {}
  for hs in header_sets {
    for entry in hs {
      out = {...out, [entry.key]: entry.value}
    }
  }
  return out
}

fn _with_extra_headers(headers: AdapterHeaders, client: AdapterClient) -> AdapterHeaders {
  let hs = headers
  for entry in client.extra_headers {
    hs = {...hs, [entry.key]: entry.value}
  }
  return hs
}

fn _append_cookie_header(headers: AdapterHeaders, name: string, value: any) -> AdapterHeaders {
  if value == nil {
    return headers
  }
  const pair = url_encode(name) + "=" + url_encode(to_string(value))
  const existing = headers.get("Cookie") ?? headers.get("cookie")
  if existing == nil || existing == "" {
    return {...headers, Cookie: pair}
  }
  return {...headers, Cookie: to_string(existing) + "; " + pair}
}

/** Build a token-provider hook backed by the active connector SecretProvider. */
pub fn token_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
  return fn() {
    const value = secrets.read(secret_id)
    if value == nil {
      return ""
    }
    return to_string(value)
  }
}

/** Build an api-key-provider hook backed by the active connector SecretProvider. */
pub fn api_key_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
  return fn() {
    const value = secrets.read(secret_id)
    if value == nil {
      return ""
    }
    return to_string(value)
  }
}

fn _client_credential(client: AdapterClient, scheme_name: string) -> dict {
  return client.credentials.get(scheme_name) ?? {}
}

fn _credential_available(client: AdapterClient, scheme_name: string, kind: string) -> bool {
  const credential = _client_credential(client, scheme_name)
  if kind == "bearer" {
    return credential.get("token_provider") != nil
      || to_string(credential.get("token") ?? "") != ""
  }
  if starts_with(kind, "api_key_") {
    return credential.get("value_provider") != nil
      || to_string(credential.get("value") ?? "") != ""
  }
  if kind == "basic" {
    return credential.get("basic_provider") != nil
      || (to_string(credential.get("username") ?? "") != ""
        && to_string(credential.get("password") ?? "") != "")
  }
  if kind == "mutual_tls" {
    return credential.get("host_configured") == true
  }
  return false
}

fn _client_token(client: AdapterClient, scheme_name: string) -> string {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("token_provider")
  if provider != nil {
    return to_string(provider())
  }
  return to_string(credential.get("token") ?? "")
}

fn _client_api_key(client: AdapterClient, scheme_name: string) -> string {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("value_provider")
  if provider != nil {
    return to_string(provider())
  }
  return to_string(credential.get("value") ?? "")
}

fn _client_basic(client: AdapterClient, scheme_name: string) -> dict {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("basic_provider")
  if provider != nil {
    const provided = provider()
    return {user: provided.username, password: provided.password}
  }
  return {user: credential.get("username") ?? "", password: credential.get("password") ?? ""}
}

fn _headers_basic_auth(client: AdapterClient) -> dict {
  const basic = _client_basic(client, "basicAuth")
  if basic.get("user") == "" || basic.get("password") == "" {
    throw "harn-openapi.generated: security scheme 'basicAuth' requires both username and password"
  }
  let hs: dict = {"Content-Type": "application/json"}
  const encoded = base64_encode(to_string(basic.user) + ":" + to_string(basic.password))
  hs = {...hs, Authorization: "Basic " + encoded}
  return _with_extra_headers(hs, client)
}

fn _headers_bearer_auth(client: AdapterClient) -> dict {
  const token = _client_token(client, "bearerAuth")
  if token == "" {
    throw "harn-openapi.generated: security scheme 'bearerAuth' produced no credential"
  }
  let hs: dict = {"Content-Type": "application/json"}
  if token != "" {
    hs = {...hs, Authorization: "Bearer " + token}
  }
  return _with_extra_headers(hs, client)
}

/** Pagination plans detected from the OpenAPI operation shapes. */
pub fn pagination_plans() -> list {
  return json_parse(
    "[{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-block-children\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/blocks/{block_id}/children\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-comments\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/comments\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-custom-emojis\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/custom_emojis\"},{\"cursor_location\":\"body\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"post\",\"operation_id\":\"post-database-query\",\"page_size_location\":\"body\",\"page_size_param\":\"page_size\",\"path\":\"/v1/data_sources/{data_source_id}/query\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"templates\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-data-source-templates\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/data_sources/{data_source_id}/templates\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-file-uploads\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/file_uploads\"},{\"cursor_location\":\"body\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"post\",\"operation_id\":\"post-search\",\"page_size_location\":\"body\",\"page_size_param\":\"page_size\",\"path\":\"/v1/search\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-users\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/users\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-views\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/views\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-view-query-results\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/views/{view_id}/queries/{query_id}\"}]",
  )
}

/** Look up the pagination plan for a given operation id, or nil if none. */
pub fn pagination_plan(operation_id: string) -> dict? {
  for plan in pagination_plans() {
    if plan.operation_id == operation_id {
      return plan
    }
  }
  return nil
}

/** Extract the items list from `response` according to `plan`. */
pub fn pagination_items(response: dict, plan: dict) -> list {
  const field = plan.get("items_field")
  if field == nil {
    return []
  }
  const value = response.get(field)
  if type_of(value) == "list" {
    return value
  }
  return []
}

/**
 * Compute the next-page directive from `response` according to `plan`.
 * Returns a dict with `done: bool` plus a `query` or `body` dict to merge
 * into the next call, or a `url` to follow (next-link style).
 */
pub fn pagination_next(response: dict, plan: dict) -> dict {
  const kind = plan.get("kind")
  if kind == "cursor" {
    const cursor_field = plan.get("cursor_response_field")
    const cursor = if cursor_field == nil {
      nil
    } else {
      response.get(cursor_field)
    }
    const has_more_field = plan.get("has_more_field")
    const has_more = if has_more_field == nil {
      cursor != nil
    } else {
      response.get(has_more_field)
    }
    const field = plan.get("cursor_param")
    if plan.get("cursor_location") == "body" {
      return {done: cursor == nil || !has_more, body: {[field]: cursor}}
    }
    return {done: cursor == nil || !has_more, query: {[field]: cursor}}
  }
  if kind == "page" {
    return {done: false, query: {}}
  }
  if kind == "next_link" {
    const field = plan.get("next_link_field")
    let url = if field == nil {
      nil
    } else {
      response.get(field)
    }
    return {done: url == nil || url == "", url: url}
  }
  return {done: true, query: {}}
}

/** Rate-limit response/header conventions detected from OpenAPI responses. */
pub fn rate_limit_metadata() -> list {
  return json_parse(
