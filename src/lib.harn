ays `user`\",\"type\":\"string\"}},\"required\":[\"id\",\"object\"],\"type\":\"object\"},\"personUserObjectResponse\":{\"properties\":{\"person\":{\"additionalProperties\":false,\"description\":\"Details about the person, when the `type` of the user is `person`.\",\"properties\":{\"email\":{\"description\":\"The email of the person.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"const\":\"person\",\"description\":\"Indicates this user is a person.\",\"type\":\"string\"}},\"required\":[\"type\",\"person\"],\"title\":\"Person\",\"type\":\"object\"},\"richTextItemResponse\":{\"allOf\":[{\"$ref\":\"#/$defs/richTextItemResponseCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/textRichTextItemResponse\"},{\"$ref\":\"#/$defs/mentionRichTextItemResponse\"},{\"$ref\":\"#/$defs/equationRichTextItemResponse\"}]}]},\"richTextItemResponseCommon\":{\"additionalProperties\":false,\"properties\":{\"annotations\":{\"$ref\":\"#/$defs/annotationResponse\",\"description\":\"All rich text objects contain an annotations object that sets the styling for the rich text.\"},\"href\":{\"description\":\"A URL that the rich text object links to or mentions.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"plain_text\":{\"description\":\"The plain text content of the rich text object, without any styling.\",\"type\":\"string\"}},\"required\":[\"plain_text\",\"href\",\"annotations\"],\"type\":\"object\"},\"templateMentionDateTemplateMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"template_mention_date\":{\"description\":\"The date of the template mention.\",\"enum\":[\"today\",\"now\"],\"type\":\"string\"},\"type\":{\"const\":\"template_mention_date\",\"description\":\"Always `template_mention_date`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention_date\"],\"title\":\"Template Mention Date\",\"type\":\"object\"},\"templateMentionResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/templateMentionDateTemplateMentionResponse\"},{\"$ref\":\"#/$defs/templateMenti