 for dependency arrows.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"type\":\"object\"},\"timelinePreferenceResponse\":{\"additionalProperties\":false,\"properties\":{\"center_timestamp\":{\"description\":\"Center timestamp for the timeline view (Unix timestamp in ms).\",\"minimum\":0,\"type\":\"integer\"},\"zoom_level\":{\"description\":\"Zoom level for the timeline.\",\"enum\":[\"hours\",\"day\",\"week\",\"bi_week\",\"month\",\"quarter\",\"year\",\"5_years\"],\"type\":\"string\"}},\"required\":[\"zoom_level\"],\"type\":\"object\"},\"timelineViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"arrows_by\":{\"$ref\":\"#/$defs/timelineArrowsByResponse\",\"description\":\"Dependency arrows configuration.\"},\"color_by\":{\"description\":\"Whether to color-code items by property.\",\"type\":\"boolean\"},\"date_property_id\":{\"description\":\"Start date property - required.\",\"type\":\"string\"},\"date_property_name\":{\"description\":\"Start date property name (convenience field).\",\"type\":\"string\"},\"end_date_property_id\":{\"description\":\"End date property (optional, for items that span a range).\",\"type\":\"string\"},\"end_date_property_name\":{\"description\":\"End date property name (convenience field).\",\"type\":\"string\"},\"preference\":{\"$ref\":\"#/$defs/timelinePreferenceResponse\",\"description\":\"Timeline zoom/preference state.\"},\"properties\":{\"description\":\"Properties to display on timeline items.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"show_table\":{\"description\":\"Whether to show the table panel alongside the timeline.\",\"type\":\"boolean\"},\"table_properties\":{\"description\":\"Properties to display in the table panel (when show_table is true).\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"type\":{\"const\":\"timeline\",\"description\":\"The view configuration type.\",\"type\":\"strin