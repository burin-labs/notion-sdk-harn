g\"}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"timestampSortResponse\":{\"additionalProperties\":false,\"properties\":{\"direction\":{\"description\":\"Sort direction.\",\"enum\":[\"ascending\",\"descending\"],\"type\":\"string\"},\"timestamp\":{\"description\":\"The timestamp to sort by.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\",\"direction\"],\"type\":\"object\"},\"viewConfigResponse\":{\"description\":\"View configuration, typed by view type (table, board, calendar, etc.).\",\"oneOf\":[{\"$ref\":\"#/$defs/tableViewConfigResponse\"},{\"$ref\":\"#/$defs/boardViewConfigResponse\"},{\"$ref\":\"#/$defs/calendarViewConfigResponse\"},{\"$ref\":\"#/$defs/timelineViewConfigResponse\"},{\"$ref\":\"#/$defs/galleryViewConfigResponse\"},{\"$ref\":\"#/$defs/listViewConfigResponse\"},{\"$ref\":\"#/$defs/mapViewConfigResponse\"},{\"$ref\":\"#/$defs/formViewConfigResponse\"},{\"$ref\":\"#/$defs/chartViewConfigResponse\"},{\"$ref\":\"#/$defs/dashboardViewConfigResponse\"}]},\"viewFilterResponse\":{\"description\":\"Filter for the view. Can be a property filter (filter by property value), timestamp filter (filter by created_time or last_edited_time), or compound filter (combine filters with and/or logic). Compound filters support up to 2 levels of nesting.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field sp