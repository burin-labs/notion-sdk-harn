  tools = tool_define(
    tools,
    "update_a_comment",
    "Update a comment",
    {
      parameters: json_parse(
        "{\"body\":{\"required\":true,\"schema\":{\"$defs\":{\"annotationRequest\":{\"properties\":{\"bold\":{\"description\":\"Whether the text is formatted as bold.\",\"type\":\"boolean\"},\"code\":{\"description\":\"Whether the text is formatted as code.\",\"type\":\"boolean\"},\"color\":{\"$ref\":\"#/$defs/apiColor\",\"description\":\"The color of the text.\"},\"italic\":{\"description\":\"Whether the text is formatted as italic.\",\"type\":\"boolean\"},\"strikethrough\":{\"description\":\"Whether the text is formatted with a strikethrough.\",\"type\":\"boolean\"},\"underline\":{\"description\":\"Whether the text is formatted with an underline.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apiColor\":{\"description\":\"One of: `default`, `gray`, `brown`, `orange`, `yellow`, `green`, `blue`, `purple`, `pink`, `red`, `default_background`, `gray_background`, `brown_background`, `orange_background`, `yellow_background`, `green_background`, `blue_background`, `purple_background`, `pink_background`, `red_background`\",\"enum\":[\"default\",\"gray\",\"brown\",\"orange\",\"yellow\",\"green\",\"blue\",\"purple\",\"pink\",\"red\",\"default_background\",\"gray_background\",\"brown_background\",\"orange_background\",\"yellow_background\",\"green_background\",\"blue_background\",\"purple_background\",\"pink_background\",\"red_background\"],\"type\":\"string\"},\"dateRequest\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"description\":\"The end date of the date object, if any.\",\"oneOf\":[{\"format\":\"date\",\"type\":\"string\"},{\"type\":\"null\"}]},\"start\":{\"description\":\"The start date of the date object.\",\"format\":\"date\",\"type\":\"string\"},\"time_zone\":{\"description\":\"The time zone of the date object, if any. E.g. America/Los_Angeles, Europe/London, etc.\",\"oneOf\":[{\"$ref\":\"#/$defs/timeZoneRequest\"},{\"type\":\"null\"}]}},\"required\":[\"start\"],\"type\":\"object\"},\"equationRichTextItemRequest\":{\"properties\":{\"equation\":{\"description\":\"Notion supports inline LaTeX equations as rich text objects with a type value of `equation`.\",\"properties\":{\"expression\":{\"description\":\"A KaTeX compatible string.\",\"examples\":[\"e=mc^2\"],\"type\":\"string\"}},\"required\":[\"expression\"],\"type\":\"object\"},\"type\":{\"const\":\"equation\",\"description\":\"Always `equation`\",\"type\":\"string\"}},\"required\":[\"equation\"],\"title\":\"Equation\",\"type\":\"object\"},\"idRequest\":{\"type\":\"string\"},\"mentionRichTextItemRequest\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/partialUserObjectRequest\",\"description\":\"Details of the user mention.\"}},\"required\":[\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateRequest\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"properties\":{\"page\":{\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"properties\":{\"database\":{\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the database in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"database\",\"description\":\"Always `database`\",\"type\":\"string\"}},\"required\":[\"database\"],\"title\":\"Database\",\"type\":\"object\"},{\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionRequest\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"properties\":{\"custom_emoji\":{\"description\":\"Details of the custom emoji mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the custom emoji.\"},\"name\":{\"description\":\"The name of the custom emoji.\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the custom emoji.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"}]},\"type\":{\"const\":\"mention\",\"description\":\"Always `mention`\",\"type\":\"string\"}},\"required\":[\"mention\"],\"title\":\"Mention\",\"type\":\"object\"},\"partialUserObjectRequest\":{\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the user.\"},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"richTextItemRequest\":{\"allOf\":[{\"$ref\":\"#/$defs/richTextItemRequestCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/textRichTextItemRequest\"},{\"$ref\":\"#/$defs/mentionRichTextItemRequest\"},{\"$ref\":\"#/$defs/equationRichTextItemRequest\"}]}]},\"richTextItemRequestCommon\":{\"properties\":{\"annotations\":{\"$ref\":\"#/$defs/annotationRequest\",\"description\":\"All rich text objects contain an annotations object that sets the styling for the rich text.\"}},\"type\":\"object\"},\"templateMentionDateTemplateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_date\":{\"description\":\"The date of the template mention.\",\"enum\":[\"today\",\"now\"],\"type\":\"string\"},\"type\":{\"const\":\"template_mention_date\",\"description\":\"Always `template_mention_date`\",\"type\":\"string\"}},\"required\":[\"template_mention_date\"],\"title\":\"Template Mention Date\",\"type\":\"object\"},\"templateMentionRequest\":{\"oneOf\":[{\"$ref\":\"#/$defs/templateMentionDateTemplateMentionRequest\"},{\"$ref\":\"#/$defs/templateMentionUserTemplateMentionRequest\"}]},\"templateMentionUserTemplateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_user\":{\"const\":\"me\",\"description\":\"The user of the template mention.\",\"type\":\"string\"},\"type\":{\"const\":\"template_mention_user\",\"description\":\"Always `template_mention_user`\",\"type\":\"string\"}},\"required\":[\"template_mention_user\"],\"title\":\"Template Mention User\",\"type\":\"object\"},\"textRichTextItemRequest\":{\"properties\":{\"text\":{\"additionalProperties\":false,\"description\":\"If a rich text object's type value is `text`, then the corresponding text field contains an object including the text content and any inline link.\",\"properties\":{\"content\":{\"description\":\"The actual text content of the text.\",\"maxLength\":2000,\"type\":\"string\"},\"link\":{\"description\":\"An object with information about any inline link in this text, if included.\",\"oneOf\":[{\"properties\":{\"url\":{\"description\":\"The URL of the link.\",\"examples\":[\"https://www.notion.com\"],\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},{\"type\":\"null\"}]}},\"required\":[\"content\"],\"type\":\"object\"},\"type\":{\"const\":\"text\",\"description\":\"Always `text`\",\"type\":\"string\"}},\"required\":[\"text\"],\"title\":\"Text\",\"type\":\"object\"},\"timeZoneRequest\":{\"type\":\"string\"}},\"oneOf\":[{\"properties\":{\"rich_text\":{\"description\":\"An array of rich text objects that represent the updated content of the comment.\",\"items\":{\"$ref\":\"#/$defs/richTextItemRequest\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"rich_text\"],\"type\":\"object\"},{\"properties\":{\"markdown\":{\"description\":\"The updated content of the comment as a Markdown string. Comment Markdown supports inline formatting only (bold, italic, strikethrough, code, links), inline equations ($expression$), and mentions. Block-level Markdown such as fenced code blocks, headings, lists, tables, and blockquotes does not render as structured blocks in comments.\",\"type\":\"string\"}},\"required\":[\"markdown\"],\"type\":\"object\"}]}},\"comment_id\":{\"required\":true,\"schema\":{\"description\":\"The ID of the comment to update.\",\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"annotationResponse\":{\"additionalProperties\":false,\"properties\":{\"bold\":{\"type\":\"boolean\"},\"code\":{\"type\":\"boolean\"},\"color\":{\"$ref\":\"#/$defs/apiColor\"},\"italic\":{\"type\":\"boolean\"},\"strikethrough\":{\"type\":\"boolean\"},\"underline\":{\"type\":\"boolean\"}},\"required\":[\"bold\",\"italic\",\"strikethrough\",\"underline\",\"code\",\"color\"],\"type\":\"object\"},\"apiColor\":{\"description\":\"One of: `default`, `gray`, `brown`, `orange`, `yellow`, `green`, `blue`, `purple`, `pink`, `red`, `default_background`, `gray_background`, `brown_background`, `orange_background`, `yellow_background`, `green_background`, `blue_background`, `purple_background`, `pink_background`, `red_background`\",\"enum\":[\"default\",\"gray\",\"brown\",\"orange\",\"yellow\",\"green\",\"blue\",\"purple\",\"pink\",\"red\",\"default_background\",\"gray_background\",\"brown_background\",\"orange_background\",\"yellow_background\",\"green_background\",\"blue_background\",\"purple_background\",\"pink_background\",\"red_background\"],\"type\":\"string\"},\"blockIdCommentParentResponse\":{\"additionalProperties\":false,\"properties\":{\"block_id\":{\"$ref\":\"#/$defs/idResponse\"},\"type\":{\"const\":\"block_id\",\"description\":\"Always `block_id`\",\"type\":\"string\"}},\"required\":[\"type\",\"block_id\"],\"title\":\"Block Id\",\"type\":\"object\"},\"botInfoResponse\":{\"additionalProperties\":false,\"properties\":{\"owner\":{\"description\":\"Details about the owner of the bot.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"description\":\"Details about the owner of the bot, when the `type` of the owner is `user`. This means the bot is for a integration.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"avatar_url\":{\"description\":\"The avatar URL of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the user.\"},\"name\":{\"description\":\"The name of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"},\"person\":{\"additionalProperties\":false,\"description\":\"The person info of the user.\",\"properties\":{\"email\":{\"description\":\"The email of the person.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"const\":\"person\",\"description\":\"The type of the user.\",\"type\":\"string\"}},\"required\":[\"id\",\"object\",\"name\",\"avatar_url\",\"type\",\"person\"],\"type\":\"object\"},{\"$ref\":\"#/$defs/partialUserObjectResponse\"}]}},\"required\":[\"type\",\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"workspace\",\"description\":\"Always `workspace`\",\"type\":\"string\"},\"workspace\":{\"const\":true,\"description\":\"Details about the owner of the bot, when the `type` of the owner is `workspace`. This means the bot is for an internal integration.\",\"type\":\"boolean\"}},\"required\":[\"type\",\"workspace\"],\"title\":\"Workspace\",\"type\":\"object\"}]},\"workspace_id\":{\"description\":\"The ID of the bot's workspace.\",\"type\":\"string\"},\"workspace_limits\":{\"additionalProperties\":false,\"description\":\"Limits and restrictions that apply to the bot's workspace\",\"properties\":{\"max_file_upload_size_in_bytes\":{\"description\":\"The maximum allowable size of a file upload, in bytes\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"max_file_upload_size_in_bytes\"],\"type\":\"object\"},\"workspace_name\":{\"description\":\"The name of the bot's workspace.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"owner\",\"workspace_id\",\"workspace_limits\",\"workspace_name\"],\"type\":\"object\"},\"botUserObjectResponse\":{\"properties\":{\"bot\":{\"description\":\"Details about the bot, when the `type` of the user is `bot`.\",\"oneOf\":[{\"$ref\":\"#/$defs/emptyObject\"},{\"$ref\":\"#/$defs/botInfoResponse\"}]},\"type\":{\"const\":\"bot\",\"description\":\"Indicates this user is a bot.\",\"type\":\"string\"}},\"required\":[\"type\",\"bot\"],\"title\":\"Bot\",\"type\":\"object\"},\"commentObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"attachments\":{\"description\":\"Any file attachments associated with the comment.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"category\":{\"description\":\"One of: `audio`, `image`, `pdf`, `productivity`, `video`\",\"enum\":[\"audio\",\"image\",\"pdf\",\"productivity\",\"video\"],\"type\":\"string\"},\"file\":{\"$ref\":\"#/$defs/internalFileResponse\"}},\"required\":[\"category\",\"file\"],\"type\":\"object\"},\"maxItems\":100,\"type\":\"array\"},\"created_by\":{\"$ref\":\"#/$defs/partialUserObjectResponse\",\"description\":\"The user who created the comment.\"},\"created_time\":{\"description\":\"The time when the comment was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"discussion_id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the discussion thread this comment belongs to.\"},\"display_name\":{\"additionalProperties\":false,\"description\":\"The display name of the comment.\",\"properties\":{\"resolved_name\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"type\":{\"description\":\"One of: `custom`, `user`, `integration`\",\"enum\":[\"custom\",\"user\",\"integration\"],\"type\":\"string\"}},\"required\":[\"type\",\"resolved_name\"],\"type\":\"object\"},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the comment.\"},\"last_edited_time\":{\"description\":\"The time when the comment was last edited.\",\"format\":\"date-time\",\"type\":\"string\"},\"object\":{\"const\":\"comment\",\"description\":\"The comment object type name.\",\"type\":\"string\"},\"parent\":{\"$ref\":\"#/$defs/commentParentResponse\"