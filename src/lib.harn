ng\"},\"properties\":{\"description\":\"Property visibility and display configuration on calendar cards. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_weekends\":{\"description\":\"Whether to show weekend days. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"calendar\",\"description\":\"The view type. Must be \\\"calendar\\\".\",\"type\":\"string\"},\"view_range\":{\"description\":\"Default calendar range. \\\"week\\\" shows a week view, \\\"month\\\" shows a month view. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `week`, `month`\",\"enum\":[\"week\",\"month\"],\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"chartAggregationRequest\":{\"properties\":{\"aggregator\":{\"description\":\"The aggregation operator. \\\"count\\\" counts all rows and does not require a property_id. All other operators require a property_id.\",\"enum\":[\"count\",\"count_values\",\"sum\",\"average\",\"median\",\"min\",\"max\",\"range\",\"unique\",\"empty\",\"not_empty\",\"percent_empty\",\"percent_not_empty\",\"checked\",\"unchecked\",\"percent_checked\",\"percent_unchecked\",\"earliest_date\",\"latest_date\",\"date_range\"],\"type\":\"string\"},\"property_id\":{\"description\":\"The property to aggregate on. Required for all operators except \\\"count\\\".\",\"type\":\"string\"}},\"required\":[\"aggregator\"],\"type\":\"object\"},\"chartReferenceLineRequest\":{\"properties\":{\"color\":{\"description\":\"Color of the reference line.\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"dash_style\":{\"description\":\"Line style: \\\"solid\\\" for a continuous line, \\\"dash\\\" for a dashed line.\",\"enum\":[\"solid\",\"dash\"],\"type\":\"string\"},\"id\":{\"descripti