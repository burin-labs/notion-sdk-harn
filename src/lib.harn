 for dependency arrows.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"type\":\"object\"},\"timelinePreferenceResponse\":{\"additionalProperties\":false,\"properties\":{\"center_timestamp\":{\"description\":\"Center timestamp for the timeline view (Unix timestamp in ms).\",\"minimum\":0,\"type\":\"integer\"},\"zoom_level\":{\"description\":\"Zoom level for the timeline.\",\"enum\":[\"hours\",\"day\",\"week\",\"bi_week\",\"month\",\"quarter\",\"year\",\"5_years\"],\"type\":\"string\"}},\"required\":[\"zoom_level\"],\"type\":\"object\"},\"timelineViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"arrows_by\":{\"$ref\":\"#/$defs/timelineArrowsByResponse\",\"description\":\"Dependency arrows configuration.\"},\"color_by\":{\"description\":\"Whether to color-code items by property.\",\"type\":\"boolean\"},\"date_property_id\":{\"description\":\"Start date property - required.\",\"type\":\"string\"},\"date_property_name\":{\"description\":\"Start date property name (convenience field).\",\"type\":\"string\"},\"end_date_property_id\":{\"description\":\"End date property (optional, for items that span a range).\",\"type\":\"string\"},\"end_date_property_name\":{\"description\":\"End date property name (convenience field).\",\"type\":\"string\"},\"preference\":{\"$ref\":\"#/$defs/timelinePreferenceResponse\",\"description\":\"Timeline zoom/preference state.\"},\"properties\":{\"description\":\"Properties to display on timeline items.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"show_table\":{\"description\":\"Whether to show the table panel alongside the timeline.\",\"type\":\"boolean\"},\"table_properties\":{\"description\":\"Properties to display in the table panel (when show_table is true).\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"type\":{\"const\":\"timeline\",\"description\":\"The view configuration type.\",\"type\":\"string\"}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"timestampSortResponse\":{\"additionalProperties\":false,\"properties\":{\"direction\":{\"description\":\"Sort direction.\",\"enum\":[\"ascending\",\"descending\"],\"type\":\"string\"},\"timestamp\":{\"description\":\"The timestamp to sort by.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\",\"direction\"],\"type\":\"object\"},\"viewConfigResponse\":{\"description\":\"View configuration, typed by view type (table, board, calendar, etc.).\",\"oneOf\":[{\"$ref\":\"#/$defs/tableViewConfigResponse\"},{\"$ref\":\"#/$defs/boardViewConfigResponse\"},{\"$ref\":\"#/$defs/calendarViewConfigResponse\"},{\"$ref\":\"#/$defs/timelineViewConfigResponse\"},{\"$ref\":\"#/$defs/galleryViewConfigResponse\"},{\"$ref\":\"#/$defs/listViewConfigResponse\"},{\"$ref\":\"#/$defs/mapViewConfigResponse\"},{\"$ref\":\"#/$defs/formViewConfigResponse\"},{\"$ref\":\"#/$defs/chartViewConfigResponse\"},{\"$ref\":\"#/$defs/dashboardViewConfigResponse\"}]},\"viewFilterResponse\":{\"description\":\"Filter for the view. Can be a property filter (filter by property value), timestamp filter (filter by created_time or last_edited_time), or compound filter (combine filters with and/or logic). Compound filters support up to 2 levels of nesting.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"},{\"description\":\"A compound filter that combines multiple filters with AND or OR logic. Supports up to 2 levels of nesting.\",\"properties\":{\"and\":{\"description\":\"Filters combined with AND logic.\",\"items\":{\"description\":\"A filter that can be a property filter, timestamp filter, or nested compound filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"},{\"description\":\"A compound filter at the deepest nesting level. Can only contain property or timestamp filters (no further nesting).\",\"properties\":{\"and\":{\"description\":\"Filters combined with AND logic.\",\"items\":{\"description\":\"A property filter or timestamp filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"}]},\"type\":\"array\"},\"or\":{\"description\":\"Filters combined with OR logic.\",\"items\":{\"description\":\"A property filter or timestamp filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"}]},\"type\":\"array\"}},\"type\":\"object\"}]},\"type\":\"array\"},\"or\":{\"description\":\"Filters combined with OR logic.\",\"items\":{\"description\":\"A filter that can be a property filter, timestamp filter, or nested compound filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"},{\"description\":\"A compound filter at the deepest nesting level. Can only contain property or timestamp filters (no further nesting).\",\"properties\":{\"and\":{\"description\":\"Filters combined with AND logic.\",\"items\":{\"description\":\"A property filter or timestamp filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"}]},\"type\":\"array\"},\"or\":{\"description\":\"Filters combined with OR logic.\",\"items\":{\"description\":\"A property filter or timestamp filter.\",\"oneOf\":[{\"additionalProperties\":true,\"description\":\"A filter condition on a specific property. The property field specifies which property to filter, and an additional field specifies the filter type and condition (e.g., title, rich_text, number, checkbox, select, multi_select, date, people, files, relation, formula, rollup, etc.).\",\"properties\":{\"property\":{\"description\":\"The name or ID of the property to filter on.\",\"type\":\"string\"}},\"required\":[\"property\"],\"type\":\"object\"},{\"additionalProperties\":true,\"description\":\"A filter condition on a timestamp (created_time or last_edited_time). The timestamp field specifies which timestamp, and a matching field contains the date filter condition.\",\"properties\":{\"timestamp\":{\"description\":\"The timestamp to filter on.\",\"enum\":[\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"}]},\"type\":\"array\"}},\"type\":\"object\"}]},\"type\":\"array\"}},\"type\":\"object\"}]},\"viewPropertyConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"card_property_width_mode\":{\"description\":\"Property width mode in compact card layouts (board/gallery).\",\"enum\":[\"full_line\",\"inline\"],\"type\":\"string\"},\"date_format\":{\"description\":\"Date display format (date properties only). \\\"full\\\" = localized full date, \\\"short\\\" = month and day, \\\"month_day_year\\\" = MM/DD/YYYY, \\\"day_month_year\\\" = DD/MM/YYYY, \\\"year_month_day\\\" = YYYY/MM/DD, \\\"relative\\\" = relative dates.\",\"enum\":[\"full\",\"short\",\"month_day_year\",\"day_month_year\",\"year_month_day\",\"relative\"],\"type\":\"string\"},\"property_id\":{\"description\":\"Property ID (stable identifier).\",\"type\":\"string\"},\"property_name\":{\"description\":\"Property name (convenience field, not stable across renames).\",\"type\":\"string\"},\"status_show_as\":{\"description\":\"How to display status properties (as select dropdown or checkbox).\",\"enum\":[\"select\",\"checkbox\"],\"type\":\"string\"},\"time_format\":{\"description\":\"Time display format (date properties only). \\\"12_hour\\\" = 12-hour clock with AM/PM, \\\"24_hour\\\" = 24-hour clock, \\\"hidden\\\" = hide time.\",\"enum\":[\"12_hour\",\"24_hour\",\"hidden\"],\"type\":\"string\"},\"visible\":{\"description\":\"Whether this property is visible in the view.\",\"type\":\"boolean\"},\"width\":{\"description\":\"Width of the property column in pixels (table view only).\",\"minimum\":0,\"type\":\"integer\"},\"wrap\":{\"description\":\"Whether to wrap content in this property cell/card.\",\"type\":\"boolean\"}},\"required\":[\"property_id\"],\"type\":\"object\"},\"viewSortResponse\":{\"description\":\"Sort for the view. Can sort by property or timestamp.\",\"oneOf\":[{\"$ref\":\"#/$defs/propertySortResponse\"},{\"$ref\":\"#/$defs/timestampSortResponse\"}]}},\"oneOf\":[{\"$ref\":\"#/$defs/partialDataSourceViewObjectResponse\"},{\"$ref\":\"#/$defs/dataSourceViewObjectResponse\"}]}",
      ),
      handler: { args ->
        const result = create_view(harness, client, args.get("body"), args.get("notion_version"))
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "Create a view",
      annotations: json_parse("{\"idempotentHint\":false,\"readOnlyHint\":false}"),
      execution_policy: json_parse("{\"kind\":\"execute\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"views\",\"create_view\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"POST\",\"path\":\"/v1/views\"},\"id\":\"create-view\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
  tools = tool_define(
    tools,
    "retrieve_a_view",
    "Retrieve a view",
    {
      parameters: json_parse(
        "{\"view_id\":{\"required\":true,\"schema\":{\"description\":\"ID of a Notion view.\",\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"boardViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"card_layout\":{\"description\":\"Card layout mode (list shows all properties, compact shows inline).\",\"enum\":[\"list\",\"compact\"],\"type\":\"string\"},\"cover\":{\"$ref\":\"#/$defs/coverConfigResponse\",\"description\":\"Card cover/preview image configuration.\"},\"cover_aspect\":{\"description\":\"Cover image aspect ratio.\",\"enum\":[\"contain\",\"cover\"],\"type\":\"string\"},\"cover_size\":{\"description\":\"Cover image size.\",\"enum\":[\"small\",\"medium\",\"large\"],\"type\":\"string\"},\"group_by\":{\"$ref\":\"#/$defs/groupByConfigResponse\",\"description\":\"Column (horizontal) grouping - required for board view.\"},\"properties\":{\"description\":\"Properties to display on each card.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"sub_group_by\":{\"$ref\":\"#/$defs/groupByConfigResponse\",\"description\":\"Sub-grouping (vertical swimlanes within columns).\"},\"type\":{\"const\":\"board\",\"description\":\"The view configuration type.\",\"type\":\"string\"}},\"required\":[\"type\",\"group_by\"],\"type\":\"object\"},\"calendarViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"date_property_id\":{\"description\":\"Date property used to position items on the calendar - required.\",\"type\":\"string\"},\"date_property_name\":{\"description\":\"Date property name (convenience field).\",\"type\":\"string\"},\"properties\":{\"description\":\"Properties to display on calendar event cards.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"show_weekends\":{\"description\":\"Whether to show weekend days.\",\"type\":\"boolean\"},\"type\":{\"const\":\"calendar\",\"description\":\"The view configuration type.\",\"type\":\"string\"},\"view_range\":{\"description\":\"Calendar view range.\",\"enum\":[\"week\",\"month\"],\"type\":\"string\"}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"chartAggregationResponse\":{\"additionalProperties\":false,\"properties\":{\"aggregator\":{\"description\":\"The aggregation operator. \\\"count\\\" counts all rows and does not require a property_id. All other operators require a property_id.\",\"enum\":[\"count\",\"count_values\",\"sum\",\"average\",\"median\",\"min\",\"max\",\"range\",\"unique\",\"empty\",\"not_empty\",\"percent_empty\",\"percent_not_empty\",\"checked\",\"unchecked\",\"percent_checked\",\"percent_unchecked\",\"earliest_date\",\"latest_date\",\"date_range\"],\"type\":\"string\"},\"property_id\":{\"description\":\"The property to aggregate on. Required for all operators except \\\"count\\\".\",\"type\":\"string\"}},\"required\":[\"aggregator\"],\"type\":\"object\"},\"chartReferenceLineResponse\":{\"additionalProperties\":false,\"properties\":{\"color\":{\"description\":\"Color of the reference line.\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"dash_style\":{\"description\":\"Line style: \\\"solid\\\" for a continuous line, \\\"dash\\\" for a dashed line.\",\"enum\":[\"solid\",\"dash\"],\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the reference line.\",\"type\":\"string\"},\"label\":{\"description\":\"Label displayed alongside the reference line.\",\"type\":\"string\"},\"value\":{\"description\":\"The y-axis value where the reference line is drawn.\",\"type\":\"number\"}},\"required\":[\"id\",\"value\",\"label\",\"color\",\"dash_style\"],\"type\":\"object\"},\"chartViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"axis_labels\":{\"description\":\"Which axis labels to display.\",\"enum\":[\"none\",\"x_axis\",\"y_axis\",\"both\"],\"type\":\"string\"},\"caption\":{\"description\":\"Text caption displayed below the chart. Null when no caption is shown.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"chart_type\":{\"description\":\"The chart type: column (vertical bars), bar (horizontal bars), line, donut, or number (single value display).\",\"enum\":[\"column\",\"bar\",\"line\",\"donut\",\"number\"],\"type\":\"string\"},\"color_by_value\":{\"description\":\"Whether chart elements are colored by their numeric value (gradient coloring).\",\"type\":\"boolean\"},\"color_theme\":{\"description\":\"Color theme for the chart.\",\"enum\":[\"gray\",\"blue\",\"yellow\",\"green\",\"purple\",\"teal\",\"orange\",\"pink\",\"red\",\"auto\",\"colorful\"],\"type\":\"string\"},\"cumulative\":{\"description\":\"Whether to show cumulative values (line charts only).\",\"type\":\"boolean\"},\"donut_labels\":{\"description\":\"What to display on donut chart slices.\",\"enum\":[\"none\",\"value\",\"name\",\"name_and_value\"],\"type\":\"string\"},\"grid_lines\":{\"description\":\"Which grid lines to display.\",\"enum\":[\"none\",\"horizontal\",\"vertical\",\"both\"],\"type\":\"string\"},\"group_style\":{\"description\":\"How grouped/stacked bars are displayed. \\\"normal\\\" stacks values, \\\"percent\\\" normalizes to 100%, \\\"side_by_side\\\" places bars next to each other.\",\"enum\":[\"normal\",\"percent\",\"side_by_side\"],\"type\":\"string\"},\"height\":{\"description\":\"Chart height.\",\"enum\":[\"small\",\"medium\",\"large\",\"extra_large\"],\"type\":\"string\"},\"hide_empty_groups\":{\"description\":\"Whether to hide groups with no data on the x-axis.\",\"type\":\"boolean\"},\"hide_line_fill_area\":{\"description\":\"Whether to hide the shaded area under the line (line charts only).\",\"type\":\"boolean\"},\"hide_title\":{\"description\":\"Whether to hide the title label (number charts only).\",\"type\":\"boolean\"},\"legend_position\":{\"description\":\"Legend display position. \\\"off\\\" hides the legend.\",\"enum\":[\"off\",\"bottom\",\"side\"],\"type\":\"string\"},\"reference_lines\":{\"description\":\"Reference lines drawn on the chart. Null when no reference lines are configured.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/chartReferenceLineResponse\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_data_labels\":{\"description\":\"Whether to show data value labels on chart elements.\",\"type\":\"boolean\"},\"smooth_line\":{\"description\":\"Whether to use smooth curves (line charts only).\",\"type\":\"boolean\"},\"sort\":{\"description\":\"Sort order for chart data.\",\"enum\":[\"manual\",\"x_ascending\",\"x_descending\",\"y_ascending\",\"y_descending\"],\"type\":\"string\"},\"stack_by\":{\"description\":\"Stack-by grouping configuration for stacked/grouped bar charts (column/bar/line only). Null when not stacked.\",\"oneOf\":[{\"$ref\":\"#/$defs/groupByConfigResponse\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"chart\",\"description\":\"The view configuration type.\",\"type\":\"string\"},\"value\":{\"$ref\":\"#/$defs/chartAggregationResponse\",\"description\":\"Aggregation configuration for number charts (single value display).\"},\"x_axis\":{\"description\":\"X-axis grouping configuration for column/bar/line/donut charts using grouped data. Null when using results (raw property values) mode.\",\"oneOf\":[{\"$ref\":\"#/$defs/groupByConfigResponse\"},{\"type\":\"null\"}]},\"x_axis_property_id\":{\"description\":\"Property ID for the x-axis name values when using results (raw property values) mode.\",\"type\":\"string\"},\"y_axis\":{\"description\":\"Y-axis aggregation for column/bar/line/donut charts using grouped data. Null when using results mode.\",\"oneOf\":[{\"$ref\":\"#/$defs/chartAggregationResponse\"},{\"type\":\"null\"}]},\"y_axis_max\":{\"description\":\"Custom maximum value for the y-axis. Null clears the override.\",\"oneOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"y_axis_min\":{\"description\":\"Custom minimum value for the y-axis. Null clears the override.\",\"oneOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"y_axis_property_id\":{\"description\":\"Property ID for the y-axis numeric values when using results (raw property values) mode.\",\"type\":\"string\"}},\"required\":[\"type\",\"chart_type\"],\"type\":\"object\"},\"checkboxGroupByConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"property_name\":{\"description\":\"Property name (convenience field).\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortResponse\",\"description\":\"Sort order for groups (only manual for checkbox).\"},\"type\":{\"const\":\"checkbox\",\"description\":\"The property type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"sort\"],\"type\":\"object\"},\"coverConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"property_id\":{\"description\":\"Property ID when type is \\\"property\\\".\",\"type\":\"string\"},\"type\":{\"description\":\"Source of the cover image.\",\"enum\":[\"page_cover\",\"page_content\",\"page_content_first\",\"property\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"dashboardRowResponse\":{\"additionalProperties\":false,\"properties\":{\"height\":{\"description\":\"Fixed height of the row in pixels.\",\"type\":\"integer\"},\"id\":{\"description\":\"The ID of this row module.\",\"type\":\"string\"},\"widgets\":{\"description\":\"The widget modules within this row.\",\"items\":{\"$ref\":\"#/$defs/dashboardWidgetResponse\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"id\",\"widgets\"],\"type\":\"object\"},\"dashboardViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"rows\":{\"description\":\"The rows that make up the dashboard layout. Each row contains one or more widget modules.\",\"items\":{\"$ref\":\"#/$defs/dashboardRowResponse\"},\"maxItems\":100,\"type\":\"array\"},\"type\":{\"const\":\"dashboard\",\"description\":\"The view configuration type.\",\"type\":\"string\"}},\"required\":[\"type\",\"rows\"],\"type\":\"object\"},\"dashboardWidgetResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"The ID of this widget module.\",\"type\":\"string\"},\"row_index\":{\"description\":\"The 0-based index of the row this widget belongs to. Widgets in the same row share the same row_index.\",\"type\":\"integer\"},\"view_id\":{\"description\":\"The ID of the collection view rendered by this widget.\",\"type\":\"string\"},\"width\":{\"description\":\"Width of the widget in a 12-column grid (1-12). 12 means full width.\",\"type\":\"integer\"}},\"required\":[\"id\",\"view_id\"],\"type\":\"object\"},\"dataSourceViewObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"configuration\":{\"description\":\"View presentation configuration.\",\"oneOf\":[{\"$ref\":\"#/$defs/viewConfigResponse\"},{\"type\":\"null\"}]},\"created_by\":{\"description\":\"The user who created the view, or null if not available.\",\"oneOf\":[{\"$ref\":\"#/$defs/partialUserObjectResponse\"},{\"type\":\"null\"}]},\"created_time\":{\"description\":\"The time when the view was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"dashboard_view_id\":{\"description\":\"For dashboard widget views, the ID of the parent dashboard view. Only present when this view is a widget inside a dashboard.\",\"type\":\"string\"},\"data_source_id\":{\"description\":\"The ID of the data source this view is scoped to, or null for dashboard views.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"filter\":{\"description\":\"The filter applied to this view (same shape as data source query filter).\",\"oneOf\":[{\"$ref\":\"#/$defs/viewFilterResponse\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the view.\"},\"last_edited_by\":{\"description\":\"The user who last edited the view, or null if not available.\",\"oneOf\":[{\"$ref\":\"#/$defs/partialUserObjectResponse\"},{\"type\":\"null\"}]},\"last_edited_time\":{\"description\":\"The time when the view was last edited.\",\"format\":\"date-time\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the view.\",\"type\":\"string\"},\"object\":{\"const\":\"view\",\"description\":\"The object type name.\",\"type\":\"string\"},\"parent\":{\"$ref\":\"#/$defs/databaseParentResponse\",\"description\":\"The parent database of the view.\"},\"quick_filters\":{\"description\":\"Quick filters pinned to the view's filter bar. Keys are property IDs. Values are filter conditions (same shape as a property filter without the property field). Null when no quick filters are set.\",\"oneOf\":[{\"additionalProperties\":{\"$ref\":\"#/$defs/quickFilterConditionResponse\"},\"type\":\"object\"},{\"type\":\"null\"}]},\"sorts\":{\"description\":\"The sorts applied to this view (same shape as data source query sorts).\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewSortResponse\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"type\":{\"description\":\"The view type.\",\"enum\":[\"table\",\"board\",\"list\",\"calendar\",\"timeline\",\"gallery\",\"form\",\"chart\",\"map\",\"dashboard\"],\"type\":\"string\"},\"url\":{\"description\":\"Canonical deep link to the view in Notion.\",\"type\":\"string\"}},\"required\":[\"object\",\"id\",\"parent\",\"name\",\"type\",\"created_time\",\"last_edited_time\",\"url\"],\"type\":\"object\"},\"databaseParentResponse\":{\"additionalProperties\":false,\"properties\":{\"database_id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the parent database.\"},\"type\":{\"const\":\"database_id\",\"description\":\"The parent type.\",\"type\":\"string\"}},\"required\":[\"type\",\"database_id\"],\"type\":\"object\"},\"dateGroupByConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"group_by\":{\"description\":\"Granularity for date grouping.\",\"enum\":[\"relative\",\"day\",\"week\",\"month\",\"year\"],\"type\":\"string\"},\"hide_empty_grou