rnal URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"externalPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"external\":{\"additionalProperties\":false,\"description\":\"The external URL for the icon.\",\"properties\":{\"url\":{\"description\":\"The URL of the external file or resource.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Type of icon. In this case, an external URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"filePageCoverResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the cover.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of cover. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"filePageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the icon.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of icon. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"iconPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"icon\":{\"$ref\":\"#/$defs/noticonIconResponse\",\"description\":\"The Notion native icon, specified by name and color.\"},\"type\":{\"const\":\"icon\",\"description\":\"Type of icon. In this case, a Notion native icon.\",\"type\":\"string\"}},\"required\":[\"type\",\"icon\"],\"title\":\"Icon\",\"type\":\"object\"},\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"},\"internalFileResponse\":{\"additionalProperties\":false,\"properties\":{\"expiry_time\":{\"description\":\"The time when the URL will expire.\",\"format\":\"date-time\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the file.\",\"type\":\"string\"}},\"required\":[\"url\",\"expiry_time\"],\"type\":\"object\"},\"linkMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"description\":\"The description of the link.\",\"type\":\"string\"},\"height\":{\"description\":\"The height of the link preview iframe.\",\"type\":\"integer\"},\"href\":{\"description\":\"The href of the link mention.\",\"type\":\"string\"},\"icon_url\":{\"description\":\"The icon URL of the link.\",\"type\":\"string\"},\"iframe_url\":{\"description\":\"The iframe URL of the link.\",\"type\":\"string\"},\"link_author\":{\"description\":\"The author of the link.\",\"type\":\"string\"},\"link_provider\":{\"description\":\"The provider of the link.\",\"type\":\"string\"},\"padding\":{\"description\":\"The padding of the link preview iframe.\",\"type\":\"integer\"},\"padding_top\":{\"description\":\"The top padding of the link preview iframe.\",\"type\":\"integer\"},\"thumbnail_url\":{\"description\":\"The thumbnail URL of the link.\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the link.\",\"type\":\"string\"}},\"required\":[\"href\"],\"type\":\"object\"},\"linkPreviewMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"The URL of the link preview mention.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"mentionRichTextItemResponse\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/userValueResponse\",\"description\":\"Details of the user mention.\"}},\"required\":[\"type\",\"user\"],\"title\":\"