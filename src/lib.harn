itionalProperties\":false,\"properties\":{\"frozen_column_index\":{\"description\":\"Index of the last frozen column. Columns up to and including this index are frozen.\",\"minimum\":0,\"type\":\"integer\"},\"group_by\":{\"$ref\":\"#/$defs/groupByConfigResponse\",\"description\":\"Vertical (row) grouping configuration.\"},\"properties\":{\"description\":\"Columns/properties visible in the table view.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"show_vertical_lines\":{\"description\":\"Whether to show vertical lines between columns.\",\"type\":\"boolean\"},\"subtasks\":{\"$ref\":\"#/$defs/subtaskConfigResponse\",\"description\":\"Sub-item (subtask) display configuration.\"},\"type\":{\"const\":\"table\",\"description\":\"The view configuration type.\",\"type\":\"string\"},\"wrap_cells\":{\"description\":\"Whether to wrap cell content by default.\",\"type\":\"boolean\"}},\"required\":[\"type\"],\"type\":\"object\"},\"textGroupByConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"group_by\":{\"description\":\"How to group text values. \\\"exact\\\" = exact match, \\\"alphabet_prefix\\\" = first letter.\",\"enum\":[\"exact\",\"alphabet_prefix\"],\"type\":\"string\"},\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"property_name\":{\"description\":\"Property name (convenience field).\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortResponse\",\"description\":\"Sort order for groups.\"},\"type\":{\"description\":\"The property type for grouping.\",\"enum\":[\"text\",\"title\",\"url\",\"email\",\"phone_number\"],\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"group_by\",\"sort\"],\"type\":\"object\"},\"timelineArrowsByResponse\":{\"additionalProperties\":false,\"properties\":{\"property_id\":{\"description\":\"Relation property ID used