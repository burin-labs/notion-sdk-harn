/** Exchange an authorization code for an access and refresh token */
pub fn create_a_token(
  harness: {clock: HarnessClock, net: HarnessNet},
  client: AdapterClient,
  body: any,
  notion_version: any = nil,
) -> CreateATokenResponse {
  const operation_auth = _security_create_a_token(client)
  const path_bindings = {}
  const path = _interpolate("/v1/oauth/token", path_bindings)
  const query_bindings = {...operation_auth.query}
  let url = _join_url(client.base_url, path)
  url = url + _query_string(query_bindings)
  let request_headers = operation_auth.headers
  if notion_version != nil {
    request_headers = {...request_headers, "Notion-Version": to_string(notion_version)}
  }
  const body_variant = if type_of(body) == "dict" {
    body.get("_variant")
  } else {
    nil
  }
  if body_variant == nil {
    throw "create_a_token: polymorphic request body must be built with one of: create_a_token_variant1, create_a_token_variant2"
  }
  if !["Variant1", "Variant2"].contains(body_variant) {
    throw "create_a_token: unknown request body variant " + to_string(body_variant)
  }
  const body_str = json_stringify(_strip_codegen_variant(body))
  const resp = connector_http_json(
    harness.clock,
    harness.net,
    "POST",
    url,
    {
      headers: request_headers,
      provider: "notion",
      operation: "create_a_token",
      retry: {max_attempts: 1},
      body: body_str,
    },
  )
  if !(resp.ok ?? false) {
    throw redact_response(resp)
  }
  const raw = resp.json
  if type_of(raw) != "dict" {
    throw "create_a_token: expected dict response, got " + type_of(raw)
  }
  return raw
}

/** Build a `Variant1` variant of the polymorphic request body. */
pub fn create_a_token_variant1(
  code: string,
  external_account: any = nil,
  redirect_uri: any = nil,
) -> dict {
  let body = {code: code, grant_type: "authorization_code", _variant: "Variant1"}
  if external_account != nil {
    body = {...body, external_account: external_account}
  }
  if redirect_uri != nil {
    body = {...body, redirect_uri: redirect_uri}
  }
  return body
}

/** Build a `Variant2` variant of the polymorphic request body. */
pub fn create_a_token_variant2(refresh_token: string) -> dict {
  return {grant_type: "refresh_token", refresh_token: refresh_token, _variant: "Variant2"}
}

