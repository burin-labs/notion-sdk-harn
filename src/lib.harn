  tools = tool_define(
    tools,
    "list_data_source_templates",
    "List templates in a data source",
    {
      parameters: json_parse(
        "{\"data_source_id\":{\"required\":true,\"schema\":{\"description\":\"ID of a Notion data source.\",\"type\":\"string\"}},\"name\":{\"required\":false,\"schema\":{\"description\":\"Filter templates by name (case-insensitive substring match).\",\"type\":\"string\"}},\"page_size\":{\"required\":false,\"schema\":{\"description\":\"The number of items from the full list desired in the response. Maximum: 100\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},\"start_cursor\":{\"required\":false,\"schema\":{\"description\":\"If supplied, this endpoint will return a page of results starting after the cursor provided. If not supplied, this endpoint will return the first page of results.\",\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"}},\"additionalProperties\":false,\"properties\":{\"has_more\":{\"description\":\"Whether there are more templates available beyond this page.\",\"type\":\"boolean\"},\"next_cursor\":{\"description\":\"Cursor to use for the next page of results. Null if there are no more results.\",\"oneOf\":[{\"$ref\":\"#/$defs/idResponse\"},{\"type\":\"null\"}]},\"templates\":{\"description\":\"Array of templates available in this data source.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"ID of the template page.\"},\"is_default\":{\"description\":\"Whether this template is the default template for the data source.\",\"type\":\"boolean\"},\"name\":{\"description\":\"Name of the template.\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"is_default\"],\"type\":\"object\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"templates\",\"has_more\",\"next_cursor\"],\"type\":\"object\"}",
      ),
      handler: { args ->
        const result = list_data_source_templates(
          harness,
          client,
          args.get("data_source_id"),
          args.get("name"),
          args.get("start_cursor"),
          args.get("page_size"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "List templates in a data source",
      annotations: json_parse(
        "{\"destructiveHint\":false,\"idempotentHint\":true,\"readOnlyHint\":true}",
      ),
      execution_policy: json_parse("{\"kind\":\"fetch\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"data_sources\",\"list_data_source_templates\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"GET\",\"path\":\"/v1/data_sources/{data_source_id}/templates\"},\"id\":\"list-data-source-templates\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
