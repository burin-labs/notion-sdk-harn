bject\"},\"dateResponse\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"description\":\"The end date of the date object, if any.\",\"oneOf\":[{\"format\":\"date\",\"type\":\"string\"},{\"type\":\"null\"}]},\"start\":{\"description\":\"The start date of the date object.\",\"format\":\"date\",\"type\":\"string\"},\"time_zone\":{\"description\":\"The time zone of the date object.\",\"oneOf\":[{\"$ref\":\"#/$defs/timeZoneRequest\"},{\"type\":\"null\"}]}},\"required\":[\"start\",\"end\",\"time_zone\"],\"type\":\"object\"},\"emojiPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"emoji\":{\"$ref\":\"#/$defs/emojiRequest\",\"description\":\"The emoji character used as the icon.\"},\"type\":{\"const\":\"emoji\",\"description\":\"Type of icon. In this case, an emoji.\",\"type\":\"string\"}},\"required\":[\"type\",\"emoji\"],\"title\":\"Emoji\",\"type\":\"object\"},\"emojiRequest\":{\"type\":\"string\"},\"emptyObject\":{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"},\"equationRichTextItemResponse\":{\"properties\":{\"equation\":{\"additionalProperties\":false,\"description\":\"Notion supports inline LaTeX equations as rich text objects with a type value of `equation`.\",\"properties\":{\"expression\":{\"description\":\"A KaTeX compatible string.\",\"examples\":[\"e=mc^2\"],\"type\":\"string\"}},\"required\":[\"expression\"],\"type\":\"object\"},\"type\":{\"const\":\"equation\",\"description\":\"Always `equation`\",\"type\":\"string\"}},\"required\":[\"type\",\"equation\"],\"title\":\"Equation\",\"type\":\"object\"},\"externalPageCoverResponse\":{\"additionalProperties\":false,\"properties\":{\"external\":{\"additionalProperties\":false,\"description\":\"The external URL for the cover.\",\"properties\":{\"url\":{\"description\":\"The URL of the external file or resource.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Type of cover. In this case, an external URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"externalPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"external\":{\"additionalProperties\":false,\"description\":\"The external URL for the icon.\",\"properties\":{\"url\":{\"description\":\"The URL of the external file or resource.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Type of icon. In this case, an external URL.\",\"type\":\"string\"}},\"required\":[\"type\",\"external\"],\"title\":\"External\",\"type\":\"object\"},\"filePageCoverResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the cover.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of cover. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"filePageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"file\":{\"$ref\":\"#/$defs/internalFileResponse\",\"description\":\"The file URL for the icon.\"},\"type\":{\"const\":\"file\",\"description\":\"Type of icon. In this case, a file.\",\"type\":\"string\"}},\"required\":[\"type\",\"file\"],\"title\":\"File\",\"type\":\"object\"},\"iconPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"icon\":{\"$ref\":\"#/$defs/noticonIconResponse\",\"description\":\"The Notion native icon, specified by name and color.\"},\"type\":{\"const\":\"icon\",\"description\":\"Type of icon. In this case, a Notion native icon.\",\"type\":\"string\"}},\"required\":[\"type\",\"icon\"],\"title\":\"Icon\",\"type\":\"object\"},\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"},\"internalFileResponse\":{\"additionalProperties\":false,\"properties\":{\"expiry_time\":{\"description\":\"The time when the URL will expire.\",\"format\":\"date-time\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the file.\",\"type\":\"string\"}},\"required\":[\"url\",\"expiry_time\"],\"type\":\"object\"},\"linkMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"description\":\"The description of the link.\",\"type\":\"string\"},\"height\":{\"description\":\"The height of the link preview iframe.\",\"type\":\"integer\"},\"href\":{\"description\":\"The href of the link mention.\",\"type\":\"string\"},\"icon_url\":{\"description\":\"The icon URL of the link.\",\"type\":\"string\"},\"iframe_url\":{\"description\":\"The iframe URL of the link.\",\"type\":\"string\"},\"link_author\":{\"description\":\"The author of the link.\",\"type\":\"string\"},\"link_provider\":{\"description\":\"The provider of the link.\",\"type\":\"string\"},\"padding\":{\"description\":\"The padding of the link preview iframe.\",\"type\":\"integer\"},\"padding_top\":{\"description\":\"The top padding of the link preview iframe.\",\"type\":\"integer\"},\"thumbnail_url\":{\"description\":\"The thumbnail URL of the link.\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the link.\",\"type\":\"string\"}},\"required\":[\"href\"],\"type\":\"object\"},\"linkPreviewMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"The URL of the link preview mention.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"mentionRichTextItemResponse\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/userValueResponse\",\"description\":\"Details of the user mention.\"}},\"required\":[\"type\",\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateResponse\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"type\",\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_preview\":{\"$ref\":\"#/$defs/linkPreviewMentionResponse\",\"description\":\"Details of the link preview mention.\"},\"type\":{\"const\":\"link_preview\",\"description\":\"Always `link_preview`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_preview\"],\"title\":\"Link Preview\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_mention\":{\"$ref\":\"#/$defs/linkMentionResponse\",\"description\":\"Details of the link mention.\"},\"type\":{\"const\":\"link_mention\",\"description\":\"Always `link_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_mention\"],\"title\":\"Link Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"page\":{\"additionalProperties\":false,\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"type\",\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"database\":{\"additionalProperties\":false,\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the database in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"database\",\"description\":\"Always `database`\",\"type\":\"string\"}},\"required\":[\"type\",\"database\"],\"title\":\"Database\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionResponse\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"custom_emoji\":{\"$ref\":\"#/$defs/customEmojiResponse\",\"description\":\"Details of the custom emoji mention.\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"type\",\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"}]},\"type\":{\"const\":\"mention\",\"description\":\"Always `mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"mention\"],\"title\":\"Mention\",\"type\":\"object\"},\"noticonColor\":{\"description\":\"One of: `gray`, `lightgray`, `brown`, `yellow`, `orange`, `green`, `blue`, `purple`, `pink`, `red`\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"noticonIconResponse\":{\"additionalProperties\":false,\"properties\":{\"color\":{\"$ref\":\"#/$defs/noticonColor\",\"description\":\"The color variant of the icon. Valid values: gray, lightgray, brown, yellow, orange, green, blue, purple, pink, red.\"},\"name\":{\"$ref\":\"#/$defs/noticonName\",\"description\":\"The name of the Notion icon (e.g. pizza, meeting, home). See the Notion icon picker for valid names.\"}},\"required\":[\"name\",\"color\"],\"type\":\"object\"},\"noticonName\":{\"examples\":[\"pizza\",\"meeting\",\"home\",\"star\",\"robot\"],\"type\":\"string\"},\"pageCoverResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/filePageCoverResponse\"},{\"$ref\":\"#/$defs/externalPageCoverResponse\"}]},\"pageIconResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/emojiPageIconResponse\"},{\"$ref\":\"#/$defs/filePageIconResponse\"},{\"$ref\":\"#/$defs/externalPageIconResponse\"},{\"$ref\":\"#/$defs/customEmojiPageIconResponse\"},{\"$ref\":\"#/$defs/iconPageIconResponse\"}]},\"pageIdParentForBlockBasedObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"page_id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the parent page.\"},\"type\":{\"const\":\"page_id\",\"description\":\"The parent type.\",\"type\":\"string\"}},\"required\":[\"type\",\"page_id\"],\"type\":\"object\"},\"parentOfDatabaseResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/pageIdParentForBlockBasedObjectResponse\"},{\"$ref\":\"#/$defs/workspaceParentForBlockBasedObjectResponse\"},{\"$ref\":\"#/$defs/databaseParentResponse\"},{\"$ref\":\"#/$defs/blockIdParentForBlockBasedObjectResponse\"}]},\"partialDatabaseObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the database.\"},\"object\":{\"const\":\"database\",\"description\":\"The database object type name.\",\"type\":\"string\"}},\"required\":[\"object\",\"id\"],\"type\":\"object\"},\"partialUserObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\"},\"object\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"}},\"required\":[\"id\",\"object\"],\"type\":\"object\"},\"personUserObjectResponse\":{\"properties\":{\"person\":{\"additionalProperties\":false,\"description\":\"Details about the person, when the `type` of the user is `person`.\",\"properties\":{\"email\":{\"description\":\"The email of the person.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"const\":\"person\",\"description\":\"Indicates this user is a person.\",\"type\":\"string\"}},\"required\":[\"type\",\"person\"],\"title\":\"Person\",\"type\":\"object\"},\"richTextItemResponse\":{\"allOf\":[{\"$ref\":\"#/$defs/richTextItemResponseCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/textRichTextItemResponse\"},{\"$ref\":\"#/$defs/mentionRichTextItemResponse\"},{\"$ref\":\"#/$defs/equationRichTextItemResponse\"}]}]},\"richTextItemResponseCommon\":{\"additionalProperties\":false,\"properties\":{\"annotations\":{\"$ref\":\"#/$defs/annotationResponse\",\"description\":\"All rich text objects contain an annotations object that sets the styling for the rich text.\"},\"href\":{\"description\":\"A URL that the rich text object links to or mentions.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"plain_text\":{\"description\":\"The plain text content of the rich text object, without any styling.\",\"type\":\"string\"}},\"required\":[\"plain_text\",\"href\",\"annotations\"],\"type\":\"object\"},\"templateMentionDateTemplateMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"template_mention_date\":{\"description\":\"The date of the template mention.\",\"enum\":[\"today\",\"now\"],\"type\":\"string\"},\"type\":{\"const\":\"template_mention_date\",\"description\":\"Always `template_mention_date`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention_date\"],\"title\":\"Template Mention Date\",\"type\":\"object\"},\"templateMentionResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/templateMentionDateTemplateMentionResponse\"},{\"$ref\":\"#/$defs/templateMentionUserTemplateMentionResponse\"}]},\"templateMentionUserTemplateMentionResponse\":{\"additionalProperties\":false,\"properties\":{\"template_mention_user\":{\"const\":\"me\",\"description\":\"The user of the template mention.\",\"type\":\"string\"},\"type\":{\"const\":\"template_mention_user\",\"description\":\"Always `template_mention_user`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention_user\"],\"title\":\"Template Mention User\",\"type\":\"object\"},\"textRichTextItemResponse\":{\"properties\":{\"text\":{\"additionalProperties\":false,\"description\":\"If a rich text object's type value is `text`, then the corresponding text field contains an object including the text content and any inline link.\",\"properties\":{\"content\":{\"description\":\"The actual text content of the text.\",\"maxLength\":2000,\"type\":\"string\"},\"link\":{\"description\":\"An object with information about any inline link in this text, if included.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"The URL of the link.\",\"examples\":[\"https://www.notion.com\"],\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},{\"type\":\"null\"}]}},\"required\":[\"content\",\"link\"],\"type\":\"object\"},\"type\":{\"const\":\"text\",\"description\":\"Always `text`\",\"type\":\"string\"}},\"required\":[\"type\",\"text\"],\"title\":\"Text\",\"type\":\"object\"},\"timeZoneRequest\":{\"type\":\"string\"},\"userObjectResponse\":{\"allOf\":[{\"$ref\":\"#/$defs/userObjectResponseCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/personUserObjectResponse\"},{\"$ref\":\"#/$defs/botUserObjectResponse\"}]}]},\"userObjectResponseCommon\":{\"additionalProperties\":false,\"properties\":{\"avatar_url\":{\"description\":\"The avatar URL of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the user.\"},\"name\":{\"description\":\"The name of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"}},\"required\":[\"id\",\"object\",\"name\",\"avatar_url\"],\"type\":\"object\"},\"userValueResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/partialUserObjectResponse\"},{\"$ref\":\"#/$defs/userObjectResponse\"}]},\"workspaceParentForBlockBasedObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"workspace\",\"description\":\"The parent type.\",\"type\":\"string\"},\"workspace\":{\"const\":true,\"description\":\"Always true for workspace parent.\",\"type\":\"boolean\"}},\"required\":[\"type\",\"workspace\"],\"type\":\"object\"}},\"oneOf\":[{\"$ref\":\"#/$defs/partialDatabaseObjectResponse\"},{\"$ref\":\"#/$defs/databaseObjectResponse\"}]}",
      ),
      handler: { args ->
        const result = update_database(
          harness,
          client,
          args.get("database_id"),
          args.get("body"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "Update a database",
      annotations: json_parse("{\"idempotentHint\":false,\"readOnlyHint\":false}"),
      execution_policy: json_parse("{\"kind\":\"execute\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"databases\",\"update_database\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"PATCH\",\"path\":\"/v1/databases/{database_id}\"},\"id\":\"update-database\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
  tools = tool_define(
    tools,
    "list_file_uploads",
    "List file uploads",
    {
      parameters: json_parse(
        "{\"page_size\":{\"required\":false,\"schema\":{\"description\":\"The number of items from the full list desired in the response. Maximum: 100\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},\"start_cursor\":{\"required\":false,\"schema\":{\"description\":\"If supplied, this endpoint will return a page of results starting after the cursor provided. If not supplied, this endpoint will return the first page of results.\",\"type\":\"string\"}},\"status\":{\"required\":false,\"schema\":{\"description\":\"If supplied, the endpoint will return file uploads with the specified status.\",\"enum\":[\"pending\",\"uploaded\",\"expired\",\"failed\"],\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"emptyObject\":{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"},\"fileUploadObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"complete_url\":{\"type\":\"string\"},\"content_length\":{\"oneOf\":[{\"minimum\":0,\"type\":\"integer\"},{\"type\":\"null\"}]},\"content_type\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"created_by\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\"},\"type\":{\"description\":\"One of: `person`, `bot`, `agent`\",\"enum\":[\"person\",\"bot\",\"agent\"],\"type\":\"string\"}},\"required\":[\"id\",\"type\"],\"type\":\"object\"},\"created_time\":{\"format\":\"date-time\",\"type\":\"string\"},\"expiry_time\":{\"oneOf\":[{\"format\":\"date-time\",\"type\":\"string\"},{\"type\":\"null\"}]},\"file_import_result\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"imported_time\":{\"description\":\"The time the file was imported into Notion. ISO 8601 format.\",\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"imported_time\"],\"type\":\"object\"},{\"oneOf\":[{\"properties\":{\"success\":{\"$ref\":\"#/$defs/emptyObject\",\"description\":\"Empty object for success type.\"},\"type\":{\"const\":\"success\",\"description\":\"Indicates a successful import.\",\"type\":\"string\"}},\"required\":[\"type\",\"success\"],\"title\":\"Success\",\"type\":\"object\"},{\"properties\":{\"error\":{\"additionalProperties\":false,\"description\":\"Details about the error that occurred during file import.\",\"properties\":{\"code\":{\"description\":\"A short string code representing the error.\",\"type\":\"string\"},\"message\":{\"description\":\"A human-readable message describing the error.\",\"type\":\"string\"},\"parameter\":{\"description\":\"The parameter related to the error, if applicable. Null if not applicable.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"status_code\":{\"description\":\"The HTTP status code associated with the error, if available. Null if not applicable.\",\"oneOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"type\":{\"description\":\"The type of error that occurred during file import.\",\"enum\":[\"validation_error\",\"internal_system_error\",\"download_error\",\"upload_error\"],\"type\":\"string\"}},\"required\":[\"type\",\"code\",\"message\",\"parameter\",\"status_code\"],\"type\":\"object\"},\"type\":{\"const\":\"error\",\"description\":\"Indicates an error occurred during import.\",\"type\":\"string\"}},\"required\":[\"type\",\"error\"],\"title\":\"Error\",\"type\":\"object\"}]}]},\"filename\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\"},\"in_trash\":{\"type\":\"boolean\"},\"last_edited_time\":{\"format\":\"date-time\",\"type\":\"string\"},\"number_of_parts\":{\"additionalProperties\":false,\"properties\":{\"sent\":{\"minimum\":0,\"type\":\"integer\"},\"total\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"total\",\"sent\"],\"type\":\"object\"},\"object\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"},\"status\":{\"description\":\"One of: `pending`, `uploaded`, `expired`, `failed`\",\"enum\":[\"pending\",\"uploaded\",\"expired\",\"failed\"],\"type\":\"string\"},\"upload_url\":{\"type\":\"string\"}},\"required\":[\"object\",\"id\",\"created_time\",\"created_by\",\"last_edited_time\",\"in_trash\",\"expiry_time\",\"status\",\"filename\",\"content_type\",\"content_length\"],\"type\":\"object\"},\"idResponse\":{\"format\":\"uuid\",\"type\":\"string\"}},\"additionalProperties\":false,\"properties\":{\"file_upload\":{\"$ref\":\"#/$defs/emptyObject\"},\"has_more\":{\"type\":\"boolean\"},\"next_cursor\":{\"oneOf\":[{\"$ref\":\"#/$defs/idResponse\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"list\",\"description\":\"Always `list`\",\"type\":\"string\"},\"results\":{\"items\":{\"$ref\":\"#/$defs/fileUploadObjectResponse\"},\"type\":\"array\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"object\",\"next_cursor\",\"has_more\",\"results\",\"type\",\"file_upload\"],\"type\":\"object\"}",
      ),
      handler: { args ->
        const result = list_file_uploads(
          harness,
          client,
          args.get("status"),
          args.get("start_cursor"),
          args.get("page_size"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "List file uploads",
      annotations: json_parse(
        "{\"destructiveHint\":false,\"idempotentHint\":true,\"readOnlyHint\":true}",
      ),
      execution_policy: json_parse("{\"kind\":\"fetch\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"file_uploads\",\"list_file_uploads\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"GET\",\"path\":\"/v1/file_uploads\"},\"id\":\"list-file-uploads\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
  tools = tool_define(
    tools,
    "create_file",
    "Create a file upload",
    {
      parameters: json_parse(
        "{\"body\":{\"required\":true,\"schema\":{\"properties\":{\"content_type\":{\"description\":\"MIME type of the file to be created. Recommended when sending the file in multiple parts. Must match the content type of the file that's sent, and the extension of the `filename` parameter if any.\",\"examples\":[\"application/pdf\"],\"type\":\"string\"},\"external_url\":{\"description\":\"When `mode` is `external_url`, provide the HTTPS URL of a publicly accessible file to import into your workspace.\",\"type\":\"string\"},\"filename\":{\"description\":\"Name of the file to be created. Required when `mode` is `multi_part`. Otherwise optional, and used to override the filename. Must include an extension, or have one inferred from the `content_type` parameter.\",\"examples\":[\"business_summary.pdf\"],\"type\":\"string\"},\"mode\":{\"description\":\"How the file is being sent. Use `multi_part` for files larger than 20MB. Use `external_url` for files that are temporarily hosted publicly elsewhere. Default is `single_part`.\",\"enum\":[\"single_part\",\"multi_part\",\"external_url\"],\"type\":\"string\"},\"number_of_parts\":{\"description\":\"When `mode` is `multi_part`, the number of parts you are uploading. This must match the number of parts as well as the final `part_number` you send.\",\"maximum\":10000,\"minimum\":1,\"type\":\"integer\"}},\"type\":\"object\"}}}",
      ),
