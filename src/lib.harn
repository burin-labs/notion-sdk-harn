  tools = tool_define(
    tools,
    "retrieve_database",
    "Retrieve a database",
    {
      parameters: json_parse(
        "{\"database_id\":{\"required\":true,\"schema\":{\"description\":\"ID of a Notion database, a container for one or more data sources.\",\"type\":\"string\"}}}",
      ),
