tion\":\"The actual text content of the text.\",\"maxLength\":2000,\"type\":\"string\"},\"link\":{\"description\":\"An object with information about any inline link in this text, if included.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"The URL of the link.\",\"examples\":[\"https://www.notion.com\"],\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},{\"type\":\"null\"}]}},\"required\":[\"content\",\"link\"],\"type\":\"object\"},\"type\":{\"const\":\"text\",\"description\":\"Always `text`\",\"type\":\"string\"}},\"required\":[\"type\",\"text\"],\"title\":\"Text\",\"type\":\"object\"},\"timeZoneRequest\":{\"type\":\"string\"},\"userObjectResponse\":{\"allOf\":[{\"$ref\":\"#/$defs/userObjectResponseCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/personUserObjectResponse\"},{\"$ref\":\"#/$defs/botUserObjectResponse\"}]}]},\"userObjectResponseCommon\":{\"additionalProperties\":false,\"properties\":{\"avatar_url\":{\"description\":\"The avatar URL of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the user.\"},\"name\":{\"description\":\"The name of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"}},\"required\":[\"id\",\"object\",\"name\",\"avatar_url\"],\"type\":\"object\"},\"userValueResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/partialUserObjectResponse\"},{\"$ref\":\"#/$defs/userObjectResponse\"}]},\"workspaceParentForBlockBasedObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"workspace\",\"description\":\"The parent type.\",\"type\":\"string\"},\"workspace\":{\"const\":true,\"description\":\"Always true for workspace parent.\",\"type\":\"boolean\"}},\"required\":[\"type\",\"workspace\"],\"type\":\"object\"}},\"oneOf\":[{\"$ref\":\"#/$defs/partialDatabaseObjectResponse\"},{\"$ref\":\"#/$defs/databaseObjectResponse\"}]}",
      ),
      handler: { args ->
        const result = retrieve_database(
          harness,
          client,
          args.get("database_id"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "Retrieve a database",
      annotations: json_parse(
        "{\"destructiveHint\":false,\"idempotentHint\":true,\"readOnlyHint\":true}",
      ),
      execution_policy: json_parse("{\"kind\":\"fetch\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
        "{\"audiences\":[\"cli\",\"mcp\",\"catalog\",\"dashboard\",\"agent\"]}",
      ),
      cli: json_parse("{\"command\":[\"databases\",\"retrieve_database\"]}"),
      source: json_parse(
        "{\"binding\":{\"method\":\"GET\",\"path\":\"/v1/databases/{database_id}\"},\"id\":\"retrieve-database\",\"kind\":\"openapi\"}",
      ),
      defer_loading: false,
      meta: json_parse("{}"),
    },
  )
  tools = tool_define(
    tools,
    "update_database",
    "Update a database",
    {
      parameters: json_parse(
        "{\"body\":{\"required\":true,\"schema\":{\"$defs\":{\"annotationRequest\":{\"properties\":{\"bold\":{\"description\":\"Whether the text is formatted as bold.\",\"type\":\"boolean\"},\"code\":{\"description\":\"Whether the text is formatted as code.\",\"type\":\"boolean\"},\"color\":{\"$ref\":\"#/$defs/apiColor\",\"description\":\"The color of the text.\"},\"italic\":{\"description\":\"Whether the text is formatted as italic.\",\"type\":\"boolean\"},\"strikethrough\":{\"description\":\"Whether the text is formatted with a strikethrough.\",\"type\":\"boolean\"},\"underline\":{\"description\":\"Whether the text is formatted with an underline.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apiColor\":{\"description\":\"One of: `default`, `gray`, `brown`, `orange`, `yellow`, `green`, `blue`, `purple`, `pink`, `red`, `default_background`, `gray_background`, `brown_background`, `orange_background`, `yellow_background`, `green_background`, `blue_background`, `purple_background`, `pink_background`, `red_background`\",\"enum\":[\"default\",\"gray\",\"brown\",\"orange\",\"yellow\",\"green\",\"blue\",\"purple\",\"pink\",\"red\",\"default_background\",\"gray_background\",\"brown_background\",\"orange_background\",\"yellow_background\",\"green_background\",\"blue_background\",\"purple_background\",\"pink_background\",\"red_background\"],\"type\":\"string\"},\"customEmojiPageIconRequest\":{\"properties\":{\"custom_emoji\":{\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the custom emoji.\"},\"name\":{\"description\":\"The name of the custom emoji.\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the custom emoji.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"},\"dateRequest\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"description\":\"The end date of the date object, if any.\",\"oneOf\":[{\"format\":\"date\",\"type\":\"string\"},{\"type\":\"null\"}]},\"start\":{\"description\":\"The start date of the date object.\",\"format\":\"date\",\"type\":\"string\"},\"time_zone\":{\"description\":\"The time zone of the date object, if any. E.g. America/Los_Angeles, Europe/London, etc.\",\"oneOf\":[{\"$ref\":\"#/$defs/timeZoneRequest\"},{\"type\":\"null\"}]}},\"required\":[\"start\"],\"type\":\"object\"},\"emojiPageIconRequest\":{\"properties\":{\"emoji\":{\"$ref\":\"#/$defs/emojiRequest\",\"description\":\"An emoji character.\"},\"type\":{\"const\":\"emoji\",\"description\":\"Always `emoji`\",\"type\":\"string\"}},\"required\":[\"emoji\"],\"title\":\"Emoji\",\"type\":\"object\"},\"emojiRequest\":{\"type\":\"string\"},\"equationRichTextItemRequest\":{\"properties\":{\"equation\":{\"description\":\"Notion supports inline LaTeX equations as rich text objects with a type value of `equation`.\",\"properties\":{\"expression\":{\"description\":\"A KaTeX compatible string.\",\"examples\":[\"e=mc^2\"],\"type\":\"string\"}},\"required\":[\"expression\"],\"type\":\"object\"},\"type\":{\"const\":\"equation\",\"description\":\"Always `equation`\",\"type\":\"string\"}},\"required\":[\"equation\"],\"title\":\"Equation\",\"type\":\"object\"},\"externalPageCoverRequest\":{\"properties\":{\"external\":{\"description\":\"External URL for the cover.\",\"properties\":{\"url\":{\"description\":\"The URL of the external file.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Always `external`\",\"type\":\"string\"}},\"required\":[\"external\"],\"title\":\"External\",\"type\":\"object\"},\"externalPageIconRequest\":{\"properties\":{\"external\":{\"properties\":{\"url\":{\"description\":\"The URL of the external file.\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},\"type\":{\"const\":\"external\",\"description\":\"Always `external`\",\"type\":\"string\"}},\"required\":[\"external\"],\"title\":\"External\",\"type\":\"object\"},\"fileUploadPageCoverRequest\":{\"properties\":{\"file_upload\":{\"description\":\"The file upload for the cover.\",\"properties\":{\"id\":{\"description\":\"ID of a FileUpload object that has the status `uploaded`.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"file_upload\"],\"title\":\"File Upload\",\"type\":\"object\"},\"fileUploadPageIconRequest\":{\"properties\":{\"file_upload\":{\"properties\":{\"id\":{\"description\":\"ID of a FileUpload object that has the status `uploaded`.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"file_upload\"],\"title\":\"File Upload\",\"type\":\"object\"},\"iconPageIconRequest\":{\"properties\":{\"icon\":{\"description\":\"A Notion native icon, specified by name and optional color.\",\"properties\":{\"color\":{\"$ref\":\"#/$defs/noticonColor\",\"description\":\"The color variant of the icon. Defaults to gray if not specified. Valid values: gray, lightgray, brown, yellow, orange, green, blue, purple, pink, red.\"},\"name\":{\"$ref\":\"#/$defs/noticonName\",\"description\":\"The name of the Notion icon (e.g. pizza, meeting, home). See the Notion icon picker for valid names.\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":{\"const\":\"icon\",\"description\":\"Always `icon`\",\"type\":\"string\"}},\"required\":[\"icon\"],\"title\":\"Icon\",\"type\":\"object\"},\"idRequest\":{\"type\":\"string\"},\"mentionRichTextItemRequest\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/partialUserObjectRequest\",\"description\":\"Details of the user mention.\"}},\"required\":[\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateRequest\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"properties\":{\"page\":{\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"properties\":{\"database\":{\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the database in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"database\",\"description\":\"Always `database`\",\"type\":\"string\"}},\"required\":[\"database\"],\"title\":\"Database\",\"type\":\"object\"},{\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionRequest\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"properties\":{\"custom_emoji\":{\"description\":\"Details of the custom emoji mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the custom emoji.\"},\"name\":{\"description\":\"The name of the custom emoji.\",\"type\":\"string\"},\"url\":{\"description\