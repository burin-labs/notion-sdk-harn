lateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_date\":{\"description\":\"The date of the template mention.\",\"enum\":[\"today\",\"now\"],\"type\":\"string\"},\"type\":{\"const\":\"template_mention_date\",\"description\":\"Always `template_mention_date`\",\"type\":\"string\"}},\"required\":[\"template_mention_date\"],\"title\":\"Template Mention Date\",\"type\":\"object\"},\"templateMentionRequest\":{\"oneOf\":[{\"$ref\":\"#/$defs/templateMentionDateTemplateMentionRequest\"},{\"$ref\":\"#/$defs/templateMentionUserTemplateMentionRequest\"}]},\"templateMentionUserTemplateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_user\":{\"const\":\"me\",\"description\":\"The user of the template mention.\",\"type\":\"string\"},\"type\":{\"const\":\"template_mention_user\",\"description\":\"Always `template_mention_user`\",\"type\":\"string\"}},\"required\":[\"template_mention_user\"],\"title\":\"Template Mention User\",\"type\":\"object\"},\"textRichTextItemRequest\":{\"properties\":{\"text\":{\"additionalProperties\":false,\"description\":\"If a rich text object's type value is `text`, then the corresponding text field contains an object including the text content and any inline link.\",\"properties\":{\"content\":{\"description\":\"The actual text content of the text.\",\"maxLength\":2000,\"type\":\"string\"},\"link\":{\"description\":\"An object with information about any inline link in this text, if included.\",\"oneOf\":[{\"properties\":{\"url\":{\"description\":\"The URL of the link.\",\"examples\":[\"https://www.notion.com\"],\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},{\"type\":\"null\"}]}},\"required\":[\"content\"],\"type\":\"object\"},\"type\":{\"const\":\"text\",\"description\":\"Always `text`\",\"type\":\"string\"}},\"required\":[\"text\"],\"title\":\"Text\",\"type\":\"object\"},\"timeZoneRequest\":{\"type\":\"string\"}},\"properties\":{\"cover\":{\"$ref\":\"#/$defs/pa