/** Return the versioned static catalog projected from `adapter_tools`. */
pub fn adapter_catalog(
  harness: {clock: HarnessClock, net: HarnessNet},
  client: AdapterClient,
) -> ToolCatalog {
  return tool_schema(adapter_tools(harness, client))
}

/** Create a new NotionClient handle. */
pub fn new_client(
  base_url: string = "https://api.notion.com",
  credentials: dict<string, AdapterCredential> = {},
  extra_headers: AdapterHeaders = {"Notion-Version": "2022-06-28"},
) -> AdapterClient {
  return {base_url: base_url, credentials: credentials, extra_headers: extra_headers}
}

/** Read the generated portable environment projection. */
pub fn adapter_environment_config(env: HarnessEnv) -> AdapterRuntimeConfig {
  let credentials: dict<string, AdapterCredential> = {}
  const credential_basic_auth_username = env.get("HARN_NOTION_BASICAUTH_USERNAME")
  const credential_basic_auth_password = env.get("HARN_NOTION_BASICAUTH_PASSWORD")
  if credential_basic_auth_username != nil && credential_basic_auth_username != ""
    && credential_basic_auth_password != nil
    && credential_basic_auth_password != "" {
    credentials = {
      ...credentials,
      basicAuth: {
        username: credential_basic_auth_username,
        password: credential_basic_auth_password,
      },
    }
  }
  const credential_bearer_auth_token = env.get("HARN_NOTION_BEARERAUTH_TOKEN")
  if credential_bearer_auth_token != nil && credential_bearer_auth_token != "" {
    credentials = {...credentials, bearerAuth: {token: credential_bearer_auth_token}}
  }
  const configured_base_url = env.get("HARN_NOTION_BASE_URL")
  const base_url = if configured_base_url != nil && configured_base_url != "" {
    configured_base_url
  } else {
    "https://api.notion.com"
  }
  return {base_url: base_url, credentials: credentials, extra_headers: {}}
}

/** Construct the one registry projected by CLI, MCP, and static schema commands. */
pub fn adapter_registry(
  harness: {clock: HarnessClock, net: HarnessNet},
  config: AdapterRuntimeConfig,
) -> ToolRegistry {
  const client = new_client(config.base_url, config.credentials, config.extra_headers)
  return adapter_tools(pick(harness, ["clock", "net"]), client)
}

/** Validate runtime configuration before publishing any generated tool. */
pub fn validate_client(client: AdapterClient) -> nil {
  if client.base_url.trim() == "" {
    throw "harn-openapi.generated: base URL configuration is required"
  }
  _validate_retrieve_a_block_client(client)
  _validate_delete_a_block_client(client)
  _validate_update_a_block_client(client)
