        "{\"$defs\":{\"annotationResponse\":{\"additionalProperties\":false,\"properties\":{\"bold\":{\"type\":\"boolean\"},\"code\":{\"type\":\"boolean\"},\"color\":{\"$ref\":\"#/$defs/apiColor\"},\"italic\":{\"type\":\"boolean\"},\"strikethrough\":{\"type\":\"boolean\"},\"underline\":{\"type\":\"boolean\"}},\"required\":[\"bold\",\"italic\",\"strikethrough\",\"underline\",\"code\",\"color\"],\"type\":\"object\"},\"apiColor\":{\"description\":\"One of: `default`, `gray`, `brown`, `orange`, `yellow`, `green`, `blue`, `purple`, `pink`, `red`, `default_background`, `gray_background`, `brown_background`, `orange_background`, `yellow_background`, `green_background`, `blue_background`, `purple_background`, `pink_background`, `red_background`\",\"enum\":[\"default\",\"gray\",\"brown\",\"orange\",\"yellow\",\"green\",\"blue\",\"purple\",\"pink\",\"red\",\"default_background\",\"gray_background\",\"brown_background\",\"orange_background\",\"yellow_background\",\"green_background\",\"blue_background\",\"purple_background\",\"pink_background\",\"red_background\"],\"type\":\"string\"},\"blockIdCommentParentResponse\":{\"additionalProperties\":false,\"properties\":{\"block_id\":{\"$ref\":\"#/$defs/idResponse\"},\"type\":{\"const\":\"block_id\",\"description\":\"Always `block_id`\",\"type\":\"string\"}},\"required\":[\"type\",\"block_id\"],\"title\":\"Block Id\",\"type\":\"object\"},\"botInfoResponse\":{\"additionalProperties\":false,\"properties\":{\"owner\":{\"description\":\"Details about the owner of the bot.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"description\":\"Details about the owner of the bot, when the `type` of the owner is `user`. This means the bot is for a integration.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"avatar_url\":{\"description\":\"The avatar URL of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"id