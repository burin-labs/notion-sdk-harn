scription\":\"Start day of week for week grouping (0 = Sunday, 1 = Monday).\",\"enum\":[0,1],\"type\":\"number\"},\"type\":{\"description\":\"The property type for grouping.\",\"enum\":[\"date\",\"created_time\",\"last_edited_time\"],\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"group_by\",\"sort\"],\"type\":\"object\"},\"formViewConfigRequest\":{\"properties\":{\"anonymous_submissions\":{\"description\":\"Whether anonymous (non-logged-in) submissions are allowed. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"is_form_closed\":{\"description\":\"Whether the form is closed for submissions. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"submission_permissions\":{\"description\":\"Permission level granted to the submitter on the created page after form submission. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `none`, `comment_only`, `reader`, `read_and_write`, `editor`\",\"enum\":[\"none\",\"comment_only\",\"reader\",\"read_and_write\",\"editor\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"form\",\"description\":\"The view type. Must be \\\"form\\\".\",\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"formulaCheckboxSubGroupByRequest\":{\"properties\":{\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"checkbox\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"sort\"],\"type\":\"object\"},\"formulaDateSubGroupByRequest\":{\"properties\":{\"group_by\":{\"description\":\"Granularity for date grouping.\",\"enum\":[\"relative\",\"day\",\"week\",\"month\",\"year\"],\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"start_day_of_week\":{\"description\":\"Start day of week for week grouping (0 = Sunday, 1 = Monday).\",\"enum\":[0,1],\"type\":\"number\"},\"type\":{\"const\":\"date\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"group_by\",\"sort\"],\"type\":\"object\"},\"formulaGroupByConfigRequest\":{\"properties\":{\"group_by\":{\"description\":\"Sub-group-by configuration based on the formula result type.\",\"oneOf\":[{\"$ref\":\"#/$defs/formulaDateSubGroupByRequest\"},{\"$ref\":\"#/$defs/formulaTextSubGroupByRequest\"},{\"$ref\":\"#/$defs/formulaNumberSubGroupByRequest\"},{\"$ref\":\"#/$defs/formulaCheckboxSubGroupByRequest\"}]},\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID of the formula to group by.\",\"type\":\"string\"},\"type\":{\"const\":\"formula\",\"description\":\"The property type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"group_by\"],\"type\":\"object\"},\"formulaNumberSubGroupByRequest\":{\"properties\":{\"range_end\":{\"description\":\"End of the range for number grouping buckets.\",\"type\":\"integer\"},\"range_size\":{\"description\":\"Size of each bucket in number grouping.\",\"minimum\":1,\"type\":\"integer\"},\"range_start\":{\"description\":\"Start of the range for number grouping buckets.\",\"type\":\"integer\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"number\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"sort\"],\"type\":\"object\"},\"formulaTextSubGroupByRequest\":{\"properties\":{\"group_by\":{\"description\":\"How to group text values. \\\"exact\\\" = exact match, \\\"alphabet_prefix\\\" = first letter.\",\"enum\":[\"exact\",\"alphabet_prefix\"],\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"text\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},