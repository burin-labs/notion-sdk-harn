,\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionResponse\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"custom_emoji\":{\"$ref\":\"#/$defs/customEmojiResponse\",\"description\":\"Details of the custom emoji mention.\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"type\",\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"}]},\"type\":{\"const\":\"mention\",\"description\":\"Always `mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"mention\"],\"title\":\"Mention\",\"type\":\"object\"},\"noticonColor\":{\"description\":\"One of: `gray`, `lightgray`, `brown`, `yellow`, `orange`, `green`, `blue`, `purple`, `pink`, `red`\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"noticonIconResponse\":{\"additionalProperties\":false,\"properties\":{\"color\":{\"$ref\":\"#/$defs/noticonColor\",\"description\":\"The color variant of the icon. Valid values: gray, lightgray, brown, yellow, orange, green, blue, purple, pink, red.\"},\"name\":{\"$ref\":\"#/$defs/noticonName\",\"description\":\"The name of the Notion icon (e.g. pizza, meeting, home). See the Notion icon picker for valid names.\"}},\"required\":[\"name\",\"color\"],\"type\":\"object\"},\"noticonName\":{\"examples\":[\"pizza\",\"meeting\",\"home\",\"star\",\"robot\"],\"type\":\"string\"},\"pageCoverResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/filePageCoverResponse\"},{\"$ref\":\"#/$defs/externalPageCoverResponse\"}]},\"pageIconResponse\":{\"oneOf\":[{\"$ref\":\"#/$defs/emojiPageIconResponse\"},{\"$ref\":\"#/$defs/filePageIconResponse\"},{\"$ref\":\"#/$defs/externa