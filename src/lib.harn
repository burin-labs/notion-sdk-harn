ls about the bot, when the `type` of the user is `bot`.\",\"oneOf\":[{\"$ref\":\"#/$defs/emptyObject\"},{\"$ref\":\"#/$defs/botInfoResponse\"}]},\"type\":{\"const\":\"bot\",\"description\":\"Indicates this user is a bot.\",\"type\":\"string\"}},\"required\":[\"type\",\"bot\"],\"title\":\"Bot\",\"type\":\"object\"},\"commentObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"attachments\":{\"description\":\"Any file attachments associated with the comment.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"category\":{\"description\":\"One of: `audio`, `image`, `pdf`, `productivity`, `video`\",\"enum\":[\"audio\",\"image\",\"pdf\",\"productivity\",\"video\"],\"type\":\"string\"},\"file\":{\"$ref\":\"#/$defs/internalFileResponse\"}},\"required\":[\"category\",\"file\"],\"type\":\"object\"},\"maxItems\":100,\"type\":\"array\"},\"created_by\":{\"$ref\":\"#/$defs/partialUserObjectResponse\",\"description\":\"The user who created the comment.\"},\"created_time\":{\"description\":\"The time when the comment was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"discussion_id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the discussion thread this comment belongs to.\"},\"display_name\":{\"additionalProperties\":false,\"description\":\"The display name of the comment.\",\"properties\":{\"resolved_name\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"type\":{\"description\":\"One of: `custom`, `user`, `integration`\",\"enum\":[\"custom\",\"user\",\"integration\"],\"type\":\"string\"}},\"required\":[\"type\",\"resolved_name\"],\"type\":\"object\"},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the comment.\"},\"last_edited_time\":{\"description\":\"The time when the comment was last edited.\",\"format\":\"date-time\",\"type\":\"string\"},\"object\":{\"const\":\"comment\",\"description\":\"The comment object type name.\",\"type\":\"string\"},\"parent\":{\"$ref\":\"#/$defs/commentParentResponse\"