pes `@` followed by the name of the reference.\",\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/userValueResponse\",\"description\":\"Details of the user mention.\"}},\"required\":[\"type\",\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateResponse\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"type\",\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_preview\":{\"$ref\":\"#/$defs/linkPreviewMentionResponse\",\"description\":\"Details of the link preview mention.\"},\"type\":{\"const\":\"link_preview\",\"description\":\"Always `link_preview`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_preview\"],\"title\":\"Link Preview\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"link_mention\":{\"$ref\":\"#/$defs/linkMentionResponse\",\"description\":\"Details of the link mention.\"},\"type\":{\"const\":\"link_mention\",\"description\":\"Always `link_mention`\",\"type\":\"string\"}},\"required\":[\"type\",\"link_mention\"],\"title\":\"Link Mention\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"page\":{\"additionalProperties\":false,\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"type\",\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"database\":{\"additionalProperties\":false,\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$r