fn _no_auth_headers(client: AdapterClient) -> AdapterHeaders {
  return _merge_header_dicts([client.extra_headers])
}

fn _merge_header_dicts(header_sets: list<AdapterHeaders>) -> AdapterHeaders {
  let out: AdapterHeaders = {}
  for hs in header_sets {
    for entry in hs {
      out = {...out, [entry.key.lower()]: entry.value}
    }
  }
  return out
}

fn _with_extra_headers(headers: AdapterHeaders, client: AdapterClient) -> AdapterHeaders {
  return _merge_header_dicts([headers, client.extra_headers])
}

fn _media_headers(
  headers: AdapterHeaders,
  content_type: string?,
  accept: string,
  operation: string,
  multipart: bool = false,
) -> AdapterHeaders {
  let out: AdapterHeaders = {}
  for header in headers {
    const name = header.key.lower()
    if name == "content-type" {
      if content_type == nil || header.value.lower() != content_type.lower() {
        throw "harn-openapi.generated: operation '" + operation
          + "' Content-Type conflicts with its media plan"
      }
    } else if name == "accept" {
      if header.value.lower() != accept.lower() {
        throw "harn-openapi.generated: operation '" + operation
          + "' Accept conflicts with its media plan"
      }
    } else {
      out = {...out, [header.key]: header.value}
    }
  }
  if content_type != nil && !multipart {
    out = {...out, "Content-Type": content_type}
  }
  if accept != "" {
    out = {...out, Accept: accept}
  }
  return out
}

type MediaBinary = bytes

type MediaScalar = string | int | float | bool | nil

fn _media_scalar(value: unknown) -> string {
  match schema_parse(value, schema_of(MediaScalar)) {
    Ok(scalar) -> { return type_of(scalar) == "string" ? scalar : json_stringify(scalar) }
    Err(_) -> {
      throw "harn-openapi.generated: expected a scalar form value"
    }
  }
}

fn _media_select_body(body: unknown, alternatives: list<dict>) -> dict {
  if len(alternatives) == 1 {
    return {...alternatives[0], value: body}
  }
  if type_of(body) != "dict" || !body.keys().contains("content_type")
    || !body.keys().contains("value") {
    throw "harn-openapi.generated: select request content_type and value explicitly"
  }
  for entry in body {
    if !["content_type", "value"].contains(entry.key) {
      throw "harn-openapi.generated: undeclared representation metadata"
    }
  }
  for alternative in alternatives {
    if alternative.content_type == body.content_type {
      return {...alternative, value: body.value}
    }
  }
  throw "harn-openapi.generated: undeclared request Content-Type"
}

fn _media_prepare_request(
  headers: AdapterHeaders,
  body: unknown,
  alternatives: list<dict>,
  accept: string,
  operation: string,
) -> dict {
  const selected = _media_select_body(body, alternatives)
  if selected.forbidden {
    throw "harn-openapi.generated: request body is forbidden by its JSON Schema"
  }
  const prepared_headers = _media_headers(
    headers,
    selected.content_type,
    accept,
    operation,
    selected.kind == "multipart",
  )
  if selected.kind == "json" {
    return {headers: prepared_headers, options: {body: json_stringify(selected.value)}}
  }
  if selected.kind == "text" || selected.kind == "bytes" {
    if type_of(selected.value) != (selected.kind == "text" ? "string" : "bytes") {
      throw "harn-openapi.generated: invalid request body representation"
    }
    return {headers: prepared_headers, options: {body: selected.value}}
  }
  if type_of(selected.value) != "dict" {
    throw "harn-openapi.generated: expected an object media value"
  }
  const options = if selected.kind == "form" {
    {body: _media_form(selected.value, selected.fields, selected.additional_field)}
  } else {
    {multipart: _media_multipart(selected.value, selected.fields, selected.additional_field)}
  }
  return {headers: prepared_headers, options: options}
}

fn _media_query_string(value: unknown, representation: dict, required: bool) -> string {
  if value == nil && !required {
    return ""
  }
  const prepared = _media_prepare_request({}, value, [representation], "*/*", "querystring")
  const encoded = prepared.options.body
  return "?" + (representation.kind == "json" ? url_encode(encoded) : encoded)
}

fn _media_text(response: dict, operation: string) -> string {
  const decoded = try {
    response.get("body_bytes") != nil ? bytes_to_string(response.body_bytes) : response.get("body")
      ?? ""
  }
  if !is_ok(decoded) {
    throw "harn-openapi.generated: operation '" + operation + "' response is not UTF-8 text"
  }
  return unwrap(decoded)
}

fn _media_error_body(response: dict, decode_bytes: bool = false) -> string {
  if decode_bytes && response.get("body_bytes") != nil {
    const decoded = try {
      bytes_to_string(response.body_bytes)
    }
    return is_ok(decoded) ? unwrap(decoded) : ""
  }
  return type_of(response.get("body")) == "string" ? response.body : ""
}

fn _media_decode_response(response: dict, plans: list<dict>, operation: string) -> any {
  const status = to_string(response.status)
  const range = substring(status, 0, 1) + "XX"
  let selected: dict? = nil
  for key in [status, range, "default"] {
    for plan in plans {
      if plan.status == key {
        selected = plan
        break
      }
    }
    if selected != nil {
      break
    }
  }
  if selected == nil {
    throw "harn-openapi.generated: operation '" + operation
      + "' received an undeclared success status"
  }
  const body = response.get("body_bytes") ?? bytes_from_string(response.get("body") ?? "")
  if len(selected.alternatives) == 0 {
    if bytes_len(body) != 0 {
      throw "harn-openapi.generated: operation '" + operation
        + "' received an undeclared response body"
    }
    return nil
  }
  let content_type: string? = nil
  for header in response.headers {
    if header.key.lower() == "content-type" {
      if content_type != nil {
        throw "harn-openapi.generated: conflicting response Content-Type headers"
      }
      content_type = (header.value.split(";")[0] ?? header.value).trim().lower()
    }
  }
  let representation: dict? = nil
  for alternative in selected.alternatives {
    const expected = (alternative.content_type.split(";")[0] ?? alternative.content_type).trim()
      .lower()
    if content_type == expected || (content_type == nil && len(selected.alternatives) == 1) {
      representation = alternative
    }
  }
  if representation == nil {
    throw "harn-openapi.generated: operation '" + operation
      + "' received an undeclared response Content-Type"
  }
  if representation.forbidden {
    throw "harn-openapi.generated: received a response forbidden by its JSON Schema"
  }
  if representation.kind == "bytes" {
    return body
  }
  const text = _media_text(response, operation)
  if representation.kind == "text" {
    return text
  }
  const parsed = try {
    json_parse(text)
  }
  if !is_ok(parsed) {
    throw {
      category: "invalid_json",
      status: response.status,
      operation: operation,
      retryable: false,
    }
  }
  return unwrap(parsed)
}

fn _media_encoded_value(value: unknown, kind: string) -> string | bytes {
  if kind == "json" {
    return json_stringify(value)
  }
  if kind == "bytes" {
    match schema_parse(value, schema_of(MediaBinary)) {
      Ok(binary) -> { return binary }
      Err(_) -> {
        throw "harn-openapi.generated: expected a binary media value"
      }
    }
  }
  return _media_scalar(value)
}

fn _media_form_escape(value: string) -> string {
  return replace(url_encode(value), "%20", "+")
}

fn _media_field(fields: list<dict>, name: string, additional: dict?) -> dict {
  for field in fields {
    if field.name == name {
      return field
    }
  }
  if additional != nil {
    return additional
  }
  throw "harn-openapi.generated: undeclared form property"
}

fn _media_form_pair(name: string, value: string) -> string {
  return _media_form_escape(name) + "=" + _media_form_escape(value)
}

fn _media_form(body: dict, fields: list<dict>, additional: dict?) -> string {
  let pairs: list<string> = []
  for entry in body {
    const field = _media_field(fields, entry.key, additional)
    if field.forbidden
      && (!field.repeated || type_of(entry.value) != "list"
        || len(entry.value) > 0) {
      throw "harn-openapi.generated: form property is forbidden by its JSON Schema"
    }
    const value = entry.value
    if field.style != "content" && type_of(value) == "dict" {
      let flattened: list<string> = []
      for property in value {
        const scalar = _media_scalar(property.value)
        if field.style == "deepObject" {
          pairs.push(_media_form_pair(entry.key + "[" + property.key + "]", scalar))
        } else if field.explode {
          pairs.push(_media_form_pair(property.key, scalar))
        } else {
          flattened.push(property.key)
          flattened.push(scalar)
        }
      }
      if len(flattened) > 0 {
        const delimiter =
          field.style == "spaceDelimited" ? " " : field.style == "pipeDelimited" ? "|" : ","
        pairs.push(_media_form_pair(entry.key, flattened.join(delimiter)))
      }
      continue
    }
    const values = if field.repeated {
      if type_of(value) != "list" {
        throw "harn-openapi.generated: expected an array form property"
      }
      value
    } else {
      [value]
    }
    let encoded: list<string> = []
    for item in values {
      const serialized = _media_encoded_value(item, field.kind)
      encoded.push(type_of(serialized) == "bytes" ? bytes_to_base64(serialized) : serialized)
    }
    if field.repeated && !field.explode {
      const delimiter =
        field.style == "spaceDelimited" ? " " : field.style == "pipeDelimited" ? "|" : ","
      pairs.push(_media_form_pair(entry.key, encoded.join(delimiter)))
    } else {
      for item in encoded {
        pairs.push(_media_form_pair(entry.key, item))
      }
    }
  }
  return pairs.join("&")
}

fn _media_part(name: string, part: dict, field: dict) -> dict {
  if field.forbidden {
    throw "harn-openapi.generated: multipart property is forbidden by its JSON Schema"
  }
  if !part.keys().contains("value") {
    throw "harn-openapi.generated: multipart property requires a value"
  }
  for entry in part {
    if !["value", "filename", "headers", "content_type"].contains(entry.key) {
      throw "harn-openapi.generated: undeclared multipart metadata"
    }
  }
  const content_type = part.get("content_type") ?? field.content_types[0]
  if !field.content_types.contains(content_type) {
    throw "harn-openapi.generated: multipart Content-Type conflicts with its media plan"
  }
  if len(field.content_types) > 1 && !part.keys().contains("content_type") {
    throw "harn-openapi.generated: select a multipart Content-Type explicitly"
  }
  let headers: dict<string, string> = {}
  const provided = part.get("headers") ?? {}
  if type_of(provided) != "dict" {
    throw "harn-openapi.generated: multipart headers must be an object"
  }
  for header in provided {
    if !field.headers.contains(header.key) {
      throw "harn-openapi.generated: undeclared multipart header"
    }
    headers = {...headers, [header.key]: _media_scalar(header.value)}
  }
  for required in field.required_headers {
    if !provided.keys().contains(required) {
      throw "harn-openapi.generated: required multipart header is absent"
    }
  }
  if field.content_encoding != nil {
    headers = {...headers, "Content-Transfer-Encoding": field.content_encoding}
  }
  let result = {
    name: name,
    value: _media_encoded_value(part.value, field.kind),
    content_type: content_type,
    headers: headers,
  }
  const filename = part.get("filename")
  if filename != nil {
    if type_of(filename) != "string" {
      throw "harn-openapi.generated: multipart filename must be a string"
    }
    result = {...result, filename: filename}
  }
  return result
}

fn _media_multipart(body: dict, fields: list<dict>, additional: dict?) -> list<dict> {
  let parts: list<dict> = []
  for entry in body {
    const field = _media_field(fields, entry.key, additional)
    const values = if field.repeated {
      if type_of(entry.value) != "list" {
        throw "harn-openapi.generated: expected an array multipart property"
      }
      entry.value
    } else {
      [entry.value]
    }
    for value in values {
      if type_of(value) != "dict" {
        throw "harn-openapi.generated: multipart properties require value and optional metadata"
      }
      parts.push(_media_part(entry.key, value, field))
    }
  }
  return parts
}

fn _append_cookie_header(headers: AdapterHeaders, name: string, value: any) -> AdapterHeaders {
  if value == nil {
    return headers
  }
  const pair = url_encode(name) + "=" + url_encode(to_string(value))
  const existing = headers.get("cookie")
  if existing == nil || existing == "" {
    return {...headers, cookie: pair}
  }
  return {...headers, cookie: to_string(existing) + "; " + pair}
}

/** Build a token-provider hook backed by the active connector SecretProvider. */
pub fn token_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
  return fn() {
    const value = secrets.read(secret_id)
    if value == nil {
      return ""
    }
    return to_string(value)
  }
}

/** Build an api-key-provider hook backed by the active connector SecretProvider. */
pub fn api_key_from_secret(secrets: HarnessSecrets, secret_id: string) -> fn() -> string {
  return fn() {
    const value = secrets.read(secret_id)
    if value == nil {
      return ""
    }
    return to_string(value)
  }
}

fn _client_credential(client: AdapterClient, scheme_name: string) -> dict {
  return client.credentials.get(scheme_name) ?? {}
}

fn _credential_available(client: AdapterClient, scheme_name: string, kind: string) -> bool {
  const credential = _client_credential(client, scheme_name)
  if kind == "bearer" {
    return credential.get("token_provider") != nil
      || to_string(credential.get("token") ?? "") != ""
  }
  if starts_with(kind, "api_key_") {
    return credential.get("value_provider") != nil
      || to_string(credential.get("value") ?? "") != ""
  }
  if kind == "basic" {
    return credential.get("basic_provider") != nil
      || (to_string(credential.get("username") ?? "") != ""
        && to_string(credential.get("password") ?? "") != "")
  }
  if kind == "mutual_tls" {
    return credential.get("host_configured") == true
  }
  return false
}

fn _client_token(client: AdapterClient, scheme_name: string) -> string {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("token_provider")
  if provider != nil {
    return to_string(provider())
  }
  return to_string(credential.get("token") ?? "")
}

fn _client_api_key(client: AdapterClient, scheme_name: string) -> string {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("value_provider")
  if provider != nil {
    return to_string(provider())
  }
  return to_string(credential.get("value") ?? "")
}

fn _client_basic(client: AdapterClient, scheme_name: string) -> dict {
  const credential = _client_credential(client, scheme_name)
  const provider = credential.get("basic_provider")
  if provider != nil {
    const provided = provider()
    return {user: provided.username, password: provided.password}
  }
  return {user: credential.get("username") ?? "", password: credential.get("password") ?? ""}
}

fn _headers_basic_auth(client: AdapterClient) -> dict {
  const basic = _client_basic(client, "basicAuth")
  if basic.get("user") == "" || basic.get("password") == "" {
    throw "harn-openapi.generated: security scheme 'basicAuth' requires both username and password"
  }
  let hs: dict = {}
  const encoded = base64_encode(to_string(basic.user) + ":" + to_string(basic.password))
  hs = {...hs, Authorization: "Basic " + encoded}
  return _with_extra_headers(hs, client)
}

fn _headers_bearer_auth(client: AdapterClient) -> dict {
  const token = _client_token(client, "bearerAuth")
  if token == "" {
    throw "harn-openapi.generated: security scheme 'bearerAuth' produced no credential"
  }
  let hs: dict = {}
  if token != "" {
    hs = {...hs, Authorization: "Bearer " + token}
  }
  return _with_extra_headers(hs, client)
}

/** Pagination plans detected from the OpenAPI operation shapes. */
pub fn pagination_plans() -> list {
  return json_parse(
    "[{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-block-children\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/blocks/{block_id}/children\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-comments\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/comments\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-custom-emojis\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/custom_emojis\"},{\"cursor_location\":\"body\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"post\",\"operation_id\":\"post-database-query\",\"page_size_location\":\"body\",\"page_size_param\":\"page_size\",\"path\":\"/v1/data_sources/{data_source_id}/query\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"templates\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-data-source-templates\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/data_sources/{data_source_id}/templates\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-file-uploads\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/file_uploads\"},{\"cursor_location\":\"body\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"post\",\"operation_id\":\"post-search\",\"page_size_location\":\"body\",\"page_size_param\":\"page_size\",\"path\":\"/v1/search\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-users\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/users\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"list-views\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/views\"},{\"cursor_location\":\"query\",\"cursor_param\":\"start_cursor\",\"cursor_response_field\":\"next_cursor\",\"has_more_field\":\"has_more\",\"items_field\":\"results\",\"kind\":\"cursor\",\"method\":\"get\",\"operation_id\":\"get-view-query-results\",\"page_size_location\":\"query\",\"page_size_param\":\"page_size\",\"path\":\"/v1/views/{view_id}/queries/{query_id}\"}]",
  )
}

/** Look up the pagination plan for a given operation id, or nil if none. */
pub fn pagination_plan(operation_id: string) -> dict? {
  for plan in pagination_plans() {
    if plan.operation_id == operation_id {
      return plan
    }
  }
  return nil
}

/** Extract the items list from `response` according to `plan`. */
pub fn pagination_items(response: dict, plan: dict) -> list {
  const field = plan.get("items_field")
  if field == nil {
    return []
  }
  const value = response.get(field)
  if type_of(value) == "list" {
    return value
  }
  return []
}

/**
 * Compute the next-page directive from `response` according to `plan`.
 * Returns a dict with `done: bool` plus a `query` or `body` dict to merge
 * into the next call, or a `url` to follow (next-link style).
 */
pub fn pagination_next(response: dict, plan: dict) -> dict {
  const kind = plan.get("kind")
  if kind == "cursor" {
    const cursor_field = plan.get("cursor_response_field")
    const cursor = if cursor_field == nil {
      nil
    } else {
      response.get(cursor_field)
    }
    const has_more_field = plan.get("has_more_field")
    const has_more = if has_more_field == nil {
      cursor != nil
    } else {
      response.get(has_more_field)
    }
    const field = plan.get("cursor_param")
    if plan.get("cursor_location") == "body" {
      return {done: cursor == nil || !has_more, body: {[field]: cursor}}
    }
    return {done: cursor == nil || !has_more, query: {[field]: cursor}}
  }
  if kind == "page" {
    return {done: false, query: {}}
  }
  if kind == "next_link" {
    const field = plan.get("next_link_field")
    let url = if field == nil {
      nil
    } else {
      response.get(field)
    }
    return {done: url == nil || url == "", url: url}
  }
  return {done: true, query: {}}
}

/** Rate-limit response/header conventions detected from OpenAPI responses. */
pub fn rate_limit_metadata() -> list {
  return json_parse(
    "[{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-a-block\",\"path\":\"/v1/blocks/{block_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"delete\",\"operation_id\":\"delete-a-block\",\"path\":\"/v1/blocks/{block_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-a-block\",\"path\":\"/v1/blocks/{block_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"get-block-children\",\"path\":\"/v1/blocks/{block_id}/children\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"patch-block-children\",\"path\":\"/v1/blocks/{block_id}/children\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"list-comments\",\"path\":\"/v1/comments\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-a-comment\",\"path\":\"/v1/comments\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-comment\",\"path\":\"/v1/comments/{comment_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"delete\",\"operation_id\":\"delete-a-comment\",\"path\":\"/v1/comments/{comment_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-a-comment\",\"path\":\"/v1/comments/{comment_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"list-custom-emojis\",\"path\":\"/v1/custom_emojis\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-a-database\",\"path\":\"/v1/data_sources\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-a-data-source\",\"path\":\"/v1/data_sources/{data_source_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-a-data-source\",\"path\":\"/v1/data_sources/{data_source_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"post-database-query\",\"path\":\"/v1/data_sources/{data_source_id}/query\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"list-data-source-templates\",\"path\":\"/v1/data_sources/{data_source_id}/templates\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-database\",\"path\":\"/v1/databases\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-database\",\"path\":\"/v1/databases/{database_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-database\",\"path\":\"/v1/databases/{database_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"list-file-uploads\",\"path\":\"/v1/file_uploads\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-file\",\"path\":\"/v1/file_uploads\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-file-upload\",\"path\":\"/v1/file_uploads/{file_upload_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"complete-file-upload\",\"path\":\"/v1/file_uploads/{file_upload_id}/complete\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"upload-file\",\"path\":\"/v1/file_uploads/{file_upload_id}/send\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"post-page\",\"path\":\"/v1/pages\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-a-page\",\"path\":\"/v1/pages/{page_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"patch-page\",\"path\":\"/v1/pages/{page_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-page-markdown\",\"path\":\"/v1/pages/{page_id}/markdown\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-page-markdown\",\"path\":\"/v1/pages/{page_id}/markdown\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"move-page\",\"path\":\"/v1/pages/{page_id}/move\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-a-page-property\",\"path\":\"/v1/pages/{page_id}/properties/{property_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"post-search\",\"path\":\"/v1/search\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"get-users\",\"path\":\"/v1/users\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"get-self\",\"path\":\"/v1/users/me\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"get-user\",\"path\":\"/v1/users/{user_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"list-views\",\"path\":\"/v1/views\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-view\",\"path\":\"/v1/views\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"retrieve-a-view\",\"path\":\"/v1/views/{view_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"delete\",\"operation_id\":\"delete-view\",\"path\":\"/v1/views/{view_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"patch\",\"operation_id\":\"update-a-view\",\"path\":\"/v1/views/{view_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"post\",\"operation_id\":\"create-view-query\",\"path\":\"/v1/views/{view_id}/queries\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"get\",\"operation_id\":\"get-view-query-results\",\"path\":\"/v1/views/{view_id}/queries/{query_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"},{\"limit_headers\":[],\"method\":\"delete\",\"operation_id\":\"delete-view-query\",\"path\":\"/v1/views/{view_id}/queries/{query_id}\",\"remaining_headers\":[],\"reset_headers\":[],\"retry_after_header\":null,\"status\":\"429\"}]",
  )
}

fn _header_ci(headers: dict, wanted: string) {
  for entry in headers {
    if entry.key.lower() == wanted.lower() {
      return entry.value
    }
  }
  return nil
}

/** Extract status + standard rate-limit headers from a raw HTTP response. */
pub fn rate_limit_from_response(resp: dict) -> dict {
  let headers = resp.get("headers") ?? {}
  return {
    status: resp.get("status"),
    retry_after: _header_ci(headers, "Retry-After"),
    limit: _header_ci(headers, "RateLimit-Limit")
      ?? _header_ci(headers, "X-RateLimit-Limit"),
    remaining: _header_ci(headers, "RateLimit-Remaining")
      ?? _header_ci(headers, "X-RateLimit-Remaining"),
    reset: _header_ci(headers, "RateLimit-Reset")
      ?? _header_ci(headers, "X-RateLimit-Reset"),
  }
}

/** True if the response looks rate-limited (HTTP 429 or Retry-After set). */
pub fn is_rate_limited_response(resp: dict) -> bool {
  let headers = resp.get("headers") ?? {}
  return resp.get("status") == 429 || _header_ci(headers, "Retry-After") != nil
}

fn _interpolate(template: string, bindings: dict) -> string {
  let out = template
  for entry in bindings {
    out = replace(out, "{" + entry.key + "}", url_encode(to_string(entry.value)))
  }
  return out
}

fn _join_url(base_url: string, path: string) -> string {
  if base_url == "" {
    return path
  }
  if path == "" {
    return base_url
  }
  const base_has_slash = substring(base_url, len(base_url) - 1, len(base_url)) == "/"
  const path_has_slash = starts_with(path, "/")
  if base_has_slash && path_has_slash {
    return substring(base_url, 0, len(base_url) - 1) + path
  }
  if !base_has_slash && !path_has_slash {
    return base_url + "/" + path
  }
  return base_url + path
}

fn _query_string(params: dict) -> string {
  let parts = []
  for entry in params {
    if entry.value != nil {
      parts = parts + [url_encode(entry.key) + "=" + url_encode(to_string(entry.value))]
    }
  }
  if len(parts) == 0 {
    return ""
  }
  return "?" + join(parts, "&")
}

