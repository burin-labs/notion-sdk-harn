      handler: { args ->
        const result = update_a_data_source(
          harness,
          client,
          args.get("data_source_id"),
          args.get("body"),
          args.get("notion_version"),
        )
        agent_tool_handler_result(json_stringify(result), result)
      },
      title: "Update a data source",
      annotations: json_parse("{\"idempotentHint\":false,\"readOnlyHint\":false}"),
      execution_policy: json_parse("{\"kind\":\"execute\",\"side_effect_level\":\"network\"}"),
      governance: json_parse(
