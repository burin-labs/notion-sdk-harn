/** Update a block */
pub fn update_a_block(
  harness: {clock: HarnessClock, net: HarnessNet},
  client: AdapterClient,
  block_id: any,
  body: any,
  notion_version: any = nil,
) -> any {
  const operation_auth = _security_update_a_block(client)
  const path_bindings = {block_id: block_id}
  const path = _interpolate("/v1/blocks/{block_id}", path_bindings)
  const query_bindings = {...operation_auth.query}
  let url = _join_url(client.base_url, path)
  url = url + _query_string(query_bindings)
  let request_headers = operation_auth.headers
  if notion_version != nil {
    request_headers = {...request_headers, "Notion-Version": to_string(notion_version)}
  }
  const body_variant = if type_of(body) == "dict" {
    body.get("_variant")
  } else {
    nil
  }
  if body_variant == nil {
    throw "update_a_block: polymorphic request body must be built with one of: update_a_block_variant1, update_a_block_variant2"
  }
  if !["Variant1", "Variant2"].contains(body_variant) {
    throw "update_a_block: unknown request body variant " + to_string(body_variant)
  }
  const body_str = json_stringify(_strip_codegen_variant(body))
  const resp = connector_http_json(
    harness.clock,
    harness.net,
    "PATCH",
    url,
    {
      headers: request_headers,
      provider: "notion",
      operation: "update_a_block",
      retry: {max_attempts: 1},
      body: body_str,
    },
  )
  if !(resp.ok ?? false) {
    throw redact_response(resp)
  }
  return resp.json
}

/** Build a `Variant1` variant of the polymorphic request body. */
pub fn update_a_block_variant1(payload: dict) -> dict {
  return {...payload, _variant: "Variant1"}
}

/** Build a `Variant2` variant of the polymorphic request body. */
pub fn update_a_block_variant2(in_trash: any = nil) -> dict {
  let body = {_variant: "Variant2"}
  if in_trash != nil {
    body = {...body, in_trash: in_trash}
  }
  return body
}

