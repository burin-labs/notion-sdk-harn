  const operation_auth = _security_delete_view_query(client)
  const path_bindings = {view_id: view_id, query_id: query_id}
  const path = _interpolate("/v1/views/{view_id}/queries/{query_id}", path_bindings)
  const query_bindings = {...operation_auth.query}
  let url = _join_url(client.base_url, path)
  url = url + _query_string(query_bindings)
  let request_headers = operation_auth.headers
  if notion_version != nil {
    request_headers = {...request_headers, "Notion-Version": to_string(notion_version)}
  }
  const resp = connector_http_json(
    harness.clock,
    harness.net,
    "DELETE",
    url,
    {
      headers: request_headers,
      provider: "notion",
      operation: "delete_view_query",
      retry: {max_attempts: 3},
    },
  )
  if !(resp.ok ?? false) {
    throw redact_response(resp)
  }
  const raw = resp.json
  if type_of(raw) != "dict" {
    throw "delete_view_query: expected dict response, got " + type_of(raw)
  }
  return raw
}
