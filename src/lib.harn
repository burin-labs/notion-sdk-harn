        "{\"body\":{\"required\":true,\"schema\":{\"$defs\":{\"annotationRequest\":{\"properties\":{\"bold\":{\"description\":\"Whether the text is formatted as bold.\",\"type\":\"boolean\"},\"code\":{\"description\":\"Whether the text is formatted as code.\",\"type\":\"boolean\"},\"color\":{\"$ref\":\"#/$defs/apiColor\",\"description\":\"The color of the text.\"},\"italic\":{\"description\":\"Whether the text is formatted as italic.\",\"type\":\"boolean\"},\"strikethrough\":{\"description\":\"Whether the text is formatted with a strikethrough.\",\"type\":\"boolean\"},\"underline\":{\"description\":\"Whether the text is formatted with an underline.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apiColor\":{\"description\":\"One of: `default`, `gray`, `brown`, `orange`, `yellow`, `green`, `blue`, `purple`, `pink`, `red`, `default_background`, `gray_background`, `brown_background`, `orange_background`, `yellow_background`, `green_background`, `blue_background`, `purple_background`, `pink_background`, `red_background`\",\"enum\":[\"default\",\"gray\",\"brown\",\"orange\",\"yellow\",\"green\",\"blue\",\"purple\",\"pink\",\"red\",\"default_background\",\"gray_background\",\"brown_background\",\"orange_background\",\"yellow_background\",\"green_background\",\"blue_background\",\"purple_background\",\"pink_background\",\"red_background\"],\"type\":\"string\"},\"dateRequest\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"description\":\"The end date of the date object, if any.\",\"oneOf\":[{\"format\":\"date\",\"type\":\"string\"},{\"type\":\"null\"}]},\"start\":{\"description\":\"The start date of the date object.\",\"format\":\"date\",\"type\":\"string\"},\"time_zone\":{\"description\":\"The time zone of the date object, if any. E.g. America/Los_Angeles, Europe/London, etc.\",\"oneOf\":[{\"$ref\":\"#/$defs/timeZoneRequest\"},{\"type\":\"null\"}]}},\"required\":[\"start\"],\"type\":\"object\"},\"equationRichTextItemRequest\":{\"properties\":{\"equation\":{\"description\":\"Notion supports inline LaTeX equations as rich text objects with a type value of `equation`.\",\"properties\":{\"expression\":{\"description\":\"A KaTeX compatible string.\",\"examples\":[\"e=mc^2\"],\"type\":\"string\"}},\"required\":[\"expression\"],\"type\":\"object\"},\"type\":{\"const\":\"equation\",\"description\":\"Always `equation`\",\"type\":\"string\"}},\"required\":[\"equation\"],\"title\":\"Equation\",\"type\":\"object\"},\"idRequest\":{\"type\":\"string\"},\"mentionRichTextItemRequest\":{\"properties\":{\"mention\":{\"description\":\"Mention objects represent an inline mention of a database, date, link preview mention, page, template mention, or user. A mention is created in the Notion UI when a user types `@` followed by the name of the reference.\",\"oneOf\":[{\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"},\"user\":{\"$ref\":\"#/$defs/partialUserObjectRequest\",\"description\":\"Details of the user mention.\"}},\"required\":[\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"properties\":{\"date\":{\"$ref\":\"#/$defs/dateRequest\",\"description\":\"Details of the date mention.\"},\"type\":{\"const\":\"date\",\"description\":\"Always `date`\",\"type\":\"string\"}},\"required\":[\"date\"],\"title\":\"Date\",\"type\":\"object\"},{\"properties\":{\"page\":{\"description\":\"Details of the page mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the page in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"page\",\"description\":\"Always `page`\",\"type\":\"string\"}},\"required\":[\"page\"],\"title\":\"Page\",\"type\":\"object\"},{\"properties\":{\"database\":{\"description\":\"Details of the database mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the database in the mention.\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"database\",\"description\":\"Always `database`\",\"type\":\"string\"}},\"required\":[\"database\"],\"title\":\"Database\",\"type\":\"object\"},{\"properties\":{\"template_mention\":{\"$ref\":\"#/$defs/templateMentionRequest\",\"description\":\"Details of the template mention.\"},\"type\":{\"const\":\"template_mention\",\"description\":\"Always `template_mention`\",\"type\":\"string\"}},\"required\":[\"template_mention\"],\"title\":\"Template Mention\",\"type\":\"object\"},{\"properties\":{\"custom_emoji\":{\"description\":\"Details of the custom emoji mention.\",\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the custom emoji.\"},\"name\":{\"description\":\"The name of the custom emoji.\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the custom emoji.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Always `custom_emoji`\",\"type\":\"string\"}},\"required\":[\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"}]},\"type\":{\"const\":\"mention\",\"description\":\"Always `mention`\",\"type\":\"string\"}},\"required\":[\"mention\"],\"title\":\"Mention\",\"type\":\"object\"},\"partialUserObjectRequest\":{\"properties\":{\"id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the user.\"},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"richTextItemRequest\":{\"allOf\":[{\"$ref\":\"#/$defs/richTextItemRequestCommon\"},{\"oneOf\":[{\"$ref\":\"#/$defs/textRichTextItemRequest\"},{\"$ref\":\"#/$defs/mentionRichTextItemRequest\"},{\"$ref\":\"#/$defs/equationRichTextItemRequest\"}]}]},\"richTextItemRequestCommon\":{\"properties\":{\"annotations\":{\"$ref\":\"#/$defs/annotationRequest\",\"description\":\"All rich text objects contain an annotations object that sets the styling for the rich text.\"}},\"type\":\"object\"},\"templateMentionDateTemplateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_date\":{\"description\":\"The date of the template mention.\",\"enum\":[\"today\",\"now\"],\"type\":\"string\"},\"type\":{\"const\":\"template_mention_date\",\"description\":\"Always `template_mention_date`\",\"type\":\"string\"}},\"required\":[\"template_mention_date\"],\"title\":\"Template Mention Date\",\"type\":\"object\"},\"templateMentionRequest\":{\"oneOf\":[{\"$ref\":\"#/$defs/templateMentionDateTemplateMentionRequest\"},{\"$ref\":\"#/$defs/templateMentionUserTemplateMentionRequest\"}]},\"templateMentionUserTemplateMentionRequest\":{\"additionalProperties\":false,\"properties\":{\"template_mention_user\":{\"const\":\"me\",\"description\":\"The user of the template mention.\",\"type\":\"string\"},\"type\":{\"const\":\"template_mention_user\",\"description\":\"Always `template_mention_user`\",\"type\":\"string\"}},\"required\":[\"template_mention_user\"],\"title\":\"Template Mention User\",\"type\":\"object\"},\"textRichTextItemRequest\":{\"properties\":{\"text\":{\"additionalProperties\":false,\"description\":\"If a rich text object's type value is `text`, then the corresponding text field contains an object including the text content and any inline link.\",\"properties\":{\"content\":{\"description\":\"The actual text content of the text.\",\"maxLength\":2000,\"type\":\"string\"},\"link\":{\"description\":\"An object with information about any inline link in this text, if included.\",\"oneOf\":[{\"properties\":{\"url\":{\"description\":\"The URL of the link.\",\"examples\":[\"https://www.notion.com\"],\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"},{\"type\":\"null\"}]}},\"required\":[\"content\"],\"type\":\"object\"},\"type\":{\"const\":\"text\",\"description\":\"Always `text`\",\"type\":\"string\"}},\"required\":[\"text\"],\"title\":\"Text\",\"type\":\"object\"},\"timeZoneRequest\":{\"type\":\"string\"}},\"oneOf\":[{\"properties\":{\"parent\":{\"description\":\"The parent of the comment. This can be a page or a block.\",\"oneOf\":[{\"properties\":{\"page_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the parent page (with or without dashes), for example, 195de9221179449fab8075a27c979105\"},\"type\":{\"const\":\"page_id\",\"description\":\"Always `page_id`\",\"type\":\"string\"}},\"required\":[\"page_id\"],\"type\":\"object\"},{\"properties\":{\"block_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the parent block (with or without dashes), for example, 195de9221179449fab8075a27c979105\"},\"type\":{\"const\":\"block_id\",\"description\":\"Always `block_id`\",\"type\":\"string\"}},\"required\":[\"block_id\"],\"type\":\"object\"}]},\"rich_text\":{\"description\":\"An array of rich text objects that represent the content of the comment.\",\"items\":{\"$ref\":\"#/$defs/richTextItemRequest\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"parent\",\"rich_text\"],\"type\":\"object\"},{\"properties\":{\"markdown\":{\"description\":\"The content of the comment as a Markdown string. Comment Markdown supports inline formatting only (bold, italic, strikethrough, code, links), inline equations ($expression$), and mentions. Block-level Markdown such as fenced code blocks, headings, lists, tables, and blockquotes does not render as structured blocks in comments.\",\"type\":\"string\"},\"parent\":{\"description\":\"The parent of the comment. This can be a page or a block.\",\"oneOf\":[{\"properties\":{\"page_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the parent page (with or without dashes), for example, 195de9221179449fab8075a27c979105\"},\"type\":{\"const\":\"page_id\",\"description\":\"Always `page_id`\",\"type\":\"string\"}},\"required\":[\"page_id\"],\"type\":\"object\"},{\"properties\":{\"block_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the parent block (with or without dashes), for example, 195de9221179449fab8075a27c979105\"},\"type\":{\"const\":\"block_id\",\"description\":\"Always `block_id`\",\"type\":\"string\"}},\"required\":[\"block_id\"],\"type\":\"object\"}]}},\"required\":[\"parent\",\"markdown\"],\"type\":\"object\"},{\"properties\":{\"discussion_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the discussion to comment on.\"},\"rich_text\":{\"description\":\"An array of rich text objects that represent the content of the comment.\",\"items\":{\"$ref\":\"#/$defs/richTextItemRequest\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"discussion_id\",\"rich_text\"],\"type\":\"object\"},{\"properties\":{\"discussion_id\":{\"$ref\":\"#/$defs/idRequest\",\"description\":\"The ID of the discussion to comment on.\"},\"markdown\":{\"description\":\"The content of the comment as a Markdown string. Comment Markdown supports inline formatting only (bold, italic, strikethrough, code, links), inline equations ($expression$), and mentions. Block-level Markdown such as fenced code blocks, headings, lists, tables, and blockquotes does not render as structured blocks in comments.\",\"type\":\"string\"}},\"required\":[\"discussion_id\",\"markdown\"],\"type\":\"object\"}],\"properties\":{\"attachments\":{\"description\":\"An array of files to attach to the comment. Maximum of 3 allowed.\",\"items\":{\"properties\":{\"file_upload_id\":{\"description\":\"ID of a FileUpload object that has the status `uploaded`.\",\"type\":\"string\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"file_upload_id\"],\"type\":\"object\"},\"maxItems\":3,\"type\":\"array\"},\"display_name\":{\"description\":\"Display name for the comment.\",\"oneOf\":[{\"properties\":{\"type\":{\"const\":\"integration\",\"description\":\"Always `integration`\",\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"Integration\",\"type\":\"object\"},{\"properties\":{\"type\":{\"const\":\"user\",\"description\":\"Always `user`\",\"type\":\"string\"}},\"required\":[\"type\"],\"title\":\"User\",\"type\":\"object\"},{\"properties\":{\"custom\":{\"properties\":{\"name\":{\"description\":\"The custom display name to use\",\"minLength\":1,\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":{\"const\":\"custom\",\"description\":\"Always `custom`\",\"type\":\"string\"}},\"required\":[\"type\",\"custom\"],\"title\":\"Custom\",\"type\":\"object\"}]}},\"type\":\"object\"}}}",
