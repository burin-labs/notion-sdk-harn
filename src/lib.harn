string\"},{\"type\":\"null\"}]},\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the user.\"},\"name\":{\"description\":\"The name of the user.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"object\":{\"const\":\"user\",\"description\":\"The user object type name.\",\"type\":\"string\"},\"person\":{\"additionalProperties\":false,\"description\":\"The person info of the user.\",\"properties\":{\"email\":{\"description\":\"The email of the person.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"const\":\"person\",\"description\":\"The type of the user.\",\"type\":\"string\"}},\"required\":[\"id\",\"object\",\"name\",\"avatar_url\",\"type\",\"person\"],\"type\":\"object\"},{\"$ref\":\"#/$defs/partialUserObjectResponse\"}]}},\"required\":[\"type\",\"user\"],\"title\":\"User\",\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"workspace\",\"description\":\"Always `workspace`\",\"type\":\"string\"},\"workspace\":{\"const\":true,\"description\":\"Details about the owner of the bot, when the `type` of the owner is `workspace`. This means the bot is for an internal integration.\",\"type\":\"boolean\"}},\"required\":[\"type\",\"workspace\"],\"title\":\"Workspace\",\"type\":\"object\"}]},\"workspace_id\":{\"description\":\"The ID of the bot's workspace.\",\"type\":\"string\"},\"workspace_limits\":{\"additionalProperties\":false,\"description\":\"Limits and restrictions that apply to the bot's workspace\",\"properties\":{\"max_file_upload_size_in_bytes\":{\"description\":\"The maximum allowable size of a file upload, in bytes\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"max_file_upload_size_in_bytes\"],\"type\":\"object\"},\"workspace_name\":{\"description\":\"The name of the bot's workspace.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"owner\",\"workspace_id\",\"workspace_limits\",\"workspace_name\"],\"type\":\"object\"},\"botUserObjectResponse\":{\"properties\":{\"bot\":{\"description\":\"Details about the bot, when the `type` of the user is `bot`.\",\"oneOf\":[{\"$ref\":\"#/$defs/emptyObject\"},{\"$ref\":\"#/$defs/botInfoResponse\"}]},\"type\":{\"const\":\"bot\",\"description\":\"Indicates this user is a bot.\",\"type\":\"string\"}},\"required\":[\"type\",\"bot\"],\"title\":\"Bot\",\"type\":\"object\"},\"customEmojiPageIconResponse\":{\"additionalProperties\":false,\"properties\":{\"custom_emoji\":{\"$ref\":\"#/$defs/customEmojiResponse\",\"description\":\"The custom emoji details for the icon.\"},\"type\":{\"const\":\"custom_emoji\",\"description\":\"Type of icon. In this case, a custom emoji.\",\"type\":\"string\"}},\"required\":[\"type\",\"custom_emoji\"],\"title\":\"Custom Emoji\",\"type\":\"object\"},\"customEmojiResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the custom emoji.\"},\"name\":{\"description\":\"The name of the custom emoji.\",\"type\":\"string\"},\"url\":{\"description\":\"The URL of the custom emoji.\",\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"url\"],\"type\":\"object\"},\"dataSourceReferenceResponse\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/idResponse\",\"description\":\"The ID of the data source.\"},\"name\":{\"description\":\"The name of the data source.\",\"type\":\"string\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"databaseObjectResponse\":{\"additionalProperties\":false,\"properties\":{\"cover\":{\"description\":\"The cover of the database.\",\"oneOf\":[{\"$ref\":\"#/$defs/pageCoverResponse\"},{\"type\":\"null\"}]},\"created_time\":{\"description\":\"The time when the database was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"data_sources\":{\"description\":\"The data sources of the database.\",\"items\":{\"$ref\":\"#/$defs/dataSourceReferenceResponse\"},\"maxItems\":100,\"type\":\"array\"},\"description\":{\"description\":\"The description of