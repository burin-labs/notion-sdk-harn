tus `uploaded`.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"file_upload\"],\"title\":\"File Upload\",\"type\":\"object\"},\"fileUploadPageIconRequest\":{\"properties\":{\"file_upload\":{\"properties\":{\"id\":{\"description\":\"ID of a FileUpload object that has the status `uploaded`.\",\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"type\":{\"const\":\"file_upload\",\"description\":\"Always `file_upload`\",\"type\":\"string\"}},\"required\":[\"file_upload\"],\"title\":\"File Upload\",\"type\":\"object\"},\"filesPropertyConfigurationRequest\":{\"properties\":{\"files\":{\"$ref\":\"#/$defs/emptyObject\"},\"type\":{\"const\":\"files\",\"description\":\"Always `files`\",\"type\":\"string\"}},\"required\":[\"files\"],\"title\":\"Files\",\"type\":\"object\"},\"formulaPropertyConfigurationRequest\":{\"properties\":{\"formula\":{\"properties\":{\"expression\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"const\":\"formula\",\"description\":\"Always `formula`\",\"type\":\"string\"}},\"required\":[\"formula\"],\"title\":\"Formula\",\"type\":\"object\"},\"iconPageIconRequest\":{\"properties\":{\"icon\":{\"description\":\"A Notion native icon, specified by name and optional color.\",\"properties\":{\"color\":{\"$ref\":\"#/$defs/noticonColor\",\"description\":\"The color variant of the icon. Defaults to gray if not specified. Valid values: gray, lightgray, brown, yellow, orange, green, blue, purple, pink, red.\"},\"name\":{\"$ref\":\"#/$defs/noticonName\",\"description\":\"The name of the Notion icon (e.g. pizza, meeting, home). See the Notion icon picker for valid names.\"}},\"required\":[\"name\"],\"type\":\"object\"},\"type\":{\"const\":\"icon\",\"description\":\"Always `icon`\",\"type\":\"string\"}},\"required\":[\"icon\"],\"title\":\"Icon\",\"type\":\"object\"},\"idRequest\":{\"type\":\"string\"},\"initialDat