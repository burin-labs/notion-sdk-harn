ng_content\":{\"description\":\"Set to true to allow the operation to delete child pages or databases. Defaults to false.\",\"type\":\"boolean\"},\"content_updates\":{\"description\":\"An array of search-and-replace operations, each with old_str (content to find) and new_str (replacement content).\",\"items\":{\"properties\":{\"new_str\":{\"description\":\"The new content string to replace old_str with.\",\"type\":\"string\"},\"old_str\":{\"description\":\"The existing content string to find and replace. Must exactly match the page content.\",\"type\":\"string\"},\"replace_all_matches\":{\"description\":\"If true, replaces all occurrences of old_str. If false (default), the operation fails if there are multiple matches.\",\"type\":\"boolean\"}},\"required\":[\"old_str\",\"new_str\"],\"type\":\"object\"},\"maxItems\":100,\"type\":\"array\"}},\"required\":[\"content_updates\"],\"type\":\"object\"}},\"required\":[\"type\",\"update_content\"],\"title\":\"Update Content\",\"type\":\"object\"},{\"properties\":{\"replace_content\":{\"description\":\"Replace the entire page content with new markdown.\",\"properties\":{\"allow_deleting_content\":{\"description\":\"Set to true to allow the operation to delete child pages or databases. Defaults to false.\",\"type\":\"boolean\"},\"new_str\":{\"description\":\"The new enhanced markdown content to replace the entire page content.\",\"examples\":[\"# Updated Page\\n\\nCompletely new page content.\"],\"type\":\"string\"}},\"required\":[\"new_str\"],\"type\":\"object\"},\"type\":{\"const\":\"replace_content\",\"description\":\"Always `replace_content`\",\"type\":\"string\"}},\"required\":[\"type\",\"replace_content\"],\"title\":\"Replace Content\",\"type\":\"object\"}]}},\"page_id\":{\"required\":true,\"schema\":{\"description\":\"The ID of the page to update.\",\"type\":\"string\"}}}",
