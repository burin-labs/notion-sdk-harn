 the range for number grouping buckets.\",\"type\":\"integer\"},\"range_size\":{\"description\":\"Size of each bucket in number grouping.\",\"minimum\":1,\"type\":\"integer\"},\"range_start\":{\"description\":\"Start of the range for number grouping buckets.\",\"type\":\"integer\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"number\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"sort\"],\"type\":\"object\"},\"formulaTextSubGroupByRequest\":{\"properties\":{\"group_by\":{\"description\":\"How to group text values. \\\"exact\\\" = exact match, \\\"alphabet_prefix\\\" = first letter.\",\"enum\":[\"exact\",\"alphabet_prefix\"],\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"text\",\"description\":\"The formula result type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"group_by\",\"sort\"],\"type\":\"object\"},\"galleryViewConfigRequest\":{\"properties\":{\"card_layout\":{\"description\":\"Card layout mode. \\\"list\\\" shows full cards, \\\"compact\\\" shows condensed cards. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `list`, `compact`\",\"enum\":[\"list\",\"compact\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"cover\":{\"description\":\"Cover image configuration for cards. Pass null to clear.\",\"oneOf\":[{\"$ref\":\"#/$defs/coverConfigRequest\"},{\"type\":\"null\"}]},\"cover_aspect\":{\"description\":\"Aspect ratio mode for cover images. \\\"contain\\\" fits the image, \\\"cover\\\" fills the area. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `contain`, `cover`\",\"enum\":[\"contain\",\"cover\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"cover_size\":{\"description\":\"Size of the cover image on cards. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `small`, `medium`, `large`\",\"enum\":[\"small\",\"medium\",\"large\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"properties\":{\"description\":\"Property visibility and display configuration on gallery cards. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"gallery\",\"description\":\"The view type. Must be \\\"gallery\\\".\",\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"groupByConfigRequest\":{\"description\":\"Group-by configuration based on property type.\",\"oneOf\":[{\"$ref\":\"#/$defs/selectGroupByConfigRequest\"},{\"$ref\":\"#/$defs/statusGroupByConfigRequest\"},{\"$ref\":\"#/$defs/personGroupByConfigRequest\"},{\"$ref\":\"#/$defs/relationGroupByConfigRequest\"},{\"$ref\":\"#/$defs/dateGroupByConfigRequest\"},{\"$ref\":\"#/$defs/textGroupByConfigRequest\"},{\"$ref\":\"#/$defs/numberGroupByConfigRequest\"},{\"$ref\":\"#/$defs/checkboxGroupByConfigRequest\"},{\"$ref\":\"#/$defs/formulaGroupByConfigRequest\"}]},\"groupSortRequest\":{\"properties\":{\"type\":{\"description\":\"Sort direction for groups.\",\"enum\":[\"manual\",\"ascending\",\"descending\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"listViewConfigRequest\":{\"properties\":{\"properties\":{\"description\":\"Property visibility and display configuration. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"list\",\"description\":\"The view type. Must be \\\"list\\\".\",\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"mapViewConfigRequest\":{\"properties\":{\"height\":{\"description\":\"Map display height. Pass null to clear.\",\"oneOf\":[{\"description\":\"One of: `small`, `medium`, `large`, `extra_large`\",\"enum\":[\"small\",\"medium\",\"large\",\"extra_large\"],\"type\":\"string\"},{\"type\":\"null\"}]},\"map_by\":{\"description\":\"Property ID of the location property used to position items on the map. Pass null to clear.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"properties\":{\"description\":\"Property visibility and display configuration on map pin cards. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"map\",\"description\":\"The view type. Must be \\\"map\\\".\",\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"numberGroupByConfigRequest\":{\"properties\":{\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"range_end\":{\"description\":\"End of the range for number grouping buckets.\",\"type\":\"integer\"},\"range_size\":{\"description\":\"Size of each bucket in number grouping.\",\"minimum\":1,\"type\":\"integer\"},\"range_start\":{\"description\":\"Start of the range for number grouping buckets.\",\"type\":\"integer\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"number\",\"description\":\"The property type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"sort\"],\"type\":\"object\"},\"personGroupByConfigRequest\":{\"properties\":{\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"description\":\"The property type for grouping.\",\"enum\":[\"person\",\"created_by\",\"last_edited_by\"],\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"sort\"],\"type\":\"object\"},\"quickFilterConditionRequest\":{\"description\":\"A property filter condition. Same shape as a property filter but without the \\\"property\\\" field (the hashmap key identifies the property). For example: { \\\"select\\\": { \\\"equals\\\": \\\"High\\\" } }.\",\"type\":\"object\"},\"relationGroupByConfigRequest\":{\"properties\":{\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"relation\",\"description\":\"The property type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"sort\"],\"type\":\"object\"},\"selectGroupByConfigRequest\":{\"properties\":{\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"description\":\"The property type for grouping.\",\"enum\":[\"select\",\"multi_select\"],\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"sort\"],\"type\":\"object\"},\"sortDirectionRequest\":{\"description\":\"One of: `ascending`, `descending`\",\"enum\":[\"ascending\",\"descending\"],\"type\":\"string\"},\"statusGroupByConfigRequest\":{\"properties\":{\"group_by\":{\"description\":\"How to group status values. \\\"group\\\" groups by status group (To Do/In Progress/Done), \\\"option\\\" groups by individual option.\",\"enum\":[\"group\",\"option\"],\"type\":\"string\"},\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"const\":\"status\",\"description\":\"The property type for grouping.\",\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"group_by\",\"sort\"],\"type\":\"object\"},\"subtaskConfigRequest\":{\"properties\":{\"display_mode\":{\"description\":\"How sub-items are displayed. \\\"show\\\" renders hierarchically with toggles, \\\"hidden\\\" shows parents with a count, \\\"flattened\\\" shows sub-items with a parent indicator, \\\"disabled\\\" turns off sub-item rendering.\",\"enum\":[\"show\",\"hidden\",\"flattened\",\"disabled\"],\"type\":\"string\"},\"filter_scope\":{\"description\":\"Which items are included when filtering. \\\"parents\\\" includes parent items only, \\\"parents_and_subitems\\\" includes both, \\\"subitems\\\" includes sub-items only.\",\"enum\":[\"parents\",\"parents_and_subitems\",\"subitems\"],\"type\":\"string\"},\"property_id\":{\"description\":\"Relation property ID used for parent-child nesting.\",\"type\":\"string\"},\"toggle_column_id\":{\"description\":\"Property ID of the column showing the sub-item expand/collapse toggle.\",\"type\":\"string\"}},\"type\":\"object\"},\"tableViewConfigRequest\":{\"properties\":{\"frozen_column_index\":{\"description\":\"Number of columns frozen from the left side of the table.\",\"minimum\":0,\"type\":\"integer\"},\"group_by\":{\"description\":\"Group-by configuration for the table. Pass null to remove grouping.\",\"oneOf\":[{\"$ref\":\"#/$defs/groupByConfigRequest\"},{\"type\":\"null\"}]},\"properties\":{\"description\":\"Property visibility and display configuration. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_vertical_lines\":{\"description\":\"Whether to show vertical grid lines between columns.\",\"type\":\"boolean\"},\"subtasks\":{\"description\":\"Subtask (sub-item) configuration. Pass null to reset subtask config to defaults (which may show subtasks). Use `{ \\\"display_mode\\\": \\\"disabled\\\" }` to explicitly disable subtasks.\",\"oneOf\":[{\"$ref\":\"#/$defs/subtaskConfigRequest\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"table\",\"description\":\"The view type. Must be \\\"table\\\".\",\"type\":\"string\"},\"wrap_cells\":{\"description\":\"Whether to wrap cell content in the table.\",\"type\":\"boolean\"}},\"required\":[\"type\"],\"type\":\"object\"},\"textGroupByConfigRequest\":{\"properties\":{\"group_by\":{\"description\":\"How to group text values. \\\"exact\\\" = exact match, \\\"alphabet_prefix\\\" = first letter.\",\"enum\":[\"exact\",\"alphabet_prefix\"],\"type\":\"string\"},\"hide_empty_groups\":{\"description\":\"Whether to hide groups that have no items.\",\"type\":\"boolean\"},\"property_id\":{\"description\":\"Property ID to group by.\",\"type\":\"string\"},\"sort\":{\"$ref\":\"#/$defs/groupSortRequest\",\"description\":\"Sort order for groups.\"},\"type\":{\"description\":\"The property type for grouping.\",\"enum\":[\"text\",\"title\",\"url\",\"email\",\"phone_number\"],\"type\":\"string\"}},\"required\":[\"type\",\"property_id\",\"group_by\",\"sort\"],\"type\":\"object\"},\"timelineArrowsByRequest\":{\"properties\":{\"property_id\":{\"description\":\"Relation property ID used for dependency arrows, or null to disable arrows.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"type\":\"object\"},\"timelinePreferenceRequest\":{\"properties\":{\"center_timestamp\":{\"description\":\"Timestamp (ms) to center the timeline view on.\",\"type\":\"integer\"},\"zoom_level\":{\"description\":\"Zoom level for the timeline.\",\"enum\":[\"hours\",\"day\",\"week\",\"bi_week\",\"month\",\"quarter\",\"year\",\"5_years\"],\"type\":\"string\"}},\"required\":[\"zoom_level\"],\"type\":\"object\"},\"timelineViewConfigRequest\":{\"properties\":{\"arrows_by\":{\"description\":\"Configuration for dependency arrows between timeline items. Pass null to clear.\",\"oneOf\":[{\"$ref\":\"#/$defs/timelineArrowsByRequest\"},{\"type\":\"null\"}]},\"color_by\":{\"description\":\"Whether to color timeline items by a property. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"date_property_id\":{\"description\":\"Property ID of the date property used for the start of timeline items.\",\"type\":\"string\"},\"end_date_property_id\":{\"description\":\"Property ID of the date property used for the end of timeline items. Pass null to clear.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"preference\":{\"description\":\"Timeline display preferences (zoom level and center position). Pass null to clear.\",\"oneOf\":[{\"$ref\":\"#/$defs/timelinePreferenceRequest\"},{\"type\":\"null\"}]},\"properties\":{\"description\":\"Property visibility and display configuration on timeline items. Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"show_table\":{\"description\":\"Whether to show the table panel alongside the timeline. Pass null to clear.\",\"oneOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}]},\"table_properties\":{\"description\":\"Property configuration for the table panel (when show_table is true). Pass null to clear.\",\"oneOf\":[{\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigRequest\"},\"maxItems\":100,\"type\":\"array\"},{\"type\":\"null\"}]},\"type\":{\"const\":\"timeline\",\"description\":\"The view type. Must be \\\"timeline\\\".\",\"type\":\"string\"}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"viewConfigRequest\":{\"description\":\"View configuration, discriminated by the type field.\",\"oneOf\":[{\"$ref\":\"#/$defs/tableViewConfigRequest\"},{\"$ref\":\"#/$defs/boardViewConfigRequest\"},{\"$ref\":\"#/$defs/calendarViewConfigRequest\"},{\"$ref\":\"#/$defs/timelineViewConfigRequest\"},{\"$ref\":\"#/$defs/galleryViewConfigRequest\"},{\"$ref\":\"#/$defs/listViewConfigRequest\"},{\"$ref\":\"#/$defs/mapViewConfigRequest\"},{\"$ref\":\"#/$defs/formViewConfigRequest\"},{\"$ref\":\"#/$defs/chartViewConfigRequest\"}]},\"viewFilterRequest\":{\"description\":\"Filter for the view. Uses the same format as the data source query filter (property filters, timestamp filters, or compound and/or filters). Simple property filters appear in the view's filter bar in the Notion UI. Select, status, and multi_select filter operators accept a single string or an array of strings to filter by multiple values (e.g. { \\\"does_not_equal\\\": [\\\"Done\\\", \\\"Archive\\\"] }).\",\"type\":\"object\"},\"viewPropertyConfigRequest\":{\"properties\":{\"card_property_width_mode\":{\"description\":\"Property width mode in compact card layouts (board/gallery).\",\"enum\":[\"full_line\",\"inline\"],\"type\":\"string\"},\"date_format\":{\"description\":\"Date display format (date properties only).\",\"enum\":[\"full\",\"short\",\"month_day_year\",\"day_month_year\",\"year_month_day\",\"relative\"],\"type\":\"string\"},\"property_id\":{\"description\":\"Property ID (stable identifier).\",\"type\":\"string\"},\"status_show_as\":{\"description\":\"How to display status properties (select dropdown or checkbox).\",\"enum\":[\"select\",\"checkbox\"],\"type\":\"string\"},\"time_format\":{\"description\":\"Time display format (date properties only).\",\"enum\":[\"12_hour\",\"24_hour\",\"hidden\"],\"type\":\"string\"},\"visible\":{\"description\":\"Whether this property is visible in the view.\",\"type\":\"boolean\"},\"width\":{\"description\":\"Width of the property column in pixels (table view only).\",\"minimum\":1,\"type\":\"integer\"},\"wrap\":{\"description\":\"Whether to wrap content in this property cell/card.\",\"type\":\"boolean\"}},\"required\":[\"property_id\"],\"type\":\"object\"},\"viewPropertySortRequest\":{\"properties\":{\"direction\":{\"$ref\":\"#/$defs/sortDirectionRequest\",\"description\":\"Sort direction.\"},\"property\":{\"description\":\"Property name or ID to sort by.\",\"type\":\"string\"}},\"required\":[\"property\",\"direction\"],\"type\":\"object\"},\"viewPropertySortsRequest\":{\"items\":{\"$ref\":\"#/$defs/viewPropertySortRequest\"},\"maxItems\":100,\"type\":\"array\"}},\"properties\":{\"configuration\":{\"$ref\":\"#/$defs/viewConfigRequest\",\"description\":\"View presentation configuration. The type field must match the view type. Individual nullable fields within the configuration can be set to null to clear them.\"},\"filter\":{\"description\":\"Filter to apply to the view. Uses the same format as the data source query filter. Pass null to clear the filter.\",\"oneOf\":[{\"$ref\":\"#/$defs/viewFilterRequest\"},{\"type\":\"null\"}]},\"name\":{\"description\":\"New name for the view.\",\"type\":\"string\"},\"quick_filters\":{\"description\":\"Quick filters for the view's filter bar. Keys are property names or IDs. Set a key to a filter condition to add/update that quick filter. Set a key to null to remove it. Pass null for the entire field to clear all quick filters. Unmentioned quick filters are preserved.\",\"oneOf\":[{\"additionalProperties\":{\"oneOf\":[{\"$ref\":\"#/$defs/quickFilterConditionRequest\"},{\"type\":\"null\"}]},\"type\":\"object\"},{\"type\":\"null\"}]},\"sorts\":{\"description\":\"Property sorts to apply to the view. Only property-based sorts are supported. Pass null to clear the sorts.\",\"oneOf\":[{\"$ref\":\"#/$defs/viewPropertySortsRequest\"},{\"type\":\"null\"}]}},\"type\":\"object\"}},\"view_id\":{\"required\":true,\"schema\":{\"description\":\"ID of a Notion view.\",\"type\":\"string\"}}}",
      ),
      returns: json_parse(
        "{\"$defs\":{\"boardViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"card_layout\":{\"description\":\"Card layout mode (list shows all properties, compact shows inline).\",\"enum\":[\"list\",\"compact\"],\"type\":\"string\"},\"cover\":{\"$ref\":\"#/$defs/coverConfigResponse\",\"description\":\"Card cover/preview image configuration.\"},\"cover_aspect\":{\"description\":\"Cover image aspect ratio.\",\"enum\":[\"contain\",\"cover\"],\"type\":\"string\"},\"cover_size\":{\"description\":\"Cover image size.\",\"enum\":[\"small\",\"medium\",\"large\"],\"type\":\"string\"},\"group_by\":{\"$ref\":\"#/$defs/groupByConfigResponse\",\"description\":\"Column (horizontal) grouping - required for board view.\"},\"properties\":{\"description\":\"Properties to display on each card.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"sub_group_by\":{\"$ref\":\"#/$defs/groupByConfigResponse\",\"description\":\"Sub-grouping (vertical swimlanes within columns).\"},\"type\":{\"const\":\"board\",\"description\":\"The view configuration type.\",\"type\":\"string\"}},\"required\":[\"type\",\"group_by\"],\"type\":\"object\"},\"calendarViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"date_property_id\":{\"description\":\"Date property used to position items on the calendar - required.\",\"type\":\"string\"},\"date_property_name\":{\"description\":\"Date property name (convenience field).\",\"type\":\"string\"},\"properties\":{\"description\":\"Properties to display on calendar event cards.\",\"items\":{\"$ref\":\"#/$defs/viewPropertyConfigResponse\"},\"maxItems\":100,\"type\":\"array\"},\"show_weekends\":{\"description\":\"Whether to show weekend days.\",\"type\":\"boolean\"},\"type\":{\"const\":\"calendar\",\"description\":\"The view configuration type.\",\"type\":\"string\"},\"view_range\":{\"description\":\"Calendar view range.\",\"enum\":[\"week\",\"month\"],\"type\":\"string\"}},\"required\":[\"type\",\"date_property_id\"],\"type\":\"object\"},\"chartAggregationResponse\":{\"additionalProperties\":false,\"properties\":{\"aggregator\":{\"description\":\"The aggregation operator. \\\"count\\\" counts all rows and does not require a property_id. All other operators require a property_id.\",\"enum\":[\"count\",\"count_values\",\"sum\",\"average\",\"median\",\"min\",\"max\",\"range\",\"unique\",\"empty\",\"not_empty\",\"percent_empty\",\"percent_not_empty\",\"checked\",\"unchecked\",\"percent_checked\",\"percent_unchecked\",\"earliest_date\",\"latest_date\",\"date_range\"],\"type\":\"string\"},\"property_id\":{\"description\":\"The property to aggregate on. Required for all operators except \\\"count\\\".\",\"type\":\"string\"}},\"required\":[\"aggregator\"],\"type\":\"object\"},\"chartReferenceLineResponse\":{\"additionalProperties\":false,\"properties\":{\"color\":{\"description\":\"Color of the reference line.\",\"enum\":[\"gray\",\"lightgray\",\"brown\",\"yellow\",\"orange\",\"green\",\"blue\",\"purple\",\"pink\",\"red\"],\"type\":\"string\"},\"dash_style\":{\"description\":\"Line style: \\\"solid\\\" for a continuous line, \\\"dash\\\" for a dashed line.\",\"enum\":[\"solid\",\"dash\"],\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the reference line.\",\"type\":\"string\"},\"label\":{\"description\":\"Label displayed alongside the reference line.\",\"type\":\"string\"},\"value\":{\"description\":\"The y-axis value where the reference line is drawn.\",\"type\":\"number\"}},\"required\":[\"id\",\"value\",\"label\",\"color\",\"dash_style\"],\"type\":\"object\"},\"chartViewConfigResponse\":{\"additionalProperties\":false,\"properties\":{\"axis_labels\":{\"description\":\"Which axis labels to display.\",\"enum\":[\"none\",\"x_axis\",\"y_axis\",\"both\"],\"type\":\"string\"},\"caption\":{\"description\":\"Text caption displayed below the chart. Null when no caption is shown.\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"chart_type\":{\"description\":\"The chart type: column (vertical bars), bar (horizontal bars), line, donut, or number (single value display).\",\"enum\":[\"column\",\"bar\",\"line\",\"donut\",\"number\"],\"type\":\"string\"},\"color_by_value\":{\"description\":\"Whether chart elements are colored by their numeric value (gradient coloring).\",\"type\":\"boolean\"},\"color_theme\":{\"description\":\"Color theme for the chart.\",\"enum\":[\"gray\",\"blue\",\"yellow\",\"green\",\"purple\",\"teal\",\"orange\",\"pink\",\"red\",\"auto\",\"colorful\"],\"type\":\"string\"},\"cumulative\":{\"description\":\"Whether to show cumulative values (line charts only).\",\"type\":\"boolean\"},\"donut_labels\":{\"description\":\"What to display on donut chart slices.\",\"enum\":[\"none\",\"value\",\"name\",\"name_and_value\"],\"type\":\"string\"},\"grid_lines\":{\"description\":\"Which grid lines to display.\",\"enum\":[\"none\",\"horizontal\",\"vertical\",\"both\"],\"type\":\"string\"},\"group_style\":{\"description\":\"How grouped/stacked bars are displayed. \\\"normal\\\" stacks values, \\\"percent\\\" normalizes to 100%, \\\"side_by_side\\\" places bars next to each other.\",\"enum\":[\"normal\",\"percent\",\"side_by_side\"],\"type\":\"string\"},\"height\":{\"description\":\"Chart height.\",\"enum\":[\"small\",\"medium\",\"large\",\"extra_large\"],\"type\":\"string\"},\"hide_empty_groups\":{\"description\":\"Whether to hide groups with no data on the x-axis.\",\"type\":\"boolean\"},\"hide_line_fill_area\":{\"description\":\"Whether to hide the shaded area under the line (line charts only).\",\"type\":\"boolean\"},\"hide_title\":{\"description\":\"Whether to hide the title label (number charts only).\",\"type\":\"boolean\"},\"legend_position\":{\"description\":\"Legend display position. \\\"off\\\" hides the legend.\",\"enum\":[\"off\",\"bottom\",\"side\"],\"type\":\"string\"},\"reference_lines\":{\"description\":\"Reference lines drawn on the chart. Null when no reference lines a